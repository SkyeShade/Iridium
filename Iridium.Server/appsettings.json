{
  "ConnectionStrings": {
    "Iridium": "Data Source=iridium.db"
  },
  "Node": {
    "AllowRegistrations": true,
    "MaxCommunitiesPerUser": 5,
    "SessionIdleDays": 60,
    "SessionAbsoluteDays": 365,
    "SessionActivityUpdateMinutes": 15,
    "MaxMessageCharacters": 10000,
    "MaxAttachmentBytes": 209715200,
    "MaxAttachmentsPerMessage": 10,
    "AttachmentStoragePath": "data/attachments"
  },
  "AccountSecurity": {
    "RecoveryTokenMinutes": 30
  },
  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Iridium",
    "UseSsl": true
  },
  "Media": {
    "Provider": "Disabled",
    "PublicUrl": "",
    "ApiKey": "",
    "ApiSecret": "",
    "JoinTokenLifetimeSeconds": 300,
    "Voice": {
      "Bitrate": 96000
    },
    "Mode": "NodeSfu",
    "RingTimeoutSeconds": 30,
    "SignalingLossTimeoutSeconds": 45
  },
  "WebRtc": {
    "IceServers": [],
    "IceTransportPolicy": "all",
    "Turn": {
      "Enabled": false,
      "Urls": [],
      "SharedSecret": "",
      "CredentialLifetimeSeconds": 3600
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
