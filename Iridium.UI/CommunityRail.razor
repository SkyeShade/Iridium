@using Iridium.Protocol
@using Iridium.Client.Core

<nav class="community-rail" aria-label="Servers">
    <button class="rail-item home @(SelectedCommunityId is null ? "active" : null)" title="Home"
            aria-label="Home" @onclick="() => OnSelected.InvokeAsync(null)">
        @if (SelectedCommunityId is null) { <span class="selected-indicator" aria-hidden="true"></span> }
        <Icon Name="home" Size="23" />
    </button>
    @if (NotificationConversations.Count > 0)
    {
        <div class="notification-stack" aria-label="Unread Direct Messages">
            @foreach (var conversation in NotificationConversations)
            {
                var ringing = conversation.OtherParticipant.AccountId == RingingCallerAccountId;
                <button class="notification-item @(ringing ? "ringing" : null)" title="@NotificationTitle(conversation, ringing)"
                        aria-label="@NotificationTitle(conversation, ringing)"
                        @onclick="() => OnDirectConversationSelected.InvokeAsync(conversation)">
                    <span class="notification-avatar-wrapper">
                        <ProfileAvatar AccountId="conversation.OtherParticipant.AccountId" DisplayName="@conversation.OtherParticipant.DisplayName"
                                       BadgeMode="AvatarBadgeMode.Notification"
                                       NotificationCount="@conversation.UnreadCount"
                                       Tooltip="@NotificationTitle(conversation, ringing)"
                                       Surface="deep" />
                    </span>
                </button>
            }
        </div>
    }
    <div class="rail-divider"></div>
    <div class="community-scroll">
        @foreach (var community in Communities)
        {
            <button @key="community.Id" class="rail-item community @(community.Id == SelectedCommunityId ? "active" : null)"
                    title="@community.Name"
                    @onclick="() => OnSelected.InvokeAsync(community)">
                @if (community.Id == SelectedCommunityId) { <span class="selected-indicator" aria-hidden="true"></span> }
                @if (!string.IsNullOrWhiteSpace(community.AvatarUrl))
                {
                    <AvatarCroppedPreview Class="community-avatar" State="CommunityAvatarState(community)" />
                }
                else
                {
                    <span>@Initials(community.Name)</span>
                }
                @if (community.HasUnread)
                {
                    <span class="community-unread-marker" aria-label="Unread messages"></span>
                }
                @if (community.MentionCount > 0)
                {
                    <span class="community-mention-badge"><span class="red-notification-count">@(community.MentionCount > 99 ? "99+" : community.MentionCount)</span></span>
                }
            </button>
        }
    </div>
    <button class="rail-item add" title="Create Server" @onclick="OnAdd"><Icon Name="plus" /></button>
</nav>

@code {
    [Parameter] public IReadOnlyList<CommunityDto> Communities { get; set; } = [];
    [Parameter] public Guid? SelectedCommunityId { get; set; }
    [Parameter] public IReadOnlyList<DirectConversationDto> DirectConversations { get; set; } = [];
    [Parameter] public string NodeAuthority { get; set; } = string.Empty;
    [Parameter] public Guid? RingingCallerAccountId { get; set; }
    [Parameter] public EventCallback<CommunityDto?> OnSelected { get; set; }
    [Parameter] public EventCallback<DirectConversationDto> OnDirectConversationSelected { get; set; }
    [Parameter] public EventCallback OnAdd { get; set; }
    private IReadOnlyList<DirectConversationDto> NotificationConversations =>
        DirectNotificationProjection.Build(DirectConversations, RingingCallerAccountId);

    private string NotificationTitle(DirectConversationDto conversation, bool ringing) =>
        $"{conversation.OtherParticipant.DisplayName} | {IridiumIdentity.Format(conversation.OtherParticipant.Username, NodeAuthority)} | " +
        (ringing ? "Incoming voice call" : $"{conversation.UnreadCount} unread");

    private static string Initials(string name)
    {
        var words = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(words.Take(2).Select(word => char.ToUpperInvariant(word[0])));
    }
    private static ProfileMediaEditState CommunityAvatarState(CommunityDto community) => new AvatarEditState(
        community.AvatarUrl!, Math.Max(1, community.AvatarWidth), Math.Max(1, community.AvatarHeight),
        760, 1000, 1000, Math.Max(1, community.AvatarZoom), community.AvatarCropX, community.AvatarCropY);
}
