@using Iridium.Client.Core

<span class="avatar-cropped-preview @Class" style="@Style" aria-hidden="true">
    @if (State is not null)
    {
        <img src="@State.SourceUrl" alt="" draggable="false" style="@State.CroppedImageStyle" @onerror="OnError" />
    }
</span>

@code {
    [Parameter, EditorRequired] public AvatarEditState? State { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public EventCallback OnError { get; set; }
}
