@using Iridium.Protocol
@using Iridium.Client.Core
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject RealtimeConnectionService Realtime
@inject ILogger<ApplicationShell> Logger
@inject ModifierKeyStateService ModifierKeys
@inject MobilePanelNavigationState MobilePanels

<div class="@ShellClass" @ref="_shell"
     @onclick="OnBackgroundInteraction" @onkeydown="ShellKeyDown">
    @if (ShowMobileCallBar && MobileCallBar is not null) { <div class="mobile-call-bar-slot">@MobileCallBar</div> }
    <div class="mobile-navigation-panel" @ref="_navigationPanel">
        <CommunityRail Communities="Communities" SelectedCommunityId="SelectedCommunity?.Id"
                       DirectConversations="DirectConversations" NodeAuthority="@NodeAuthority"
                       RingingCallerAccountId="RingingCallerAccountId"
                       IncomingFriendRequestCount="IncomingFriendRequestCount"
                       ShowHomeFriendRequestNotification="ShowHomeFriendRequestNotification"
                       OnSelected="OnCommunitySelected" OnDirectConversationSelected="OnDirectConversationSelected" OnAdd="OnAddCommunity" />
        <aside class="secondary-sidebar @(SelectedCommunity is not null ? "selected-community-sidebar" : null)">
            <header class="community-header @(SelectedCommunity is not null ? "selected-community-header" : null)">
                @if (SidebarHeader is not null) { @SidebarHeader }
                else { <strong>@(SelectedCommunity?.Name ?? "Iridium")</strong> }
            </header>
            <div class="sidebar-body">
                @if (SidebarContent is not null) { @SidebarContent }
            </div>
            @if (VoiceConnection is not null) { <div class="voice-connection-slot">@VoiceConnection</div> }
        </aside>
        <div class="mobile-profile-panel-slot">
            <ProfilePanel AccountId="AccountId" AvatarRevision="AvatarRevision" AvatarPresetId="AvatarPresetId" DisplayName="@DisplayName"
                          PublicIdentity="@PublicIdentity" Presence="Presence" OnProfile="OnProfile" OnSettings="OnSettings" />
        </div>
    </div>
    <div class="desktop-player-panel-slot">
        <ProfilePanel AccountId="AccountId" AvatarRevision="AvatarRevision" AvatarPresetId="AvatarPresetId" DisplayName="@DisplayName"
                      PublicIdentity="@PublicIdentity" Presence="Presence" OnProfile="OnProfile" OnSettings="OnSettings"
                      ShowVoiceControls="true" />
    </div>
    <main class="main-content" data-mobile-content-kind="@MobileConversationContentKind" @ref="_mainContent">
        <header class="mobile-conversation-header @(UseCompactMobileConversationHeader ? "compact-dm" : null)">
            <button type="button" class="mobile-back" aria-label="Back to navigation" @onclick="OnMobileBack"><Icon Name="chevron" Size="48" /></button>
            @if (UseCompactMobileConversationHeader && MobileConversationIdentity is not null)
            {
                <div class="mobile-conversation-identity-slot">@MobileConversationIdentity</div>
                <div class="mobile-conversation-action-slot">@MobileConversationAction</div>
            }
            else
            {
                <strong title="@MobileConversationTitle">@MobileConversationTitle</strong>
            }
            @if (ShowRightSidebar)
            {
                <button type="button" class="mobile-context" aria-label="Open conversation context" @onclick="OnMobileContext"><Icon Name="friends" /></button>
            }
            else { <span class="mobile-header-spacer"></span> }
        </header>
        <div class="main-content-slot">@ChildContent</div>
    </main>
    @if (ShowRightSidebar && RightSidebar is not null)
    {
        <button type="button" class="mobile-context-backdrop" aria-label="Close conversation context" @onclick="OnMobileContextClose"></button>
        <aside class="context-sidebar" role="complementary" aria-label="Conversation context">
            <header class="mobile-context-header"><strong>Conversation details</strong><button type="button" aria-label="Close conversation context" @onclick="OnMobileContextClose"><Icon Name="close" /></button></header>
            @RightSidebar
        </aside>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<CommunityDto> Communities { get; set; } = [];
    [Parameter] public CommunityDto? SelectedCommunity { get; set; }
    [Parameter] public IReadOnlyList<DirectConversationDto> DirectConversations { get; set; } = [];
    [Parameter] public Guid? RingingCallerAccountId { get; set; }
    [Parameter] public int IncomingFriendRequestCount { get; set; }
    [Parameter] public bool ShowHomeFriendRequestNotification { get; set; }
    [Parameter] public string NodeAuthority { get; set; } = string.Empty;
    [Parameter, EditorRequired] public required string DisplayName { get; set; }
    [Parameter] public Guid? AccountId { get; set; }
    [Parameter] public long AvatarRevision { get; set; }
    [Parameter] public Guid? AvatarPresetId { get; set; }
    [Parameter, EditorRequired] public required string PublicIdentity { get; set; }
    [Parameter] public PublicPresence Presence { get; set; }
    [Parameter] public EventCallback<CommunityDto?> OnCommunitySelected { get; set; }
    [Parameter] public EventCallback<DirectConversationDto> OnDirectConversationSelected { get; set; }
    [Parameter] public EventCallback OnAddCommunity { get; set; }
    [Parameter] public EventCallback OnProfile { get; set; }
    [Parameter] public EventCallback OnSettings { get; set; }
    [Parameter] public RenderFragment? SidebarHeader { get; set; }
    [Parameter] public RenderFragment? SidebarContent { get; set; }
    [Parameter] public RenderFragment? VoiceConnection { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? RightSidebar { get; set; }
    [Parameter] public bool ShowRightSidebar { get; set; }
    [Parameter] public EventCallback OnBackgroundInteraction { get; set; }
    [Parameter] public bool EnableMobilePanelDiagnostics { get; set; }
    [Parameter] public string MobileConversationContentKind { get; set; } = "none";
    [Parameter] public string MobileConversationTitle { get; set; } = "Conversation";
    [Parameter] public bool UseCompactMobileConversationHeader { get; set; }
    [Parameter] public RenderFragment? MobileConversationIdentity { get; set; }
    [Parameter] public RenderFragment? MobileConversationAction { get; set; }
    [Parameter] public RenderFragment? MobileCallBar { get; set; }
    [Parameter] public bool ShowMobileCallBar { get; set; }
    [Parameter] public bool SuppressMobileVoiceConnection { get; set; }
    [Parameter] public EventCallback OnMobileBack { get; set; }
    [Parameter] public EventCallback OnMobileContext { get; set; }
    [Parameter] public EventCallback OnMobileContextClose { get; set; }
    [Parameter] public EventCallback<bool> OnMobileLayoutChanged { get; set; }
    private ElementReference _mainContent;
    private ElementReference _navigationPanel;
    private ElementReference _shell;
    private IJSObjectReference? _swipeModule;
    private DotNetObjectReference<ApplicationShell>? _selfReference;
    private MobilePanel? _presentedMobilePanel;
    private long _presentedMobilePanelRevision = -1;
    private string? _presentedMobileContentKind;
    private string ShellClass => $"app-shell {(ShowRightSidebar ? "has-context-sidebar" : null)} " +
        $"{(ShowMobileCallBar ? "has-mobile-call-bar" : null)} " +
        $"{(SuppressMobileVoiceConnection ? "suppress-mobile-voice-connection" : null)} " +
        $"mobile-{MobilePanels.Current.ToString().ToLowerInvariant()}";
    private Task ShellKeyDown(KeyboardEventArgs args) => args.Key == "Escape" && MobilePanels.Current == MobilePanel.Context
        ? OnMobileContextClose.InvokeAsync()
        : Task.CompletedTask;

    protected override void OnInitialized() => MobilePanels.Changed += MobilePanelChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _swipeModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Iridium.UI/js/mobileConversationSwipe.js");
            _selfReference = DotNetObjectReference.Create(this);
            await _swipeModule.InvokeVoidAsync(
                "wireMobileViewport",
                _shell,
                _selfReference);
            await _swipeModule.InvokeVoidAsync("wireRealtimeResume", _shell, _selfReference);
            await _swipeModule.InvokeVoidAsync("wireModifierKeys", _shell, _selfReference);
            await _swipeModule.InvokeVoidAsync("wireMobileConversationSwipe", _mainContent, _selfReference,
                EnableMobilePanelDiagnostics);
        }
        if (_swipeModule is not null && (_presentedMobilePanel != MobilePanels.Current ||
            _presentedMobilePanelRevision != MobilePanels.Revision ||
            _presentedMobileContentKind != MobileConversationContentKind))
        {
            _presentedMobilePanel = MobilePanels.Current;
            _presentedMobilePanelRevision = MobilePanels.Revision;
            _presentedMobileContentKind = MobileConversationContentKind;
            await _swipeModule.InvokeVoidAsync("resetMobileConversationSwipe", _mainContent);
            if (EnableMobilePanelDiagnostics)
            {
                var snapshot = await _swipeModule.InvokeAsync<MobilePanelDiagnosticSnapshot>(
                    "inspectMobilePanels", _shell, _navigationPanel, _mainContent);
                Logger.LogInformation("[MobilePanel] Shell render instance={InstanceId} state={State} revision={Revision} classes={Classes} contentKind={ContentKind} navigation=({NavigationX},{NavigationY} {NavigationWidth}x{NavigationHeight} display={NavigationDisplay} visibility={NavigationVisibility} transform={NavigationTransform} z={NavigationZIndex}) conversation=({ConversationX},{ConversationY} {ConversationWidth}x{ConversationHeight} display={ConversationDisplay} visibility={ConversationVisibility} transform={ConversationTransform} z={ConversationZIndex}) children=(header={HasHeader} slot={HasMainContentSlot} direct={HasDirectMessageView} dmRegion={HasDmMessageRegion} dmHistory={HasDmMessageHistory} channel={HasChannelView} channelRegion={HasChannelMessageRegion} messages={HasMessageList} composer={HasComposer})",
                    MobilePanels.InstanceId, MobilePanels.Current, MobilePanels.Revision, snapshot.Classes,
                    snapshot.ContentKind,
                    snapshot.NavigationX, snapshot.NavigationY, snapshot.NavigationWidth, snapshot.NavigationHeight,
                    snapshot.NavigationDisplay, snapshot.NavigationVisibility, snapshot.NavigationTransform, snapshot.NavigationZIndex,
                    snapshot.ConversationX, snapshot.ConversationY, snapshot.ConversationWidth, snapshot.ConversationHeight,
                    snapshot.ConversationDisplay, snapshot.ConversationVisibility, snapshot.ConversationTransform, snapshot.ConversationZIndex,
                    snapshot.HasHeader, snapshot.HasMainContentSlot, snapshot.HasDirectMessageView,
                    snapshot.HasDmMessageRegion, snapshot.HasDmMessageHistory, snapshot.HasChannelView,
                    snapshot.HasChannelMessageRegion, snapshot.HasMessageList, snapshot.HasComposer);
                if (MobilePanels.Current == MobilePanel.Conversation && snapshot.MissingNodes.Length > 0)
                {
                    Logger.LogWarning("[MobilePanel] Conversation DOM incomplete for Home branch {ContentKind}; missing={MissingNodes}. A missing direct-message-view/channel-view means Home's ChildContent branch did not emit that component; nested missing nodes identify the component subtree that stopped rendering.",
                        snapshot.ContentKind, string.Join(",", snapshot.MissingNodes));
                }
            }
        }
    }
    [JSInvokable]
    public Task MobileLayoutChangedAsync(bool isMobile) =>
        OnMobileLayoutChanged.InvokeAsync(isMobile);
    [JSInvokable]
    public Task MobileConversationSwipeBackAsync() => MobilePanels.Current == MobilePanel.Conversation
        ? OnMobileBack.InvokeAsync()
        : Task.CompletedTask;
    private void MobilePanelChanged(MobilePanelTransition transition)
    {
        if (EnableMobilePanelDiagnostics)
            Logger.LogInformation("[MobilePanel] Shell received instance={InstanceId} source={Source} previous={Previous} new={Current} revision={Revision}",
                transition.InstanceId, transition.Source, transition.Previous, transition.Current, transition.Revision);
        _ = InvokeAsync(StateHasChanged);
    }
    [JSInvokable]
    public async Task RealtimeResumeAsync(string reason)
    {
        try { await Realtime.VerifyAndRecoverAsync($"browser-resume:{reason}"); }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Realtime verification failed after browser resume event {Reason}.", reason);
        }
    }
    [JSInvokable]
    public Task ModifierShiftChangedAsync(bool pressed)
    {
        ModifierKeys.SetShift(pressed);
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        MobilePanels.Changed -= MobilePanelChanged;
        if (_swipeModule is not null)
        {
            try
            {
                await _swipeModule.InvokeVoidAsync("unwireMobileConversationSwipe", _mainContent);
                await _swipeModule.InvokeVoidAsync("unwireMobileViewport", _shell);
                await _swipeModule.InvokeVoidAsync("unwireRealtimeResume", _shell);
                await _swipeModule.InvokeVoidAsync("unwireModifierKeys", _shell);
                await _swipeModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _selfReference?.Dispose();
    }

    private sealed record MobilePanelDiagnosticSnapshot(string Classes,
        double NavigationX, double NavigationY, double NavigationWidth, double NavigationHeight,
        string NavigationDisplay, string NavigationVisibility, string NavigationTransform, string NavigationZIndex,
        double ConversationX, double ConversationY, double ConversationWidth, double ConversationHeight,
        string ConversationDisplay, string ConversationVisibility, string ConversationTransform, string ConversationZIndex,
        string ContentKind, bool HasHeader, bool HasMainContentSlot, bool HasDirectMessageView,
        bool HasDmMessageRegion, bool HasDmMessageHistory, bool HasChannelView,
        bool HasChannelMessageRegion, bool HasMessageList, bool HasComposer, string[] MissingNodes);
}
