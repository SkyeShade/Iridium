@using Iridium.Protocol
@using Iridium.Client.Core
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject RealtimeConnectionService Realtime
@inject ILogger<ApplicationShell> Logger
@inject ModifierKeyStateService ModifierKeys

<div class="app-shell @(ShowRightSidebar ? "has-context-sidebar" : null) mobile-@ActiveMobilePanel.ToString().ToLowerInvariant()" @ref="_shell"
     @onclick="OnBackgroundInteraction" @onkeydown="ShellKeyDown">
    <CommunityRail Communities="Communities" SelectedCommunityId="SelectedCommunity?.Id"
                   DirectConversations="DirectConversations" NodeAuthority="@NodeAuthority"
                   RingingCallerAccountId="RingingCallerAccountId"
                   IncomingFriendRequestCount="IncomingFriendRequestCount"
                   ShowHomeFriendRequestNotification="ShowHomeFriendRequestNotification"
                   OnSelected="OnCommunitySelected" OnDirectConversationSelected="OnDirectConversationSelected" OnAdd="OnAddCommunity" />
    <aside class="secondary-sidebar @(SelectedCommunity is not null ? "selected-community-sidebar" : null)">
        <header class="community-header @(SelectedCommunity is not null ? "selected-community-header" : null)">
            @if (SidebarHeader is not null) { @SidebarHeader }
            else { <strong>@(SelectedCommunity?.Name ?? "Iridium")</strong> }
        </header>
        <div class="sidebar-body">
            @if (SidebarContent is not null) { @SidebarContent }
        </div>
        @if (VoiceConnection is not null) { <div class="voice-connection-slot">@VoiceConnection</div> }
        <ProfilePanel AccountId="AccountId" AvatarRevision="AvatarRevision" DisplayName="@DisplayName"
                      PublicIdentity="@PublicIdentity" Presence="Presence" OnProfile="OnProfile" OnSettings="OnSettings" />
    </aside>
    <main class="main-content" @ref="_mainContent">
        <header class="mobile-conversation-header @(UseCompactMobileConversationHeader ? "compact-dm" : null)">
            <button type="button" class="mobile-back" aria-label="Back to navigation" @onclick="OnMobileBack"><Icon Name="chevron" Size="48" /></button>
            @if (UseCompactMobileConversationHeader && MobileConversationIdentity is not null)
            {
                <div class="mobile-conversation-identity-slot">@MobileConversationIdentity</div>
                <div class="mobile-conversation-action-slot">@MobileConversationAction</div>
            }
            else
            {
                <strong title="@MobileConversationTitle">@MobileConversationTitle</strong>
            }
            @if (ShowRightSidebar)
            {
                <button type="button" class="mobile-context" aria-label="Open conversation context" @onclick="OnMobileContext"><Icon Name="friends" /></button>
            }
            else { <span class="mobile-header-spacer"></span> }
        </header>
        <div class="main-content-slot">@ChildContent</div>
    </main>
    @if (ShowRightSidebar && RightSidebar is not null)
    {
        <button type="button" class="mobile-context-backdrop" aria-label="Close conversation context" @onclick="OnMobileContextClose"></button>
        <aside class="context-sidebar" role="complementary" aria-label="Conversation context">
            <header class="mobile-context-header"><strong>Conversation details</strong><button type="button" aria-label="Close conversation context" @onclick="OnMobileContextClose"><Icon Name="close" /></button></header>
            @RightSidebar
        </aside>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<CommunityDto> Communities { get; set; } = [];
    [Parameter] public CommunityDto? SelectedCommunity { get; set; }
    [Parameter] public IReadOnlyList<DirectConversationDto> DirectConversations { get; set; } = [];
    [Parameter] public Guid? RingingCallerAccountId { get; set; }
    [Parameter] public int IncomingFriendRequestCount { get; set; }
    [Parameter] public bool ShowHomeFriendRequestNotification { get; set; }
    [Parameter] public string NodeAuthority { get; set; } = string.Empty;
    [Parameter, EditorRequired] public required string DisplayName { get; set; }
    [Parameter] public Guid? AccountId { get; set; }
    [Parameter] public long AvatarRevision { get; set; }
    [Parameter, EditorRequired] public required string PublicIdentity { get; set; }
    [Parameter] public PublicPresence Presence { get; set; }
    [Parameter] public EventCallback<CommunityDto?> OnCommunitySelected { get; set; }
    [Parameter] public EventCallback<DirectConversationDto> OnDirectConversationSelected { get; set; }
    [Parameter] public EventCallback OnAddCommunity { get; set; }
    [Parameter] public EventCallback OnProfile { get; set; }
    [Parameter] public EventCallback OnSettings { get; set; }
    [Parameter] public RenderFragment? SidebarHeader { get; set; }
    [Parameter] public RenderFragment? SidebarContent { get; set; }
    [Parameter] public RenderFragment? VoiceConnection { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? RightSidebar { get; set; }
    [Parameter] public bool ShowRightSidebar { get; set; }
    [Parameter] public EventCallback OnBackgroundInteraction { get; set; }
    [Parameter] public MobilePanel ActiveMobilePanel { get; set; } = MobilePanel.Navigation;
    [Parameter] public string MobileConversationTitle { get; set; } = "Conversation";
    [Parameter] public bool UseCompactMobileConversationHeader { get; set; }
    [Parameter] public RenderFragment? MobileConversationIdentity { get; set; }
    [Parameter] public RenderFragment? MobileConversationAction { get; set; }
    [Parameter] public EventCallback OnMobileBack { get; set; }
    [Parameter] public EventCallback OnMobileContext { get; set; }
    [Parameter] public EventCallback OnMobileContextClose { get; set; }
    [Parameter] public EventCallback<bool> OnMobileLayoutChanged { get; set; }
    private ElementReference _mainContent;
    private ElementReference _shell;
    private IJSObjectReference? _swipeModule;
    private DotNetObjectReference<ApplicationShell>? _selfReference;
    private Task ShellKeyDown(KeyboardEventArgs args) => args.Key == "Escape" && ActiveMobilePanel == MobilePanel.Context
        ? OnMobileContextClose.InvokeAsync()
        : Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _swipeModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Iridium.UI/js/mobileConversationSwipe.js");
        _selfReference = DotNetObjectReference.Create(this);
        await _swipeModule.InvokeVoidAsync(
            "wireMobileViewport",
            _shell,
            _selfReference);
        await _swipeModule.InvokeVoidAsync("wireRealtimeResume", _shell, _selfReference);
        await _swipeModule.InvokeVoidAsync("wireModifierKeys", _shell, _selfReference);
        await _swipeModule.InvokeVoidAsync("wireMobileConversationSwipe", _mainContent, _selfReference);
    }
    [JSInvokable]
    public Task MobileLayoutChangedAsync(bool isMobile) =>
        OnMobileLayoutChanged.InvokeAsync(isMobile);
    [JSInvokable]
    public Task MobileConversationSwipeBackAsync() => ActiveMobilePanel == MobilePanel.Conversation
        ? OnMobileBack.InvokeAsync()
        : Task.CompletedTask;
    [JSInvokable]
    public async Task RealtimeResumeAsync(string reason)
    {
        try { await Realtime.VerifyAndRecoverAsync($"browser-resume:{reason}"); }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Realtime verification failed after browser resume event {Reason}.", reason);
        }
    }
    [JSInvokable]
    public Task ModifierShiftChangedAsync(bool pressed)
    {
        ModifierKeys.SetShift(pressed);
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (_swipeModule is not null)
        {
            try
            {
                await _swipeModule.InvokeVoidAsync("unwireMobileConversationSwipe", _mainContent);
                await _swipeModule.InvokeVoidAsync("unwireMobileViewport", _shell);
                await _swipeModule.InvokeVoidAsync("unwireRealtimeResume", _shell);
                await _swipeModule.InvokeVoidAsync("unwireModifierKeys", _shell);
                await _swipeModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _selfReference?.Dispose();
    }
}
