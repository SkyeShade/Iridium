@using Iridium.Protocol

<section class="category-block @(HasUnreadDescendants ? "has-unread" : null)" data-channel-group="@Category.Id"
         data-iridium-category-drag="@(CanManage ? Category.Id : null)" style="--category-depth:@Depth">
    <div class="category-heading"
         data-iridium-category-drag-handle="@(CanManage ? Category.Id : null)"
         @oncontextmenu="OpenMenu"
         @oncontextmenu:preventDefault="true"
         @oncontextmenu:stopPropagation="true">
        <button type="button" class="category-toggle" @onclick="ToggleAsync">
            @if (Category.IsPrivate) { <span class="private-lock" title="Private category"><Icon Name="lock" Size="11" /></span> }
            <span class="category-name">@Category.Name</span>
            <span class="chevron @(Collapsed ? "collapsed" : null)"><Icon Name="chevron" /></span>
        </button>
        @if (CanManage)
        {
            <button type="button" class="category-settings" title="Category settings" aria-label="Settings for @Category.Name"
                    @onpointerdown:stopPropagation="true" @onclick="EditAsync"><Icon Name="settings" /></button>
            <button type="button" class="create-channel" title="Create Channel" aria-label="Create Channel in @Category.Name"
                    @onpointerdown:stopPropagation="true" @onclick="CreateAsync"><Icon Name="plus" /></button>
        }
    </div>
    @if (_menuOpen && (CanManage || CanManagePermissions))
    {
        <div class="category-menu" @onclick:stopPropagation="true">
            @if (CanManage) { <button @onclick="EditAsync"><Icon Name="edit" /> Category Settings</button> }
            @if (CanManagePermissions) { <button @onclick="PermissionsAsync"><Icon Name="settings" /> Permissions</button> }
            @if (CanManage) { <button @onclick="CreateAsync"><Icon Name="plus" /> Create Channel</button> }
            @if (CanManage && CanCreateSubcategory) { <button @onclick="CreateSubcategoryAsync"><Icon Name="plus" /> Create Subcategory</button> }
            @if (CanManage) { <button class="destructive" @onclick="DeleteAsync"><Icon Name="trash" /> Delete Category</button> }
        </div>
    }
    @if (!Collapsed)
    {
        <div class="category-children">@ChildContent</div>
    }
    <div class="category-end-drop-zone" data-category-end-drop="@Category.Id" aria-hidden="true"></div>
</section>

@code {
    [Parameter, EditorRequired] public required CommunityCategoryDto Category { get; set; }
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public bool CanManage { get; set; }
    [Parameter] public bool CanManagePermissions { get; set; }
    [Parameter] public bool CanCreateSubcategory { get; set; }
    [Parameter] public bool HasUnreadDescendants { get; set; }
    [Parameter] public int Depth { get; set; } = 1;
    [Parameter] public EventCallback<CommunityCategoryDto> OnToggle { get; set; }
    [Parameter] public EventCallback<CommunityCategoryDto> OnEdit { get; set; }
    [Parameter] public EventCallback<CommunityCategoryDto> OnCreateChannel { get; set; }
    [Parameter] public EventCallback<CommunityCategoryDto> OnCreateSubcategory { get; set; }
    [Parameter] public EventCallback<CommunityCategoryDto> OnDelete { get; set; }
    [Parameter] public EventCallback<CommunityCategoryDto> OnPermissions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool _menuOpen;

    private Task ToggleAsync() { _menuOpen = false; return OnToggle.InvokeAsync(Category); }
    private void OpenMenu() { if (CanManage || CanManagePermissions) _menuOpen = true; }
    private Task EditAsync() { _menuOpen = false; return OnEdit.InvokeAsync(Category); }
    private Task CreateAsync() { _menuOpen = false; return OnCreateChannel.InvokeAsync(Category); }
    private Task CreateSubcategoryAsync() { _menuOpen = false; return OnCreateSubcategory.InvokeAsync(Category); }
    private Task DeleteAsync() { _menuOpen = false; return OnDelete.InvokeAsync(Category); }
    private Task PermissionsAsync() { _menuOpen = false; return OnPermissions.InvokeAsync(Category); }
}
