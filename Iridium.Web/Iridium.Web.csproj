<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Iridium.Web</AssemblyName>
    <RootNamespace>Iridium.Web</RootNamespace>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <IridiumMediaBuildId Condition="'$(IridiumMediaBuildId)' == ''">$([System.DateTime]::UtcNow.ToString('yyyyMMddHHmmssfffffff'))</IridiumMediaBuildId>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>IridiumMediaBuildId</_Parameter1>
      <_Parameter2>$(IridiumMediaBuildId)</_Parameter2>
    </AssemblyAttribute>
    <Content Remove="wwwroot\media-build.json" />
    <Content Include="wwwroot\media-build.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="GenerateIridiumMediaBuildManifest" BeforeTargets="PrepareForBuild">
    <WriteLinesToFile File="wwwroot\media-build.json"
                      Lines="{ &quot;buildId&quot;: &quot;$(IridiumMediaBuildId)&quot; }"
                      Overwrite="true" Encoding="UTF-8" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.8" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Iridium.Protocol\Iridium.Protocol.csproj" />
    <ProjectReference Include="..\Iridium.Client.Core\Iridium.Client.Core.csproj" />
    <ProjectReference Include="..\Iridium.UI\Iridium.UI.csproj" />
  </ItemGroup>

</Project>
