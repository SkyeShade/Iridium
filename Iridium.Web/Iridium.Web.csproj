<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Iridium.Web</AssemblyName>
    <RootNamespace>Iridium.Web</RootNamespace>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <IridiumMediaBuildId Condition="'$(IridiumMediaBuildId)' == '' and '$(Configuration)' != 'Release'">$([System.DateTime]::UtcNow.ToString('yyyyMMddHHmmssfffffff'))</IridiumMediaBuildId>
    <IridiumMediaBuildManifest>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/media-build.json</IridiumMediaBuildManifest>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>IridiumMediaBuildId</_Parameter1>
      <_Parameter2>$(IridiumMediaBuildId)</_Parameter2>
    </AssemblyAttribute>
    <Content Remove="wwwroot\media-build.json" />
    <Content Include="$(IridiumMediaBuildManifest)"
             Link="wwwroot\media-build.json"
             CopyToOutputDirectory="Always"
             CopyToPublishDirectory="Always" />
  </ItemGroup>

  <Target Name="ValidateIridiumMediaBuildId" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(IridiumMediaBuildId)' == ''"
           Text="Release builds require one explicit IridiumMediaBuildId. Use scripts/build-linux-release.ps1 or pass -p:IridiumMediaBuildId=&lt;id&gt;." />
  </Target>

  <Target Name="GenerateIridiumMediaBuildManifest"
          BeforeTargets="PrepareForBuild"
          DependsOnTargets="ValidateIridiumMediaBuildId">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(IridiumMediaBuildManifest)'))" />
    <WriteLinesToFile File="$(IridiumMediaBuildManifest)"
                      Lines="{ &quot;buildId&quot;: &quot;$(IridiumMediaBuildId)&quot; }"
                      Overwrite="true" Encoding="UTF-8" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.8" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Iridium.Protocol\Iridium.Protocol.csproj" />
    <ProjectReference Include="..\Iridium.Client.Core\Iridium.Client.Core.csproj" />
    <ProjectReference Include="..\Iridium.UI\Iridium.UI.csproj" />
  </ItemGroup>

</Project>
