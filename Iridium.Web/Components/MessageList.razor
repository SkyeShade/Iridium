@using Iridium.Client.Core
@using Iridium.Protocol
@using Iridium.Web.Models
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject Iridium.Web.Services.MessageMenuCoordinator MessageMenus
@inject Iridium.Web.Services.AppearanceService Appearance

@{ var visibleMessages = DisplayMessages(); }
<div class="message-list @(_positioning ? "positioning" : null)" role="log" aria-live="polite" @ref="_container" @onclick="CloseMessageMenus">
    @if (visibleMessages.Count == 0)
    {
        <div class="message-empty"><div><Icon Name="@EmptyIcon" /></div><h2>@EmptyTitle</h2><p>@EmptyDescription</p></div>
    }
    else
    {
        @for (var index = 0; index < visibleMessages.Count; index++)
        {
            var message = visibleMessages[index];
            var previous = index == 0 || visibleMessages[index - 1].Id == RootMessageId ? null : visibleMessages[index - 1];
            @if (message.Kind == MessageKind.CallStarted)
            {
                <div @key="message.Id" class="message-system-event" data-message-id="@message.Id">
                    <span class="call-event-icon"><Icon Name="phone" /></span>
                    <span class="call-event-copy"><span><strong class="initiator">@message.Author.DisplayName</strong> started a call</span>
                    <time title="@message.CreatedAt.ToLocalTime().ToString("F")">@message.CreatedAt.ToLocalTime().ToString("g")</time></span>
                </div>
            }
            else
            {
                <MessageRow @key="(message.ClientMessageId ?? message.Id)" Message="message"
                        StartsGroup="OptimisticMessageGrouping.StartsNewGroup(previous, message, OptimisticCommunityPresentations)"
                        CanEdit="@(message.Kind == MessageKind.User && message.DeliveryState == MessageDeliveryState.Confirmed && !message.IsDeleted && message.Author.AccountId == CurrentAccountId)"
                        CanDelete="@(message.Id != RootMessageId && message.Kind == MessageKind.User && message.DeliveryState == MessageDeliveryState.Confirmed && !message.IsDeleted && (message.Author.AccountId == CurrentAccountId || CanManage))"
                        CurrentAccountId="CurrentAccountId" NodeAuthority="@NodeAuthority" CommunityManagement="CommunityManagement"
                        AuthorPresence="@PresenceFor(message.Author.AccountId)"
                        ShowAuthorPresence="@ShowAuthorPresence"
                        OnEditProfile="OnEditProfile" OnEditAvatars="OnEditAvatars"
                        OnCommunityProfileChanged="OnCommunityProfileChanged" OnMessage="OnMessage"
                        OnMemberRolesChanged="OnMemberRolesChanged"
                        OnMention="OnMention"
                        OnReply="OnReply" Edit="Edit" OnDelete="OnDelete" OnFocusReply="FocusMessageAsync"
                        EditRequest="@(_editRequestedMessageId == message.Id ? _editRequest : 0)"
                        OnEditingChanged="@(editing => EditingChanged(message.Id, editing))"
                        OnEditCompleted="OnEditCompleted"
                        OnRetryLocal="OnRetryLocal" OnRemoveLocal="OnRemoveLocal" />
                @if (message.Id == RootMessageId)
                {
                    <div class="root-message-separator" role="separator" aria-label="Replies"></div>
                }
            }
        }
    }
</div>

@code {
    [Parameter] public IReadOnlyList<ChannelMessageDto> Messages { get; set; } = [];
    [Parameter] public string EmptyIcon { get; set; } = "channel";
    [Parameter] public string EmptyTitle { get; set; } = "No messages yet";
    [Parameter] public string EmptyDescription { get; set; } = "Start the conversation in this channel.";
    [Parameter, EditorRequired] public required Guid CurrentAccountId { get; set; }
    [Parameter] public bool CanManage { get; set; }
    [Parameter, EditorRequired] public required string NodeAuthority { get; set; }
    [Parameter] public CommunityManagementDto? CommunityManagement { get; set; }
    [Parameter] public IReadOnlyDictionary<Guid, OptimisticCommunityAuthorPresentation>? OptimisticCommunityPresentations { get; set; }
    [Parameter] public DirectParticipantDto? DirectParticipant { get; set; }
    [Parameter] public EventCallback OnEditProfile { get; set; }
    [Parameter] public EventCallback OnEditAvatars { get; set; }
    [Parameter] public EventCallback OnCommunityProfileChanged { get; set; }
    [Parameter] public EventCallback<Guid> OnMessage { get; set; }
    [Parameter] public EventCallback<CommunityMemberRolesChange> OnMemberRolesChanged { get; set; }
    [Parameter] public EventCallback<CommunityMemberDto> OnMention { get; set; }
    [Parameter] public EventCallback<ChannelMessageDto> OnReply { get; set; }
    [Parameter, EditorRequired] public required Func<MessageEditSubmission, Task<bool>> Edit { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
    [Parameter] public EventCallback<Guid> OnRetryLocal { get; set; }
    [Parameter] public EventCallback<Guid> OnRemoveLocal { get; set; }
    [Parameter] public EventCallback OnLoadOlder { get; set; }
    [Parameter] public EventCallback<MessageViewportState> OnViewportStateChanged { get; set; }
    [Parameter] public EventCallback OnEditCompleted { get; set; }
    [Parameter] public int WindowRevision { get; set; }
    [Parameter] public long ReconciliationRevision { get; set; }
    [Parameter] public bool FollowLatest { get; set; } = true;
    [Parameter] public Guid? TargetMessageId { get; set; }
    [Parameter] public Guid? RootMessageId { get; set; }
    private ElementReference _container;
    private IJSObjectReference? _module;
    private DotNetObjectReference<MessageList>? _selfReference;
    private int _renderedCount = -1;
    private int _renderedRevision = -1;
    private long _renderedReconciliationRevision = -1;
    private bool _positioning = true;
    private bool _restorePrepend;
    private bool _suppressInitialPositionOnce;
    private LatestScrollBehavior _latestScrollAfterRender;
    private int _viewportGeneration;
    private Guid? _editRequestedMessageId;
    private Guid? _editingMessageId;
    private long _editRequest;
    private PublicPresence? PresenceFor(Guid accountId) => CommunityManagement?.Members
        .FirstOrDefault(value => value.AccountId == accountId)?.Presence
        ?? (DirectParticipant?.AccountId == accountId ? DirectParticipant.Presence : null);
    private bool ShowAuthorPresence => Appearance.Current?.ShowMessageAvatarPresence == true;
    private IReadOnlyList<ChannelMessageDto> DisplayMessages()
        => MessageTimeline.Visible(Messages);
    private void CloseMessageMenus() => MessageMenus.Close();

    protected override void OnInitialized() => Appearance.Changed += AppearanceChanged;
    private void AppearanceChanged() => _ = InvokeAsync(StateHasChanged);

    protected override void OnParametersSet()
    {
        if (_renderedReconciliationRevision != ReconciliationRevision)
        {
            var shouldFollow = MessageHistoryFollowLatest.ShouldFollow(
                FollowLatest, _renderedReconciliationRevision, ReconciliationRevision);
            _renderedReconciliationRevision = ReconciliationRevision;
            if (shouldFollow)
                _latestScrollAfterRender = LatestScrollBehavior.Instant;
        }
        if (_renderedRevision == WindowRevision) return;
        _renderedRevision = WindowRevision;
        _renderedCount = -1;
        if (_suppressInitialPositionOnce)
        {
            _suppressInitialPositionOnce = false;
            _positioning = false;
        }
        else _positioning = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/chat.js");
        if (firstRender)
        {
            _selfReference = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("wireMessageViewport", _container, _selfReference);
        }
        if (_positioning)
        {
            if (TargetMessageId is { } target)
                await _module.InvokeVoidAsync("focusMessageImmediate", _container, target.ToString());
            else
                await _module.InvokeVoidAsync("positionInitialLatest", _container);
            _positioning = false;
            _renderedCount = Messages.Count;
            await InvokeAsync(StateHasChanged);
            return;
        }
        if (_latestScrollAfterRender != LatestScrollBehavior.None)
        {
            var behavior = _latestScrollAfterRender;
            _latestScrollAfterRender = LatestScrollBehavior.None;
            _renderedCount = Messages.Count;
            await _module.InvokeVoidAsync("scrollMessageBottom", _container,
                behavior == LatestScrollBehavior.Smooth ? "smooth" : "instant");
            return;
        }
        if (_restorePrepend)
        {
            _restorePrepend = false;
            _renderedCount = Messages.Count;
            await _module.InvokeVoidAsync("restorePrependPosition", _container);
            return;
        }
        if (_renderedCount == Messages.Count) return;
        _renderedCount = Messages.Count;
        await _module.InvokeVoidAsync("followRealtimeAppend", _container);
    }

    [JSInvokable]
    public async Task LoadOlderFromScrollAsync()
    {
        if (!OnLoadOlder.HasDelegate || _positioning) return;
        var generation = _viewportGeneration;
        var messageCount = Messages.Count;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/chat.js");
        await _module.InvokeVoidAsync("capturePrependPosition", _container);
        await OnLoadOlder.InvokeAsync();
        if (generation != _viewportGeneration || Messages.Count <= messageCount) return;
        _restorePrepend = true;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task ViewportStateChangedAsync(bool isPinnedToLatest, bool shouldShowJumpToLatest) =>
        OnViewportStateChanged.InvokeAsync(new(isPinnedToLatest, shouldShowJumpToLatest));

    public async Task ScrollLatestAsync(bool smooth)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/chat.js");
        await _module.InvokeVoidAsync("scrollMessageBottom", _container, smooth ? "smooth" : "instant");
    }

    public void PrepareUserLatestTransition(bool smooth)
    {
        _viewportGeneration++;
        _restorePrepend = false;
        _suppressInitialPositionOnce = true;
        _latestScrollAfterRender = smooth ? LatestScrollBehavior.Smooth : LatestScrollBehavior.Instant;
    }

    public async Task<bool> BeginEditLatestOwnAsync()
    {
        if (_editingMessageId is not null) return false;
        var candidate = MessageTimeline.LatestEditableOwn(Messages, CurrentAccountId);
        if (candidate is null) return false;
        _editRequestedMessageId = candidate.Id;
        _editRequest++;
        await InvokeAsync(StateHasChanged);
        return true;
    }

    private void EditingChanged(Guid messageId, bool editing)
    {
        if (editing) _editingMessageId = messageId;
        else if (_editingMessageId == messageId) _editingMessageId = null;
    }

    private async Task FocusMessageAsync(Guid messageId)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/chat.js");
        await _module.InvokeVoidAsync("focusMessage", _container, messageId.ToString());
    }

    public async ValueTask DisposeAsync()
    {
        Appearance.Changed -= AppearanceChanged;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("unwireMessageViewport", _container);
            await _module.DisposeAsync();
        }
        _selfReference?.Dispose();
    }
    private enum LatestScrollBehavior { None, Instant, Smooth }
}
