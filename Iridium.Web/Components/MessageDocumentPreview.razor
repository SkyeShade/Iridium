@using Iridium.Client.Core
@using Iridium.Protocol
@implements IAsyncDisposable
@inject NodeSession Session
@inject ILogger<MessageDocumentPreview> Logger
@inject IJSRuntime JS
@inject IWebAssemblyHostEnvironment HostEnvironment

<section @ref="_root" class="message-document-preview @(Source.Provider == CommunityChannelEmbedProvider.GoogleSheets ? "sheet-preview" : "document-preview") @(_expanded ? "expanded" : "collapsed")" aria-label="@Source.ProviderName preview">
    <header>
        <span class="document-label"><Icon Name="file" Size="16" /><strong>@Source.ContentName</strong><small>@Source.ProviderName</small></span>
        <span class="document-actions">
            <button type="button" disabled="@_refreshing" @onclick="RefreshAsync">@(_refreshing ? "Refreshing…" : "Refresh")</button>
            <a href="@Source.OpenUrl" target="_blank" rel="noopener noreferrer">Open in @Source.ProviderName <span aria-hidden="true">↗</span></a>
        </span>
    </header>
    <div class="message-document-body">
        @if (!_visible || _loading)
        {
            <div class="message-document-state"><span class="loading" aria-hidden="true"></span>Loading document…</div>
        }
        else if (_document is { Status: ChannelEmbedDocumentStatus.Ready, Document: { } document })
        {
            @if (_document.IsStale) { <div class="message-document-stale">Showing the last available version.</div> }
            <EmbeddedDocumentView @key="RenderKey" Document="document" CommunityId="CommunityId" ChannelId="ChannelId"
                                  MessageId="MessageId" DocumentId="@Source.RequestIdentity"
                                  LimitCollapsedPreview="@(!_expanded)" />
        }
        else if (_document is { Status: ChannelEmbedDocumentStatus.Ready, Sheet: { } sheet })
        {
            @if (_document.IsStale) { <div class="message-document-stale">Showing the last available version.</div> }
            <EmbeddedSheetView @key="RenderKey" Sheet="sheet" CommunityId="CommunityId" ChannelId="ChannelId"
                               MessageId="MessageId" DocumentId="@Source.RequestIdentity"
                               LimitCollapsedPreview="@(!_expanded)" />
        }
        else
        {
            <div class="message-document-state unavailable">
                <strong>This @Source.ProviderName item couldn't be loaded.</strong>
                <a href="@Source.OpenUrl" target="_blank" rel="noopener noreferrer">Open in @Source.ProviderName</a>
            </div>
        }
    </div>
    <footer>
        <button type="button" aria-expanded="@_expanded" @onclick="ToggleExpanded">
            @(_expanded ? "Collapse document" : "Expand document")
        </button>
    </footer>
</section>

@code {
    [Parameter, EditorRequired] public Guid MessageId { get; set; }
    [Parameter, EditorRequired] public Guid CommunityId { get; set; }
    [Parameter, EditorRequired] public Guid ChannelId { get; set; }
    [Parameter, EditorRequired] public required EmbeddedContentConfiguration Source { get; set; }
    private string? _sourceKey;
    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<MessageDocumentPreview>? _selfReference;
    private ChannelEmbedDocumentDto? _document;
    private CancellationTokenSource? _loadCancellation;
    private bool _loading;
    private bool _refreshing;
    private bool _expanded;
    private bool _visible;
    private bool _wireVisibility;
    private long _loadStarted;
    private long _dtoReceivedAt;
    private long _stateChangeRequestedAt;
    private bool _applyDiagnosticPending;
    private string RenderKey => $"{_sourceKey}:{_document?.IsStale}";

    protected override void OnParametersSet()
    {
        var key = $"{MessageId:N}:{Source.CacheIdentity}";
        if (key == _sourceKey) return;
        _sourceKey = key;
        _expanded = false;
        _visible = false;
        _document = null;
        _loading = false;
        _wireVisibility = true;
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
        _loadCancellation = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_wireVisibility)
        {
            _wireVisibility = false;
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/chat.js");
            _selfReference ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("observeDeferredContent", _root, _selfReference);
        }
        if (_applyDiagnosticPending && HostEnvironment.IsDevelopment())
        {
            _applyDiagnosticPending = false;
            Logger.LogInformation("Message embed host render completed MessageId={MessageId} DocumentId={DocumentId} RazorCommitMs={RazorCommitMs:F1} TotalApplyMs={TotalApplyMs:F1}.",
                MessageId, Source.RequestIdentity,
                System.Diagnostics.Stopwatch.GetElapsedTime(_stateChangeRequestedAt).TotalMilliseconds,
                System.Diagnostics.Stopwatch.GetElapsedTime(_dtoReceivedAt).TotalMilliseconds);
        }
    }

    [JSInvokable]
    public Task DeferredContentVisibleAsync()
    {
        if (_visible) return Task.CompletedTask;
        _visible = true;
        _loading = true;
        _loadStarted = System.Diagnostics.Stopwatch.GetTimestamp();
        if (HostEnvironment.IsDevelopment())
            Logger.LogInformation("Message embed mounted MessageId={MessageId} DocumentId={DocumentId}.",
                MessageId, Source.RequestIdentity);
        var cancellation = _loadCancellation = new();
        _ = LoadAsync(_sourceKey, cancellation);
        return InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync(string? sourceKey, CancellationTokenSource cancellation)
    {
        try
        {
            var document = CommunityId == Guid.Empty
                ? await Session.GetDirectMessageEmbedDocumentAsync(ChannelId, MessageId, Source.RequestIdentity,
                    cancellation.Token)
                : await Session.GetCommunityMessageEmbedDocumentAsync(CommunityId, ChannelId, MessageId,
                    Source.RequestIdentity, cancellation.Token);
            if (cancellation.IsCancellationRequested || sourceKey != _sourceKey) return;
            _dtoReceivedAt = System.Diagnostics.Stopwatch.GetTimestamp();
            _document = document;
            if (HostEnvironment.IsDevelopment())
                Logger.LogInformation("Message embed DTO received and state assigned MessageId={MessageId} DocumentId={DocumentId} Status={Status} NetworkAndDeserializeMs={ElapsedMs:F1} StateAssignMs={StateAssignMs:F1}.",
                    MessageId, Source.RequestIdentity, document.Status,
                    System.Diagnostics.Stopwatch.GetElapsedTime(_loadStarted).TotalMilliseconds,
                    System.Diagnostics.Stopwatch.GetElapsedTime(_dtoReceivedAt).TotalMilliseconds);
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Message document {DocumentId} could not be loaded for message {MessageId}.",
                Source.RequestIdentity, MessageId);
            if (!cancellation.IsCancellationRequested && sourceKey == _sourceKey)
                _document = new(ChannelEmbedDocumentStatus.TemporaryFailure, null);
        }
        finally
        {
            if (!cancellation.IsCancellationRequested && sourceKey == _sourceKey)
            {
                _loading = false;
                _stateChangeRequestedAt = System.Diagnostics.Stopwatch.GetTimestamp();
                _applyDiagnosticPending = HostEnvironment.IsDevelopment();
                if (HostEnvironment.IsDevelopment())
                    Logger.LogInformation("Message embed StateHasChanged requested MessageId={MessageId} DocumentId={DocumentId}.",
                        MessageId, Source.RequestIdentity);
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void ToggleExpanded()
    {
        _expanded = !_expanded;
        if (!_visible) _ = DeferredContentVisibleAsync();
    }

    private async Task RefreshAsync()
    {
        if (_refreshing) return;
        _visible = true;
        var sourceKey = _sourceKey;
        var cancellationToken = _loadCancellation?.Token ?? CancellationToken.None;
        _refreshing = true;
        try
        {
            var document = CommunityId == Guid.Empty
                ? await Session.RefreshDirectMessageEmbedDocumentAsync(ChannelId, MessageId, Source.RequestIdentity,
                    cancellationToken)
                : await Session.RefreshCommunityMessageEmbedDocumentAsync(CommunityId, ChannelId, MessageId,
                    Source.RequestIdentity, cancellationToken);
            if (!cancellationToken.IsCancellationRequested && sourceKey == _sourceKey) _document = document;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Message document {DocumentId} could not be refreshed for message {MessageId}.",
                Source.RequestIdentity, MessageId);
        }
        finally { if (sourceKey == _sourceKey) _refreshing = false; }
    }

    public async ValueTask DisposeAsync()
    {
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("unobserveDeferredContent", _root); }
            catch (JSDisconnectedException) { }
            await _module.DisposeAsync();
        }
        _selfReference?.Dispose();
    }
}
