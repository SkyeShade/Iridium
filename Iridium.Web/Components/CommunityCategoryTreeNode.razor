@using Iridium.Protocol
@using Iridium.Web.Models

<div class="category-tree-node" data-sidebar-item data-sidebar-kind="category" data-sidebar-id="@Category.Id"
     data-sidebar-parent="@Category.ParentCategoryId" data-sidebar-depth="@Depth" data-category-node="@Category.Id">
    <CategoryRow Category="Category" CanManage="CanManage" Depth="Depth" Collapsed="Collapsed.Contains(Category.Id)"
                 CanCreateSubcategory="@(Depth < 5)" HasUnreadDescendants="HasUnread"
                 OnToggle="OnToggle" OnEdit="OnEdit" OnCreateChannel="OnCreateChannel"
                 OnCreateSubcategory="OnCreateSubcategory" OnDelete="OnDelete">
        @foreach (var item in DirectItems)
        {
            if (item.Channel is { } channel)
            {
                <ChannelRow @key="item.Id" Channel="channel" CanManage="CanManage" Depth="@(Depth + 1)"
                            Selected="@(SelectedChannelId == channel.Id)" OnSelect="OnSelectChannel"
                            Room="@VoiceRooms.FirstOrDefault(value => value.ChannelId == channel.Id)"
                            Connected="@(ConnectedVoiceChannelId == channel.Id)"
                            CurrentAccountId="CurrentAccountId"
                            OnEdit="OnEditChannel" OnDelete="OnDeleteChannel" />
            }
            else if (item.Category is { } child)
            {
                <CommunityCategoryTreeNode @key="item.Id" Category="child" Categories="Categories" Channels="Channels"
                                           Depth="@(Depth + 1)" CanManage="CanManage" Collapsed="Collapsed"
                                           VoiceRooms="VoiceRooms" ConnectedVoiceChannelId="ConnectedVoiceChannelId"
                                           CurrentAccountId="CurrentAccountId"
                                           SelectedChannelId="SelectedChannelId" OnToggle="OnToggle" OnEdit="OnEdit"
                                           OnCreateChannel="OnCreateChannel" OnCreateSubcategory="OnCreateSubcategory"
                                           OnDelete="OnDelete" OnSelectChannel="OnSelectChannel"
                                           OnEditChannel="OnEditChannel" OnDeleteChannel="OnDeleteChannel" />
            }
        }
    </CategoryRow>
</div>

@code {
    [Parameter, EditorRequired] public required CommunityCategoryDto Category { get; set; }
    [Parameter, EditorRequired] public required IReadOnlyList<CommunityCategoryDto> Categories { get; set; }
    [Parameter, EditorRequired] public required IReadOnlyList<CommunityChannelDto> Channels { get; set; }
    [Parameter, EditorRequired] public required IReadOnlySet<Guid> Collapsed { get; set; }
    [Parameter] public Guid? SelectedChannelId { get; set; }
    [Parameter] public int Depth { get; set; } = 1;
    [Parameter] public bool CanManage { get; set; }
    [Parameter] public IReadOnlyCollection<ActiveVoiceRoomDto> VoiceRooms { get; set; } = [];
    [Parameter] public Guid? ConnectedVoiceChannelId { get; set; }
    [Parameter] public Guid CurrentAccountId { get; set; }
    [Parameter] public EventCallback<CommunityCategoryDto> OnToggle { get; set; }
    [Parameter] public EventCallback<CommunityCategoryDto> OnEdit { get; set; }
    [Parameter] public EventCallback<CommunityCategoryDto> OnCreateChannel { get; set; }
    [Parameter] public EventCallback<CommunityCategoryDto> OnCreateSubcategory { get; set; }
    [Parameter] public EventCallback<CommunityCategoryDto> OnDelete { get; set; }
    [Parameter] public EventCallback<CommunityChannelDto> OnSelectChannel { get; set; }
    [Parameter] public EventCallback<CommunityChannelDto> OnEditChannel { get; set; }
    [Parameter] public EventCallback<CommunityChannelDto> OnDeleteChannel { get; set; }

    private IEnumerable<CommunitySidebarVisualItem> DirectItems => Categories
        .Where(value => value.ParentCategoryId == Category.Id).Select(CommunitySidebarVisualItem.From)
        .Concat(Channels.Where(value => value.CategoryId == Category.Id).Select(CommunitySidebarVisualItem.From))
        .OrderBy(value => value.Position).ThenBy(value => value.Type).ThenBy(value => value.Id);
    private bool HasUnread
    {
        get
        {
            var ids = new HashSet<Guid> { Category.Id };
            var changed = true;
            while (changed)
            {
                changed = false;
                foreach (var child in Categories.Where(value => value.ParentCategoryId is { } parent && ids.Contains(parent)))
                    changed |= ids.Add(child.Id);
            }
            return Channels.Any(value => value.CategoryId is { } categoryId && ids.Contains(categoryId) &&
                                         (value.UnreadCount > 0 || value.MentionCount > 0));
        }
    }
}
