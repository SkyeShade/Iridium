@using Iridium.Client.Core
@using Iridium.Protocol
@using Iridium.Web.Models
@implements IAsyncDisposable
@inject CommunityForumSession Forum
@inject NodeSession Session
@inject IMessageDraftStore Drafts
@inject ILogger<ForumChannelView> Logger
@inject IJSRuntime JS

<section class="forum-view @Mode.ToString().ToLowerInvariant()" @ref="_forumSurface">
    @switch (Mode)
    {
        case ForumViewMode.Index:
            <ForumPostBrowser ChannelName="@Channel.Name" Posts="FilteredPosts" Search="@_search" Tags="Forum.Tags" SelectedTagIds="_filterTagIds"
                              CommunityManagement="CommunityManagement"
                              SearchChangedCallback="SearchChangedAsync" TagFilterChanged="TagFilterChangedAsync" CanCreatePosts="CanCreatePosts"
                              IsLoading="Forum.IsLoading" HasMore="Forum.NextOffset.HasValue"
                              OnNewPost="BeginCreateAsync" OnLoadMore="() => Forum.LoadMoreAsync()" OnOpen="OpenPostAsync"
                              OnContextMenu="OpenPostContextMenu" />
            break;

        case ForumViewMode.CreatingPost:
            <section class="forum-create-view" aria-label="Create Forum post">
                <header class="forum-create-header">
                    <button class="icon-button" title="Cancel new post" aria-label="Cancel new post" @onclick="BackToIndexAsync"><Icon Name="close" /></button>
                    <div><strong>New post</strong><small># @Channel.Name</small></div>
                </header>
                <div class="forum-create-content">
                    <label class="forum-title-field"><span>Title</span><input maxlength="120" value="@_newTitle" @oninput="TitleChangedAsync" placeholder="What is this discussion about?" autofocus /></label>
                    @if (CanAttachDocuments)
                    {
                        <section class="forum-document-editor">
                            <header><span><strong>Attach document</strong><small>Optionally display a Google Doc or Sheet above this Post's discussion.</small></span>
                                @if (!_newEmbedEnabled) { <button type="button" @onclick="() => _newEmbedEnabled = true"><Icon Name="plus" /> Add document</button> }
                            </header>
                            @if (_newEmbedEnabled)
                            {
                                <label><span>Google URL</span><input type="url" value="@_newEmbedUrl" @oninput="NewEmbedUrlChanged" placeholder="https://docs.google.com/..." /></label>
                                @if (NewEmbedContent is { } detected) { <small><Icon Name="file" /> Detected: @ProviderName(detected.Provider)</small> }
                                <button type="button" class="secondary" @onclick="ClearNewDocument">Remove</button>
                            }
                        </section>
                    }
                    <ForumTagPicker Tags="Forum.Tags" SelectedTagIds="_newTagIds" CanManageModerated="CanManageMessages"
                                    SelectedTagIdsChanged="NewTagsChanged" />
                    @if (Channel.RequireTag && _newTagIds.Count == 0)
                    {
                        <p class="forum-tag-required" role="status">Select at least one tag before publishing this Post.</p>
                    }
                    <MessageComposer @ref="_newPostComposer" Class="forum-create-composer" ChannelName="@Channel.Name"
                                     PlaceholderText="Enter a message..." Busy="_creating" Community="Community"
                                     CommunityManagement="CommunityManagement" SendRich="CreatePostAsync"
                                     OnCommunityProfileChanged="OnCommunityProfileChanged"
                                     OnSubmitted="FinishCreatedPostAsync" SendableContentChanged="BodySendableChanged"
                                     CanAttachFiles="CanAttachFiles"
                                     CanMentionEveryone="CanMentionEveryone" CanUseExternalEmoji="CanUseExternalEmoji"
                                     NodeAuthority="@NodeAuthority"
                                     AccountId="@CurrentAccountId" ConversationKind="@CreateBodyDraftScope.ConversationKind"
                                     ConversationId="@CreateBodyDraftScope.ConversationId" />
                    @if (!string.IsNullOrWhiteSpace(_error)) { <p class="forum-error" role="alert">@_error</p> }
                </div>
                <footer class="forum-create-actions">
                    <button class="cancel-post-button" @onclick="BackToIndexAsync">Cancel</button>
                    <button class="publish-post-button" disabled="@(!CanPublish)" @onclick="PublishAsync">Post</button>
                </footer>
            </section>
            break;

        case ForumViewMode.ViewingPost:
            @if (_selectedPost is { } selectedPost)
            {
                <div class="forum-split-shell">
                    <aside class="forum-browser-pane">
                        <ForumPostBrowser ChannelName="@Channel.Name" Posts="FilteredPosts" Search="@_search" Compact="true" Tags="Forum.Tags" SelectedTagIds="_filterTagIds"
                                          CommunityManagement="CommunityManagement"
                                          SearchChangedCallback="SearchChangedAsync" TagFilterChanged="TagFilterChangedAsync" CanCreatePosts="CanCreatePosts"
                                          IsLoading="Forum.IsLoading" HasMore="Forum.NextOffset.HasValue"
                                          SelectedPostId="SelectedForumPostId" OnNewPost="BeginCreateAsync"
                                          OnLoadMore="() => Forum.LoadMoreAsync()" OnOpen="OpenPostAsync"
                                          OnContextMenu="OpenPostContextMenu" />
                    </aside>
                    <section class="forum-discussion-pane">
                        <header class="forum-discussion-header">
                            <button class="post-back" title="Close post" aria-label="Close post" @onclick="BackToIndexAsync"><Icon Name="back" /></button>
                            @if (_editingTitle)
                            {
                                <div class="post-title-edit"><input maxlength="120" @bind="_titleDraft" aria-label="Forum post title" /><small># @Channel.Name</small></div>
                            }
                            else
                            {
                                <div class="forum-post-context-surface" data-forum-post-context-id="@selectedPost.Id"
                                     @oncontextmenu="OpenCurrentPostContextMenu" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
                                    @if (selectedPost.Tags is { Count: > 0 })
                                    {
                                        <span class="forum-header-tags">@foreach (var tag in selectedPost.Tags.OrderBy(value => value.SortOrder)) { <ForumTagChip Tag="tag" /> }</span>
                                    }
                                    <strong>@selectedPost.Title</strong><small># @Channel.Name</small>
                                </div>
                            }
                            @if (selectedPost.IsPinned && !CanManageMessages) { <span title="Pinned"><Icon Name="pin" /></span> }
                            @if (CanManageMessages)
                            {
                                <button class="post-pin-action @(selectedPost.IsPinned ? "active" : null)" title="@PinActionTitle"
                                        aria-label="@PinActionTitle" aria-pressed="@selectedPost.IsPinned"
                                        @onclick="TogglePinnedAsync"><Icon Name="pin" /></button>
                                <button title="@(selectedPost.IsLocked ? "Unlock post" : "Lock post")" aria-label="@(selectedPost.IsLocked ? "Unlock post" : "Lock post")" @onclick="ToggleLockedAsync"><Icon Name="lock" /></button>
                            }
                            @if (selectedPost.Author.AccountId == CurrentAccountId || CanManageMessages)
                            {
                                <button title="@(_editingTitle ? "Save title" : "Edit title")" aria-label="@(_editingTitle ? "Save title" : "Edit title")" @onclick="EditTitleAsync"><Icon Name="@(_editingTitle ? "check" : "edit")" /></button>
                                <button title="Edit tags" aria-label="Edit tags" @onclick="BeginEditTags"><Icon Name="tag" /></button>
                                @if (CanEditDocument(selectedPost))
                                {
                                    <button title="@(selectedPost.EmbedProvider is null ? "Add document" : "Edit document")" aria-label="@(selectedPost.EmbedProvider is null ? "Add document" : "Edit document")" @onclick="BeginEditDocument"><Icon Name="file" /></button>
                                }
                                <button class="delete-post" title="@(_confirmDelete ? "Confirm delete post" : "Delete post")" aria-label="@(_confirmDelete ? "Confirm delete Forum post" : "Delete Forum post")" @onclick="DeletePostAsync"><Icon Name="trash" /></button>
                            }
                        </header>
                        @if (_editingTags)
                        {
                            <div class="forum-edit-tags">
                                <ForumTagPicker Tags="Forum.Tags" SelectedTagIds="_editTagIds" CanManageModerated="CanManageMessages"
                                                SelectedTagIdsChanged="EditTagsChanged" />
                                <button type="button" @onclick="SaveEditedTagsAsync">Save Tags</button>
                                <button type="button" @onclick="CancelEditTags">Cancel</button>
                            </div>
                        }
                        @if (_editingDocument)
                        {
                            <div class="forum-edit-document">
                                <label><span>Google URL</span><input type="url" value="@_documentUrlDraft" @oninput="DocumentUrlChanged" placeholder="https://docs.google.com/..." /></label>
                                @if (EditedEmbedContent is { } detected) { <small><Icon Name="file" /> Detected: @ProviderName(detected.Provider)</small> }
                                <button type="button" class="primary" @onclick="SaveEditedDocumentAsync">Save Document</button>
                                @if (selectedPost.EmbedProvider is not null)
                                {
                                    <button type="button" class="danger" @onclick="RemoveDocumentAsync">@(_confirmRemoveDocument ? "Confirm Remove" : "Remove")</button>
                                }
                                <button type="button" class="secondary" @onclick="CancelEditDocument">Cancel</button>
                            </div>
                        }
                        @if (selectedPost.IsLocked)
                        {
                            <div class="forum-lock-banner"><Icon Name="lock" /><span>This post has been locked. Only moderators can send messages.</span>@if (CanManageMessages) { <button @onclick="ToggleLockedAsync">Unlock</button> }</div>
                        }
                        <div class="forum-discussion">
                            <ChannelView @key="(selectedPost.DiscussionChannelId, selectedPost.IsLocked)" Community="Community"
                                         IsMobileLayout="IsMobileLayout"
                                         Channel="DiscussionChannel" CurrentAccountId="CurrentAccountId" NodeAuthority="@NodeAuthority"
                                         CommunityManagement="CommunityManagement" OnEditProfile="OnEditProfile" OnEditAvatars="OnEditAvatars"
                                         OnCommunityProfileChanged="OnCommunityProfileChanged" OnMessage="OnMessage"
                                         OnMemberRolesChanged="OnMemberRolesChanged" CanManageMessages="CanManageMessages"
                                         CanAddReactions="CanAddReactions" CanUseExternalEmoji="CanUseExternalEmoji"
                                         CanSend="@(!selectedPost.IsLocked || CanManageMessages)" CanAttachFiles="CanAttachFiles"
                                         CanMentionEveryone="CanMentionEveryone" DraftConversationKind="forum"
                                         DraftConversationId="selectedPost.Id" RootMessageId="selectedPost.RootMessageId"
                                         ForumPostId="selectedPost.Id" ForumChannelId="Channel.Id"
                                         ForumPostEmbedProvider="selectedPost.EmbedProvider" ForumPostEmbedUrl="@selectedPost.EmbedUrl"
                                         ShowReadOnlyNotice="false" />
                        </div>
                    </section>
                </div>
            }
            break;
    }
</section>

@if (_postContext is { } postContext)
{
    var canEditContextPost = postContext.Post.Author.AccountId == CurrentAccountId || CanManageMessages;
    <ForumPostContextMenu Post="postContext.Post" X="postContext.X" Y="postContext.Y" IsOpenPost="postContext.IsOpenPost"
                          CanMarkRead="@(postContext.Post.UnreadCount > 0)" CanEdit="canEditContextPost"
                          CanManage="CanManageMessages" CanDelete="canEditContextPost"
                          OnOpen="OpenContextPostAsync" OnMarkRead="MarkContextPostReadAsync"
                          OnToggleLock="ToggleContextPostLockedAsync" OnEditTitle="EditContextPostTitleAsync"
                          OnEditTags="EditContextPostTagsAsync" OnTogglePin="ToggleContextPostPinnedAsync"
                          CanManageDocument="@CanEditDocument(postContext.Post)"
                          OnEditDocument="EditContextPostDocumentAsync" OnRemoveDocument="RemoveContextPostDocumentAsync"
                          OnOpenDocument="OpenContextPostDocumentAsync"
                          OnDelete="DeleteContextPostAsync" OnClose="ClosePostContextMenu" />
}

@code {
    public enum ForumViewMode { Index, CreatingPost, ViewingPost }

    [Parameter, EditorRequired] public required CommunityDto Community { get; set; }
    [Parameter, EditorRequired] public required CommunityChannelDto Channel { get; set; }
    [Parameter, EditorRequired] public required Guid CurrentAccountId { get; set; }
    [Parameter, EditorRequired] public required string NodeAuthority { get; set; }
    [Parameter] public CommunityManagementDto? CommunityManagement { get; set; }
    [Parameter] public bool CanCreatePosts { get; set; }
    [Parameter] public bool CanManageMessages { get; set; }
    [Parameter] public bool CanAddReactions { get; set; }
    [Parameter] public bool CanUseExternalEmoji { get; set; }
    [Parameter] public bool CanAttachFiles { get; set; }
    [Parameter] public bool CanMentionEveryone { get; set; }
    [Parameter] public bool IsMobileLayout { get; set; }
    [Parameter] public EventCallback<CommunityForumPostDto?> OnPostOpenChanged { get; set; }
    [Parameter] public EventCallback<bool> OnSubViewChanged { get; set; }
    [Parameter] public EventCallback OnEditProfile { get; set; }
    [Parameter] public EventCallback OnEditAvatars { get; set; }
    [Parameter] public EventCallback OnCommunityProfileChanged { get; set; }
    [Parameter] public EventCallback<Guid> OnMessage { get; set; }
    [Parameter] public EventCallback<CommunityMemberRolesChange> OnMemberRolesChanged { get; set; }

    private Guid? _loadedChannelId;
    private ForumViewMode Mode { get; set; }
    private CommunityForumPostDto? _selectedPost;
    private CommunityForumPostDto? _createdPost;
    private MessageComposer? _newPostComposer;
    private bool _creating, _confirmDelete, _editingTitle, _editingTags, _editingDocument;
    private bool _newEmbedEnabled, _confirmRemoveDocument;
    private bool _newBodySendable;
    private string _titleDraft = string.Empty, _newTitle = string.Empty, _search = string.Empty;
    private string _newEmbedUrl = string.Empty, _documentUrlDraft = string.Empty;
    private string? _error;
    private CancellationTokenSource? _titleDraftDebounce;
    private CancellationTokenSource? _filterDebounce;
    private CancellationTokenSource? _postLoadCancellation;
    private long _postLoadGeneration;
    private IReadOnlyList<Guid> _newTagIds = [], _editTagIds = [], _filterTagIds = [];
    private ForumPostContextRequest? _postContext;
    private ElementReference _forumSurface;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ForumChannelView>? _selfReference;

    private MessageDraftScope CreateBodyDraftScope => CommunityForumPostDrafts.BodyScope(NodeAuthority, CurrentAccountId, Community.Id, Channel.Id);
    private MessageDraftScope CreateTitleDraftScope => CommunityForumPostDrafts.TitleScope(NodeAuthority, CurrentAccountId, Community.Id, Channel.Id);
    private IReadOnlyList<CommunityForumPostDto> FilteredPosts => Forum.Posts;
    private Guid? SelectedForumPostId { get; set; }
    private bool CanPublish => !_creating && !string.IsNullOrWhiteSpace(_newTitle) && _newBodySendable &&
        (!Channel.RequireTag || _newTagIds.Count > 0) &&
        (!_newEmbedEnabled || NewEmbedContent is not null);
    private EmbeddedContentConfiguration? NewEmbedContent => CommunityChannelEmbeds.TryResolveContent(_newEmbedUrl, out var value) ? value : null;
    private EmbeddedContentConfiguration? EditedEmbedContent => CommunityChannelEmbeds.TryResolveContent(_documentUrlDraft, out var value) ? value : null;
    private static string ProviderName(CommunityChannelEmbedProvider provider) => provider == CommunityChannelEmbedProvider.GoogleSheets ? "Google Sheets" : "Google Docs";
    private bool CanAttachDocuments => Channel.AllowDocumentEmbeds &&
        HasPermission(CommunityPermission.EmbedDocumentsInForumPosts);
    private string PinActionTitle => _selectedPost?.IsPinned == true ? "Unpin post" : "Pin post";
    private CommunityChannelDto DiscussionChannel => new(_selectedPost!.DiscussionChannelId, Community.Id, null, _selectedPost.Title, 0, _selectedPost.CreatedAt, Kind: CommunityChannelKind.Text, EffectivePermissions: Channel.EffectivePermissions);

    protected override void OnInitialized() => Forum.Changed += ForumChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/chat.js");
        _selfReference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("wireForumPostLongPress", _forumSurface, _selfReference);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedChannelId == Channel.Id) return;
        _loadedChannelId = Channel.Id;
        _selectedPost = null;
        SelectedForumPostId = null;
        _createdPost = null;
        Mode = ForumViewMode.Index;
        _search = string.Empty;
        _filterTagIds = [];
        _newTagIds = [];
        _newEmbedEnabled = false;
        _newEmbedUrl = string.Empty;
        _error = null;
        _newTitle = await Drafts.LoadAsync(CreateTitleDraftScope) ?? string.Empty;
        await OnSubViewChanged.InvokeAsync(false);
        await Forum.LoadAsync(Community.Id, Channel.Id);
    }

    private void ForumChanged()
    {
        _postContext = null;
        if (_selectedPost is { } selected)
        {
            var refreshed = Forum.Posts.FirstOrDefault(value => value.Id == selected.Id);
            if (refreshed is null && Forum.LastDeletedPostId == selected.Id)
            {
                _selectedPost = null;
                SelectedForumPostId = null;
                Mode = ForumViewMode.Index;
                _ = OnPostOpenChanged.InvokeAsync(null);
                _ = OnSubViewChanged.InvokeAsync(false);
                _ = InvokeAsync(StateHasChanged);
                return;
            }
            _selectedPost = refreshed is null ? selected : refreshed with
            {
                // List DTOs intentionally omit the URL. Preserve the open-post source unless a
                // realtime update explicitly replaces it or clears its provider.
                EmbedUrl = refreshed.EmbedProvider == selected.EmbedProvider && refreshed.EmbedUrl is null
                    ? selected.EmbedUrl
                    : refreshed.EmbedUrl
            };
            _ = OnPostOpenChanged.InvokeAsync(_selectedPost);
            if (_selectedPost.UnreadCount > 0) _ = InvokeAsync(MarkCurrentPostReadAsync);
        }
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task SearchChangedAsync(string value)
    {
        _search = value;
        _filterDebounce?.Cancel();
        _filterDebounce?.Dispose();
        _filterDebounce = new();
        try { await Task.Delay(250, _filterDebounce.Token); await Forum.ApplyFilterAsync(_search, _filterTagIds, _filterDebounce.Token); }
        catch (OperationCanceledException) { }
    }
    private async Task TagFilterChangedAsync(IReadOnlyList<Guid> value)
    {
        _filterTagIds = value;
        await Forum.ApplyFilterAsync(_search, _filterTagIds);
    }
    private void BodySendableChanged(bool sendable) => _newBodySendable = sendable;

    private async Task BeginCreateAsync()
    {
        if (!CanCreatePosts) return;
        _selectedPost = null;
        SelectedForumPostId = null;
        Mode = ForumViewMode.CreatingPost;
        _error = null;
        await OnPostOpenChanged.InvokeAsync(null);
        await OnSubViewChanged.InvokeAsync(true);
    }

    private async Task TitleChangedAsync(ChangeEventArgs args)
    {
        _newTitle = args.Value?.ToString() ?? string.Empty;
        _titleDraftDebounce?.Cancel();
        _titleDraftDebounce?.Dispose();
        _titleDraftDebounce = new();
        var token = _titleDraftDebounce.Token;
        try { await Task.Delay(250, token); await PersistTitleDraftAsync(token); }
        catch (OperationCanceledException) { }
    }

    private Task PublishAsync() => _newPostComposer?.SubmitAsync() ?? Task.CompletedTask;

    private async Task<bool> CreatePostAsync(MessageSubmission submission)
    {
        if (_creating) return false;
        if (string.IsNullOrWhiteSpace(_newTitle)) { _error = "Enter a post title."; return false; }
        _creating = true;
        _error = null;
        try
        {
            if (Channel.RequireTag && _newTagIds.Count == 0) { _error = "Select at least one tag."; return false; }
            CommunityChannelEmbedUpdate? embed = null;
            if (_newEmbedEnabled)
            {
                if (!CanAttachDocuments || NewEmbedContent is not { } detected)
                { _error = "Enter a valid Google Docs or Google Sheets URL."; return false; }
                embed = new(detected.Provider, detected.OpenUrl);
            }
            _createdPost = await Forum.CreateAsync(_newTitle.Trim(), submission.Content, submission.Mentions,
                submission.Attachments, submission.UploadAttachments, _newTagIds, embed);
            return true;
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Could not create Forum post in {ChannelId}.", Channel.Id);
            _error = exception.GetBaseException().Message;
            return false;
        }
        finally { _creating = false; }
    }

    private async Task FinishCreatedPostAsync()
    {
        if (_createdPost is not { } post) return;
        _titleDraftDebounce?.Cancel();
        await Drafts.RemoveAsync(CreateTitleDraftScope);
        _newTitle = string.Empty;
        _newTagIds = [];
        ClearNewDocument();
        _createdPost = null;
        await OpenPostAsync(post);
    }

    private async Task OpenPostAsync(CommunityForumPostDto post)
    {
        _postContext = null;
        _postLoadCancellation?.Cancel();
        _postLoadCancellation?.Dispose();
        _postLoadCancellation = new();
        var cancellationToken = _postLoadCancellation.Token;
        var generation = ++_postLoadGeneration;
        try
        {
            post = await Session.GetForumPostAsync(Community.Id, Channel.Id, post.Id, cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { return; }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Could not open Forum post {PostId}.", post.Id);
            _error = exception.GetBaseException().Message;
            return;
        }
        if (generation != _postLoadGeneration || cancellationToken.IsCancellationRequested) return;
        _selectedPost = post;
        SelectedForumPostId = post.Id;
        Mode = ForumViewMode.ViewingPost;
        _confirmDelete = false;
        _editingTitle = false;
        _editingTags = false;
        _editingDocument = false;
        _confirmRemoveDocument = false;
        _editTagIds = [];
        _titleDraft = post.Title;
        Forum.MarkRead(post.Id);
        try { await Session.MarkCommunityChannelReadAsync(Community.Id, post.DiscussionChannelId); }
        catch (Exception exception) { Logger.LogDebug(exception, "Could not mark Forum post {PostId} read.", post.Id); }
        await OnPostOpenChanged.InvokeAsync(post);
        await OnSubViewChanged.InvokeAsync(true);
    }

    public Task BackAsync() => BackToIndexAsync();

    public async Task BackToIndexAsync()
    {
        _postLoadCancellation?.Cancel();
        _postLoadCancellation?.Dispose();
        _postLoadCancellation = null;
        _postLoadGeneration++;
        _postContext = null;
        if (Mode == ForumViewMode.CreatingPost) await PersistTitleDraftAsync();
        _selectedPost = null;
        SelectedForumPostId = null;
        _createdPost = null;
        Mode = ForumViewMode.Index;
        _confirmDelete = false;
        _editingTitle = false;
        _editingTags = false;
        _editingDocument = false;
        _confirmRemoveDocument = false;
        _editTagIds = [];
        _error = null;
        await OnPostOpenChanged.InvokeAsync(null);
        await OnSubViewChanged.InvokeAsync(false);
    }

    public async Task MarkCurrentPostReadAsync()
    {
        if (_selectedPost is not { } post) return;
        await Session.MarkCommunityChannelReadAsync(Community.Id, post.DiscussionChannelId);
        Forum.MarkRead(post.Id);
    }

    private Task OpenPostContextMenu(ForumPostContextRequest request)
    {
        _postContext = request;
        return Task.CompletedTask;
    }

    private Task OpenCurrentPostContextMenu(MouseEventArgs args)
    {
        if (_selectedPost is null) return Task.CompletedTask;
        _postContext = new(_selectedPost, args.ClientX, args.ClientY, true);
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OpenForumPostContextFromLongPressAsync(string postId, double x, double y)
    {
        if (!Guid.TryParse(postId, out var id)) return Task.CompletedTask;
        var post = _selectedPost?.Id == id ? _selectedPost : Forum.Posts.FirstOrDefault(value => value.Id == id);
        if (post is not null) _postContext = new(post, x, y, _selectedPost?.Id == id);
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task CloseForumPostContextFromLongPressAsync()
    {
        _postContext = null;
        return InvokeAsync(StateHasChanged);
    }

    private void ClosePostContextMenu() => _postContext = null;
    private bool CanEditPost(CommunityForumPostDto post) => post.Author.AccountId == CurrentAccountId || CanManageMessages;
    private async Task OpenContextPostAsync() { if (_postContext is { } context) await OpenPostAsync(context.Post); }
    private async Task MarkContextPostReadAsync()
    {
        if (_postContext is not { } context) return;
        await Session.MarkCommunityChannelReadAsync(Community.Id, context.Post.DiscussionChannelId);
        Forum.MarkRead(context.Post.Id);
    }
    private async Task ToggleContextPostLockedAsync() => await UpdateContextPostAsync(new(IsLocked: !_postContext!.Post.IsLocked));
    private async Task ToggleContextPostPinnedAsync() => await UpdateContextPostAsync(new(IsPinned: !_postContext!.Post.IsPinned));
    private async Task UpdateContextPostAsync(UpdateCommunityForumPostRequest request)
    {
        if (_postContext is not { } context || !CanManageMessages) return;
        var updated = await Forum.UpdateAsync(context.Post.Id, request);
        if (_selectedPost?.Id == updated.Id) _selectedPost = updated;
    }
    private async Task EditContextPostTitleAsync()
    {
        if (_postContext is not { } context || !CanEditPost(context.Post)) return;
        if (_selectedPost?.Id != context.Post.Id) await OpenPostAsync(context.Post);
        _titleDraft = _selectedPost!.Title;
        _editingTitle = true;
    }
    private async Task EditContextPostTagsAsync()
    {
        if (_postContext is not { } context || !CanEditPost(context.Post)) return;
        if (_selectedPost?.Id != context.Post.Id) await OpenPostAsync(context.Post);
        BeginEditTags();
    }
    private async Task EditContextPostDocumentAsync()
    {
        if (_postContext is not { } context || !CanEditDocument(context.Post)) return;
        if (_selectedPost?.Id != context.Post.Id) await OpenPostAsync(context.Post);
        BeginEditDocument();
    }
    private async Task RemoveContextPostDocumentAsync()
    {
        if (_postContext is not { } context || !CanEditDocument(context.Post)) return;
        if (_selectedPost?.Id != context.Post.Id) await OpenPostAsync(context.Post);
        BeginEditDocument();
        _confirmRemoveDocument = true;
    }
    private async Task OpenContextPostDocumentAsync()
    {
        if (_postContext?.Post is not { EmbedProvider: not null } post) return;
        var url = post.EmbedUrl;
        if (string.IsNullOrWhiteSpace(url))
        {
            try
            {
                post = await Session.GetForumPostAsync(Community.Id, Channel.Id, post.Id);
                url = post.EmbedUrl;
            }
            catch (Exception exception)
            {
                Logger.LogDebug(exception, "Could not load Forum post {PostId} document source.", post.Id);
                return;
            }
        }
        if (string.IsNullOrWhiteSpace(url)) return;
        await JS.InvokeVoidAsync("open", url, "_blank", "noopener,noreferrer");
    }
    private async Task DeleteContextPostAsync()
    {
        if (_postContext is not { } context || !CanEditPost(context.Post)) return;
        await Forum.DeleteAsync(context.Post.Id);
        if (_selectedPost?.Id == context.Post.Id) await BackToIndexAsync();
    }

    private async Task TogglePinnedAsync() { if (_selectedPost is not null) _selectedPost = await Forum.UpdateAsync(_selectedPost.Id, new(IsPinned: !_selectedPost.IsPinned)); }
    private async Task ToggleLockedAsync() { if (_selectedPost is not null) _selectedPost = await Forum.UpdateAsync(_selectedPost.Id, new(IsLocked: !_selectedPost.IsLocked)); }

    private async Task DeletePostAsync()
    {
        if (_selectedPost is null) return;
        if (!_confirmDelete) { _confirmDelete = true; return; }
        await Forum.DeleteAsync(_selectedPost.Id);
        _confirmDelete = false;
        await BackToIndexAsync();
    }

    private async Task EditTitleAsync()
    {
        if (_selectedPost is null) return;
        if (!_editingTitle) { _titleDraft = _selectedPost.Title; _editingTitle = true; return; }
        if (string.IsNullOrWhiteSpace(_titleDraft)) return;
        _selectedPost = await Forum.UpdateAsync(_selectedPost.Id, new(Title: _titleDraft));
        _titleDraft = _selectedPost.Title;
        _editingTitle = false;
        await OnPostOpenChanged.InvokeAsync(_selectedPost);
    }

    private void NewTagsChanged(IReadOnlyList<Guid> value) => _newTagIds = value;
    private void EditTagsChanged(IReadOnlyList<Guid> value) => _editTagIds = value;
    private void BeginEditTags()
    {
        if (_selectedPost is null) return;
        _editTagIds = (_selectedPost.Tags ?? []).Select(value => value.Id).ToArray();
        _editingTags = true;
    }
    private void CancelEditTags() { _editingTags = false; _editTagIds = []; }
    private async Task SaveEditedTagsAsync()
    {
        if (_selectedPost is null) return;
        _selectedPost = await Forum.UpdateTagsAsync(_selectedPost.Id, _editTagIds);
        _editingTags = false;
        _editTagIds = [];
        await OnPostOpenChanged.InvokeAsync(_selectedPost);
    }

    private bool HasPermission(CommunityPermission permission) =>
        (Channel.EffectivePermissions & (CommunityPermission.Administrator | permission)) != 0;
    private bool CanEditDocument(CommunityForumPostDto post) => post.EmbedProvider is not null
        ? CanManageMessages || (post.Author.AccountId == CurrentAccountId && CanAttachDocuments)
        : Channel.AllowDocumentEmbeds && (CanManageMessages ||
            post.Author.AccountId == CurrentAccountId && HasPermission(CommunityPermission.EmbedDocumentsInForumPosts));
    private void NewEmbedUrlChanged(ChangeEventArgs args) => _newEmbedUrl = args.Value?.ToString() ?? string.Empty;
    private void DocumentUrlChanged(ChangeEventArgs args) => _documentUrlDraft = args.Value?.ToString() ?? string.Empty;
    private void ClearNewDocument() { _newEmbedEnabled = false; _newEmbedUrl = string.Empty; }
    private void BeginEditDocument()
    {
        if (_selectedPost is null || !CanEditDocument(_selectedPost)) return;
        _documentUrlDraft = _selectedPost.EmbedUrl ?? string.Empty;
        _confirmRemoveDocument = false;
        _editingDocument = true;
    }
    private void CancelEditDocument()
    {
        _editingDocument = false;
        _confirmRemoveDocument = false;
        _documentUrlDraft = string.Empty;
    }
    private async Task SaveEditedDocumentAsync()
    {
        if (_selectedPost is null || !CanEditDocument(_selectedPost) || EditedEmbedContent is not { } detected)
        { _error = "Enter a valid Google Docs or Google Sheets URL."; return; }
        _selectedPost = await Forum.UpdateAsync(_selectedPost.Id,
            new(Embed: new(detected.Provider, detected.OpenUrl)));
        CancelEditDocument();
        await OnPostOpenChanged.InvokeAsync(_selectedPost);
    }
    private async Task RemoveDocumentAsync()
    {
        if (_selectedPost is null || !CanEditDocument(_selectedPost)) return;
        if (!_confirmRemoveDocument) { _confirmRemoveDocument = true; return; }
        _selectedPost = await Forum.UpdateAsync(_selectedPost.Id, new(Embed: new(null, null)));
        CancelEditDocument();
        await OnPostOpenChanged.InvokeAsync(_selectedPost);
    }

    private async Task PersistTitleDraftAsync(CancellationToken cancellationToken = default)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(_newTitle)) await Drafts.RemoveAsync(CreateTitleDraftScope, cancellationToken);
            else await Drafts.SaveAsync(CreateTitleDraftScope, _newTitle, cancellationToken);
        }
        catch (OperationCanceledException) { }
        catch (Exception exception) { Logger.LogDebug(exception, "Could not persist the new Forum post title draft."); }
    }

    public async ValueTask DisposeAsync()
    {
        Forum.Changed -= ForumChanged;
        _titleDraftDebounce?.Cancel();
        _titleDraftDebounce?.Dispose();
        _filterDebounce?.Cancel();
        _filterDebounce?.Dispose();
        _postLoadCancellation?.Cancel();
        _postLoadCancellation?.Dispose();
        if (Mode == ForumViewMode.CreatingPost) await PersistTitleDraftAsync();
        if (_selectedPost is not null) await OnPostOpenChanged.InvokeAsync(null);
        if (Mode != ForumViewMode.Index) await OnSubViewChanged.InvokeAsync(false);
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("unwireForumPostLongPress", _forumSurface);
            await _module.DisposeAsync();
        }
        _selfReference?.Dispose();
    }
}
