@using Iridium.Protocol
@using Iridium.Web.Models
@using System.Globalization
@inject NodeSession Session
@inject ChannelMessagingSession Messaging

<div class="profile-card-layer" @onclick="OnClose">
    <section class="profile-card" style="--profile-x:@CssPixel(X);--profile-y:@CssPixel(Y)" tabindex="-1"
             @onkeydown="ProfileKeyDown" @onclick="CloseTransientMenus" @onclick:stopPropagation="true">
        <button type="button" class="profile-more" title="Profile actions" @onclick="ToggleActionMenu" @onclick:stopPropagation="true"><Icon Name="more" /></button>
        @if (_actionMenuOpen)
        {
            <div class="profile-action-menu" @onclick:stopPropagation="true">
                <button @onclick="() => _actionMenuOpen = false">View Profile</button>
                @if (AccountId != CurrentAccountId)
                {
                    <div class="menu-separator"></div>
                    <button class="@(_blocked ? null : "destructive")" @onclick="ToggleBlockAsync">@(_blocked ? "Unblock" : "Block")</button>
                }
            </div>
        }
        <div class="profile-banner"><ProfileBanner AccountId="AccountId" /></div>
        @if (CanSwitchAvatar)
        {
            <button type="button" class="profile-avatar identity-switch" style="position:relative;z-index:1;padding:.3rem;box-shadow:0 0 0 1px var(--bg-sidebar)" aria-label="Choose Community Avatar"
                    aria-expanded="@_avatarPickerOpen" @onclick="ToggleAvatarPickerAsync" @onclick:stopPropagation="true">
                <ProfileAvatar AccountId="AccountId" DisplayName="@EffectiveDisplayName" Presence="@Presence"
                               Size="large" Surface="sidebar" AvatarPresetId="EffectiveAvatarPresetId" AvatarRevision="EffectiveAvatarRevision" />
            </button>
        }
        else
        {
            <div class="profile-avatar" style="position:relative;z-index:1;padding:.3rem;box-shadow:0 0 0 1px var(--bg-sidebar)"><ProfileAvatar AccountId="AccountId" DisplayName="@EffectiveDisplayName" Presence="@Presence"
                 Size="large" Surface="sidebar" AvatarPresetId="EffectiveAvatarPresetId" AvatarRevision="EffectiveAvatarRevision" /></div>
        }
        @if (_avatarPickerOpen && CanSwitchAvatar)
        {
            <div class="avatar-switcher" role="menu" aria-label="Community Avatars" @onclick:stopPropagation="true">
                <button role="menuitemradio" aria-checked="@(ActiveProfilePresetId is null)" @onclick="() => SelectAvatarAsync(null)">
                    <ProfileAvatar AccountId="AccountId" DisplayName="@AccountDisplayName" AvatarRevision="AccountAvatarRevision"
                                   BadgeMode="AvatarBadgeMode.None" Size="small" Surface="sidebar" />
                    <span>Default Profile</span>@if (ActiveProfilePresetId is null) { <Icon Name="check" /> }
                </button>
                @foreach (var preset in _avatarPresets)
                {
                    <button @key="preset.Id" role="menuitemradio" aria-checked="@(ActiveProfilePresetId == preset.Id)"
                            @onclick="() => SelectAvatarAsync(preset)">
                        <ProfileAvatar AccountId="AccountId" DisplayName="@preset.DisplayName" AvatarPresetId="preset.Avatar?.Id"
                                       AvatarRevision="@(preset.Avatar?.Revision ?? AccountAvatarRevision)"
                                       BadgeMode="AvatarBadgeMode.None" Size="small" Surface="sidebar" />
                        <span>@preset.DisplayName</span>@if (ActiveProfilePresetId == preset.Id) { <Icon Name="check" /> }
                    </button>
                }
                @if (_loadingAvatars) { <p>Loading Avatars…</p> }
                @if (!string.IsNullOrWhiteSpace(_avatarError)) { <p class="avatar-switch-error" role="alert">@_avatarError</p> }
            </div>
        }
        <div class="profile-content" @onclick="CloseRolePicker">
            @if (CanSwitchAvatar)
            {
                <button type="button" class="profile-display-name display-name" style="@NameStyle"
                        aria-label="Choose Community Avatar" aria-expanded="@_avatarPickerOpen"
                        @onclick="ToggleAvatarPickerAsync" @onclick:stopPropagation="true">@EffectiveDisplayName</button>
            }
            else
            {
                <h2 class="display-name" style="@NameStyle">@EffectiveDisplayName</h2>
            }
            <p class="identity">@IridiumIdentity.Format(Username, NodeAuthority)</p>
            @if (!string.IsNullOrWhiteSpace(Pronouns)) { <span class="pronouns">@Pronouns</span> }
            @if (!string.IsNullOrWhiteSpace(Description)) { <div class="bio"><ProfileBioContent Content="@Description" /></div> }
            @if (DisplayedRoles.Count > 0 || CanManageTargetRoles)
            {
                <div class="profile-roles" @onclick="CloseRolePicker" @onclick:stopPropagation="true">
                    <div class="role-chips">
                        @foreach (var role in DisplayedRoles)
                        {
                            <span class="role-chip" style="--role-color:@(role.Color ?? "var(--text-muted)")">
                                <span class="role-dot"></span><span class="role-name">@role.Name</span>
                                @if (CanManageRole(role))
                                {
                                    <button type="button" class="remove-role" title="Remove @role.Name"
                                            disabled="@_updatingRoles" @onclick="() => RemoveRoleAsync(role)"
                                            @onclick:stopPropagation="true">&times;</button>
                                }
                            </span>
                        }
                        @if (CanManageTargetRoles)
                        {
                            <button type="button" class="add-role" aria-label="Add Role" data-tooltip="Add Role"
                                    aria-expanded="@_rolePickerOpen" @onclick="ToggleRolePicker"
                                    @onclick:stopPropagation="true">+</button>
                        }
                    </div>
                    @if (_rolePickerOpen)
                    {
                        <CommunityRolePicker Roles="AssignableRoles" Busy="_updatingRoles"
                                             OnSelect="AddRoleAsync" OnClose="CloseRolePicker" />
                    }
                    @if (!string.IsNullOrWhiteSpace(_roleError))
                    {
                        <p class="role-error" role="status">@_roleError</p>
                    }
                </div>
            }
            <div class="profile-actions">
                @if (AccountId == CurrentAccountId)
                {
                    <button @onclick="OnEditProfile">Edit Profile</button>
                    @if (CanSwitchAvatar && OnEditAvatars.HasDelegate) { <button @onclick="OnEditAvatars">Edit Avatars</button> }
                }
                else
                {
                    <input class="quick-message" @bind="_quickMessage" @bind:event="oninput" @onkeydown="QuickMessageKeyDownAsync"
                           placeholder="@($"Message @{DisplayName}")" aria-label="Message @DisplayName" disabled="@_sendingMessage" />
                }
            </div>
        </div>
    </section>
</div>

@code {
    [Parameter, EditorRequired] public required Guid AccountId { get; set; }
    [Parameter] public Guid? AvatarPresetId { get; set; }
    [Parameter] public long AvatarRevision { get; set; }
    [Parameter, EditorRequired] public required Guid CurrentAccountId { get; set; }
    [Parameter, EditorRequired] public required string Username { get; set; }
    [Parameter, EditorRequired] public required string DisplayName { get; set; }
    [Parameter, EditorRequired] public required string NodeAuthority { get; set; }
    [Parameter] public string? Pronouns { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public PublicPresence Presence { get; set; }
    [Parameter] public IReadOnlyList<CommunityRoleDto> Roles { get; set; } = [];
    [Parameter] public CommunityManagementDto? CommunityContext { get; set; }
    [Parameter] public string? NameColor { get; set; }
    [Parameter] public double X { get; set; }
    [Parameter] public double Y { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnEditProfile { get; set; }
    [Parameter] public EventCallback OnEditAvatars { get; set; }
    [Parameter] public EventCallback OnCommunityProfileChanged { get; set; }
    [Parameter] public EventCallback<Guid> OnMessage { get; set; }
    [Parameter] public EventCallback<CommunityMemberRolesChange> OnMemberRolesChanged { get; set; }
    [Parameter] public bool IsBlocked { get; set; }
    private readonly HashSet<Guid> _assignedRoleIds = [];
    private bool _rolePickerOpen;
    private bool _updatingRoles;
    private string? _roleError;
    private bool _actionMenuOpen;
    private bool _blocked;
    private bool _sendingMessage;
    private bool _avatarPickerOpen;
    private bool _loadingAvatars;
    private string? _avatarError;
    private IReadOnlyList<UserProfilePresetDto> _avatarPresets = [];
    private Guid? _loadedAvatarCommunityId;
    private CommunityProfileAssignmentDto? _localAssignment;
    private string _quickMessage = string.Empty;
    private bool CanSwitchAvatar => AccountId == CurrentAccountId && CommunityContext is not null;
    private CommunityMemberDto? CurrentMember => CommunityContext?.Members.FirstOrDefault(member => member.AccountId == CurrentAccountId);
    private Guid? ActiveProfilePresetId => _localAssignment?.ProfilePresetId ?? CurrentMember?.ProfilePresetId;
    private string AccountDisplayName => Session.Account?.DisplayName ?? DisplayName;
    private long AccountAvatarRevision => Session.Account?.AvatarRevision ?? AvatarRevision;
    private string EffectiveDisplayName => _localAssignment?.DisplayName ?? DisplayName;
    private Guid? EffectiveAvatarPresetId => _localAssignment?.AvatarPresetId ?? AvatarPresetId;
    private long EffectiveAvatarRevision => _localAssignment?.AvatarRevision ?? AvatarRevision;
    private static string CssPixel(double value) =>
        double.IsFinite(value) ? value.ToString(CultureInfo.InvariantCulture) + "px" : "0px";
    private string? NameStyle
    {
        get
        {
            var color = CommunityContext is null
                ? NameColor
                : DisplayedRoles.FirstOrDefault(role => !string.IsNullOrWhiteSpace(role.Color))?.Color;
            return string.IsNullOrWhiteSpace(color) ? null : $"color:{color}";
        }
    }
    private CommunityMemberDto? TargetMember => CommunityContext?.Members.FirstOrDefault(member => member.AccountId == AccountId);
    private CommunityMemberDto? ActingMember => CommunityContext?.Members.FirstOrDefault(member => member.AccountId == CurrentAccountId);
    private int ActingHighestPosition => CommunityContext?.Access.IsOwner == true
        ? int.MaxValue
        : HighestPosition(ActingMember);
    private int TargetHighestPosition => HighestPosition(TargetMember);
    private bool CanManageTargetRoles => CommunityContext is { } context && OnMemberRolesChanged.HasDelegate &&
        context.Access.Has(CommunityPermission.ManageRoles) && TargetMember is not null &&
        (context.Access.IsOwner || !TargetMember.IsOwner && ActingHighestPosition > TargetHighestPosition);
    private IReadOnlyList<CommunityRoleDto> DisplayedRoles => AvailableRoles
        .Where(role => _assignedRoleIds.Contains(role.Id))
        .OrderByDescending(role => role.Position).ThenBy(role => role.Name, StringComparer.OrdinalIgnoreCase).ToArray();
    private IReadOnlyList<CommunityRoleDto> AssignableRoles => CanManageTargetRoles
        ? AvailableRoles.Where(role => !_assignedRoleIds.Contains(role.Id) && CanManageRole(role))
            .OrderByDescending(role => role.Position).ThenBy(role => role.Name, StringComparer.OrdinalIgnoreCase).ToArray()
        : [];
    private IReadOnlyList<CommunityRoleDto> AvailableRoles => CommunityContext?.Roles ?? Roles;

    protected override void OnParametersSet()
    {
        var communityId = CommunityContext?.Community.Id;
        if (_loadedAvatarCommunityId != communityId)
        {
            _loadedAvatarCommunityId = communityId;
            _avatarPresets = [];
            _avatarPickerOpen = false;
        }
        var ids = TargetMember?.RoleIds ?? Roles.Select(role => role.Id).ToArray();
        _assignedRoleIds.Clear();
        _assignedRoleIds.UnionWith(ids);
        _blocked = IsBlocked;
        if (_localAssignment is { } local && (CommunityContext?.Community.Id != local.CommunityId ||
            CurrentMember?.ProfilePresetId == local.ProfilePresetId)) _localAssignment = null;
        if (!CanManageTargetRoles) _rolePickerOpen = false;
    }

    private async Task ToggleAvatarPickerAsync()
    {
        if (!CanSwitchAvatar) return;
        _avatarPickerOpen = !_avatarPickerOpen;
        _actionMenuOpen = false;
        _rolePickerOpen = false;
        if (!_avatarPickerOpen || _avatarPresets.Count > 0 || _loadingAvatars) return;
        _loadingAvatars = true;
        _avatarError = null;
        try { _avatarPresets = await Session.GetProfilePresetsAsync(CommunityContext!.Community.Id); }
        catch { _avatarError = "Avatars could not be loaded."; }
        finally { _loadingAvatars = false; }
    }

    private async Task SelectAvatarAsync(UserProfilePresetDto? preset)
    {
        if (CommunityContext is null) return;
        _avatarError = null;
        try
        {
            _localAssignment = await Session.SetCommunityProfileAsync(CommunityContext.Community.Id, preset?.Id);
            _avatarPickerOpen = false;
            await OnCommunityProfileChanged.InvokeAsync();
        }
        catch { _avatarError = "The Community Avatar could not be changed."; }
    }

    private void CloseTransientMenus()
    {
        _avatarPickerOpen = false;
        _actionMenuOpen = false;
        CloseRolePicker();
    }

    private void ProfileKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseTransientMenus();
    }

    private void ToggleActionMenu() => _actionMenuOpen = !_actionMenuOpen;
    private async Task ToggleBlockAsync()
    {
        if (_blocked) await Session.UnblockAccountAsync(AccountId);
        else await Session.BlockAccountAsync(AccountId);
        _blocked = !_blocked;
        _actionMenuOpen = false;
    }
    private async Task QuickMessageKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key != "Enter" || args.ShiftKey || _sendingMessage || string.IsNullOrWhiteSpace(_quickMessage)) return;
        var content = _quickMessage.TrimEnd();
        _sendingMessage = true;
        try
        {
            var conversation = await Session.OpenDirectConversationAsync(AccountId);
            await Messaging.SendDirectToAsync(conversation.Id, content);
            _quickMessage = string.Empty;
            await OnMessage.InvokeAsync(AccountId);
        }
        finally { _sendingMessage = false; }
    }

    private int HighestPosition(CommunityMemberDto? member) => member is null ? -1 : AvailableRoles
        .Where(role => member.RoleIds.Contains(role.Id)).Select(role => role.Position).DefaultIfEmpty(-1).Max();
    private bool CanManageRole(CommunityRoleDto role) => CanManageTargetRoles && !role.IsDefault &&
        (CommunityContext!.Access.IsOwner || role.Position < ActingHighestPosition);
    private void ToggleRolePicker()
    {
        if (!CanManageTargetRoles) return;
        _roleError = null;
        _rolePickerOpen = !_rolePickerOpen;
    }
    private void CloseRolePicker() => _rolePickerOpen = false;
    private Task AddRoleAsync(CommunityRoleDto role) => ChangeRoleAsync(role, true);
    private Task RemoveRoleAsync(CommunityRoleDto role) => ChangeRoleAsync(role, false);
    private async Task ChangeRoleAsync(CommunityRoleDto role, bool assign)
    {
        if (_updatingRoles || !CanManageRole(role)) return;
        var updated = _assignedRoleIds.ToHashSet();
        if (assign) updated.Add(role.Id); else updated.Remove(role.Id);
        _updatingRoles = true;
        _roleError = null;
        try
        {
            await OnMemberRolesChanged.InvokeAsync(new CommunityMemberRolesChange(AccountId, updated.ToArray()));
            _assignedRoleIds.Clear();
            _assignedRoleIds.UnionWith(updated);
            _rolePickerOpen = false;
        }
        catch
        {
            _roleError = "The role could not be updated.";
        }
        finally
        {
            _updatingRoles = false;
        }
    }
}
