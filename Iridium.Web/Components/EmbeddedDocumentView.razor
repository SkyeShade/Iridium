@using Iridium.Protocol
@implements IAsyncDisposable
@inject ILogger<EmbeddedDocumentView> Logger
@inject IWebAssemblyHostEnvironment HostEnvironment
@inject IJSRuntime JS

<article @ref="_root" class="embedded-document" aria-label="Imported document">
    @foreach (var batch in _blockBatches)
    {
        <div @key="batch.StartBlock" class="document-render-batch">
            <EmbeddedDocumentBlockBatch Blocks="batch.Blocks" CommunityId="CommunityId" ChannelId="ChannelId"
                                        ForumPostId="ForumPostId" MessageId="MessageId" DocumentId="@DocumentId" />
        </div>
    }
    @if (_preparedBlockCount < _targetBlockCount)
    {
        <div class="document-render-progress" role="status">Rendering document… @_preparedBlockCount / @_targetBlockCount blocks</div>
    }
</article>

@code {
    [Parameter, EditorRequired] public required EmbeddedDocumentDto Document { get; set; }
    [Parameter, EditorRequired] public Guid CommunityId { get; set; }
    [Parameter, EditorRequired] public Guid ChannelId { get; set; }
    [Parameter] public Guid? ForumPostId { get; set; }
    [Parameter] public Guid? MessageId { get; set; }
    [Parameter] public string? DocumentId { get; set; }
    [Parameter] public bool LimitCollapsedPreview { get; set; }

    private const int LargeDocumentBlockThreshold = 150;
    private const int DocumentBlockBatchSize = 40;
    private const int CollapsedDocumentBlockLimit = 60;
    private readonly List<DocumentBlockBatchRenderModel> _blockBatches = [];
    private ElementReference _root;
    private IJSObjectReference? _module;
    private CancellationTokenSource? _renderCancellation;
    private EmbeddedDocumentDto? _loadedDocument;
    private DocumentHostIdentity _loadedHost;
    private int _targetBlockCount;
    private int _preparedBlockCount;
    private int _renderGeneration;
    private bool _renderRequested = true;
    private bool _firstBatchLogged;
    private bool _completedLogged;
    private long _stateAssignedAt;
    private long _stateChangeRequestedAt;
    private DocumentMetrics _metrics;

    protected override void OnParametersSet()
    {
        var host = new DocumentHostIdentity(CommunityId, ChannelId, ForumPostId, MessageId, DocumentId,
            LimitCollapsedPreview);
        if (ReferenceEquals(_loadedDocument, Document) && host == _loadedHost) return;
        _loadedDocument = Document;
        _loadedHost = host;
        ResetProgressiveRender();
    }

    protected override bool ShouldRender() => _renderRequested;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _renderRequested = false;
        var generation = _renderGeneration;
        var cancellation = _renderCancellation;
        if (cancellation is null) return;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/chat.js");
        await LogCommitAsync(generation, cancellation.Token);
        if (cancellation.IsCancellationRequested || generation != _renderGeneration ||
            _preparedBlockCount >= _targetBlockCount) return;
        try
        {
            await _module.InvokeAsync<double>("nextDocumentRenderFrame", cancellation.Token);
            if (cancellation.IsCancellationRequested || generation != _renderGeneration) return;
            PrepareNextBatch();
            _stateChangeRequestedAt = System.Diagnostics.Stopwatch.GetTimestamp();
            _renderRequested = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (JSDisconnectedException) { }
    }

    private void ResetProgressiveRender()
    {
        _renderCancellation?.Cancel();
        _renderCancellation?.Dispose();
        _renderCancellation = new();
        _renderGeneration++;
        _blockBatches.Clear();
        _preparedBlockCount = 0;
        _firstBatchLogged = false;
        _completedLogged = false;
        _stateAssignedAt = System.Diagnostics.Stopwatch.GetTimestamp();
        _metrics = CountMetrics(Document.Blocks);
        _targetBlockCount = LimitCollapsedPreview
            ? Math.Min(CollapsedDocumentBlockLimit, Document.Blocks.Count)
            : Document.Blocks.Count;
        PrepareNextBatch();
        _stateChangeRequestedAt = System.Diagnostics.Stopwatch.GetTimestamp();
        _renderRequested = true;
        if (HostEnvironment.IsDevelopment())
            Logger.LogInformation("Embedded Document DTO assigned Blocks={BlockCount} Spans={SpanCount} Images={ImageCount} CollapsedLimit={CollapsedLimit} StateAssignMs={StateAssignMs:F1}; StateHasChanged requested.",
                _metrics.Blocks, _metrics.Spans, _metrics.Images, LimitCollapsedPreview,
                System.Diagnostics.Stopwatch.GetElapsedTime(_stateAssignedAt).TotalMilliseconds);
    }

    private void PrepareNextBatch()
    {
        if (_preparedBlockCount >= _targetBlockCount) return;
        var remaining = _targetBlockCount - _preparedBlockCount;
        var batchSize = Document.Blocks.Count >= LargeDocumentBlockThreshold || LimitCollapsedPreview
            ? Math.Min(DocumentBlockBatchSize, remaining)
            : remaining;
        var blocks = new DocumentBlockRenderModel[batchSize];
        for (var offset = 0; offset < batchSize; offset++)
        {
            var index = _preparedBlockCount + offset;
            blocks[offset] = new($"{index}", Document.Blocks[index]);
        }
        _blockBatches.Add(new(_preparedBlockCount, blocks));
        _preparedBlockCount += batchSize;
    }

    private async Task LogCommitAsync(int generation, CancellationToken cancellationToken)
    {
        if (!HostEnvironment.IsDevelopment() || _module is null) return;
        var first = !_firstBatchLogged;
        var complete = _preparedBlockCount >= _targetBlockCount && !_completedLogged;
        if (!first && !complete) return;
        _firstBatchLogged = true;
        if (complete) _completedLogged = true;
        var razorCommit = System.Diagnostics.Stopwatch.GetElapsedTime(_stateChangeRequestedAt).TotalMilliseconds;
        try
        {
            await _module.InvokeAsync<double>("nextDocumentRenderFrame", cancellationToken);
            if (generation != _renderGeneration || cancellationToken.IsCancellationRequested) return;
            var browser = await _module.InvokeAsync<BrowserRenderMeasurement>("measureDocumentRender", cancellationToken, _root);
            Logger.LogInformation("Embedded Document render commit Phase={Phase} RenderedBlocks={RenderedBlocks} TotalBlocks={TotalBlocks} Spans={SpanCount} Images={ImageCount} RazorCommitMs={RazorCommitMs:F1} BrowserLayoutMs={BrowserLayoutMs:F1} TotalApplyMs={TotalApplyMs:F1} DomBlocks={DomBlocks}.",
                complete ? "complete" : "first", _preparedBlockCount, _metrics.Blocks, _metrics.Spans,
                _metrics.Images, razorCommit, browser.LayoutDurationMs,
                System.Diagnostics.Stopwatch.GetElapsedTime(_stateAssignedAt).TotalMilliseconds, browser.DomBlocks);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (JSDisconnectedException) { }
    }

    private static DocumentMetrics CountMetrics(IReadOnlyList<EmbeddedDocumentBlockDto> blocks)
    {
        var metrics = new DocumentMetrics();
        foreach (var block in blocks) CountBlock(block, ref metrics);
        return metrics;
    }

    private static void CountBlock(EmbeddedDocumentBlockDto block, ref DocumentMetrics metrics)
    {
        metrics.Blocks++;
        switch (block)
        {
            case EmbeddedDocumentParagraphDto paragraph:
                metrics.Spans += CountInlines(paragraph.Content);
                break;
            case EmbeddedDocumentHeadingDto heading:
                metrics.Spans += CountInlines(heading.Content);
                break;
            case EmbeddedDocumentImageDto:
                metrics.Images++;
                break;
            case EmbeddedDocumentListDto list:
                foreach (var child in list.Items.SelectMany(item => item.Blocks)) CountBlock(child, ref metrics);
                break;
            case EmbeddedDocumentTableDto table:
                foreach (var child in table.Rows.SelectMany(row => row.Cells).SelectMany(cell => cell.Blocks))
                    CountBlock(child, ref metrics);
                break;
        }
    }

    private static int CountInlines(IReadOnlyList<EmbeddedDocumentInlineDto> values) => values.Sum(value =>
        value is EmbeddedDocumentLinkDto link ? 1 + CountInlines(link.Content) : 1);

    public async ValueTask DisposeAsync()
    {
        _renderCancellation?.Cancel();
        _renderCancellation?.Dispose();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }

    public sealed record DocumentBlockRenderModel(string Key, EmbeddedDocumentBlockDto Block);
    private sealed record DocumentBlockBatchRenderModel(int StartBlock,
        IReadOnlyList<DocumentBlockRenderModel> Blocks);
    private readonly record struct DocumentHostIdentity(Guid CommunityId, Guid ChannelId, Guid? ForumPostId,
        Guid? MessageId, string? DocumentId, bool LimitCollapsedPreview);
    private struct DocumentMetrics { public int Blocks; public int Spans; public int Images; }
    private sealed record BrowserRenderMeasurement(double LayoutDurationMs, int DomRows, int DomCells,
        int DomBlocks, double Width, double Height);
}
