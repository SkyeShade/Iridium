@using Iridium.Protocol
@using Iridium.Web.Models
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<MessageRow> Logger
@inject IIdentityProfileResolver ProfileResolver
@inject Iridium.Web.Services.MessageMenuCoordinator MessageMenus
@inject CommunityEmojiService Emojis
@inject ExternalEmbedResolver ExternalEmbeds
@inject ModifierKeyStateService ModifierKeys

<article class="message-row @(StartsGroup ? "group-start" : "compact") @(Message.IsDeleted ? "deleted" : null) @(MentionsCurrentAccount ? "mentions-current-account" : null) @DeliveryClass"
         data-message-id="@Message.Id" @onpointerenter="MessageEntered" @onpointerleave="MessageLeft">
    @if (Message.ReplyTo is { } reply)
    {
        <div class="reply-reference">
            <button type="button" class="reply-focus" title="Go to replied message"
                    aria-label="Go to message from @reply.AuthorDisplayName" @onclick="() => OnFocusReply.InvokeAsync(reply.MessageId)">
                <ProfileAvatar AccountId="reply.AuthorAccountId" DisplayName="@reply.AuthorDisplayName"
                               AvatarPresetId="reply.AvatarPresetId" AvatarRevision="reply.AvatarRevision"
                               AvatarSnapshotMessageId="reply.AvatarSnapshotMessageId"
                               BadgeMode="AvatarBadgeMode.None" Size="tiny" Surface="base" />
                @if (reply.IsDeleted) { <span class="reply-deleted">Deleted message</span> }
                else {
                <strong class="display-name" style="@ReplyAuthorStyle(reply.AuthorAccountId)">@reply.AuthorDisplayName</strong>
                }
            </button>
            @if (!reply.IsDeleted)
            {
                <div class="reply-excerpt" aria-hidden="true">
                    @if (ReplySummary(reply) is { } summary) { <span>@summary</span> }
                    else { <MentionedMessageContent Content="@(reply.Excerpt ?? string.Empty)"
                        CommunityId="@(Message.CommunityId == Guid.Empty ? null : Message.CommunityId)" Compact="true" /> }
                </div>
            }
        </div>
    }
    @if (StartsGroup)
    {
        <button type="button" class="message-avatar author-trigger" @onclick="OpenAuthorProfileAsync" @oncontextmenu="OpenAuthorContext" @oncontextmenu:preventDefault="true" title="View @Message.Author.DisplayName's profile">
            <ProfileAvatar AccountId="Message.Author.AccountId" DisplayName="@Message.Author.DisplayName" Presence="@(AuthorPresence ?? PublicPresence.Offline)"
                           AvatarPresetId="Message.Author.AvatarPresetId" AvatarRevision="Message.Author.AvatarRevision"
                           AvatarSnapshotMessageId="Message.Author.AvatarSnapshotMessageId"
                           BadgeMode="@(ShowAuthorPresence && AuthorPresence.HasValue ? AvatarBadgeMode.Presence : AvatarBadgeMode.None)" Size="medium" Surface="base" />
        </button>
    }

    <div class="message-body">
        @if (StartsGroup)
        {
            <header><button type="button" class="author-name display-name" style="@AuthorStyle" @onclick="OpenAuthorProfileAsync" @oncontextmenu="OpenAuthorContext" @oncontextmenu:preventDefault="true">@Message.Author.DisplayName</button><time title="@Message.CreatedAt.ToLocalTime().ToString("F")">@Message.CreatedAt.ToLocalTime().ToString("HH:mm")</time></header>
        }
        <div class="message-content">
            @if (_editing)
            {
                <MarkdownSourceEditor Value="@_editContent" References="_editEmojiReferences"
                                      StandardReferences="_editStandardEmojiReferences" Available="_editAvailableEmojis"
                                      InitialTokens="_editEmojiTokens" DocumentChanged="EditDocumentChanged"
                                      AllowCustomEmojiCompletion="true"
                                      Class="edit-markdown-source" AriaLabel="Edit message"
                                      Autofocus="true" SubmitOnEnter="true" MaxLength="4000"
                                      OnSubmit="SaveEditAsync" OnCancel="CancelEditAsync" />
                <div class="edit-help">
                    <span>escape to </span><button type="button" @onclick="CancelEdit">cancel</button>
                    <span class="separator">•</span><span>enter to </span>
                    <button type="button" disabled="@(_savingEdit || (Message.Forwarded is null && string.IsNullOrWhiteSpace(_editContent)))" @onclick="SaveEditAsync">save</button>
                </div>
            }
            else
            {
                <MentionedMessageContent Content="@Message.Content" Mentions="Message.Mentions"
                                         CommunityId="@(Message.CommunityId == Guid.Empty ? null : Message.CommunityId)" OnProfile="OpenMentionProfileAsync" />
                @if (Message.EditedAt is not null) { <span class="edited" title="Edited @Message.EditedAt.Value.ToLocalTime().ToString("g")">(edited)</span> }
                <InviteEmbed Content="@Message.Content" />
                <MessageExternalEmbeds Content="@Message.Content" />
                @if (Message.Forwarded is { } forwarded)
                {
                    <ForwardedMessageBlock Snapshot="forwarded" OnOpenSource="OnOpenForwardSource" />
                }
                <MessageAttachments Attachments="Message.Attachments" DeliveryState="Message.DeliveryState" />
            }
            @if (Message.DeliveryState == MessageDeliveryState.Failed)
            {
                <div class="delivery-failure"><span>@(Message.DeliveryError ?? "Failed to send")</span>
                    @if (Message.CanRetry && Message.ClientMessageId is { } retryId)
                    {
                        <span>&middot;</span><button type="button" @onclick="() => OnRetryLocal.InvokeAsync(retryId)">Retry</button>
                    }
                    @if (Message.ClientMessageId is { } removeId)
                    {
                        <span>&middot;</span><button type="button" @onclick="() => OnRemoveLocal.InvokeAsync(removeId)">Remove</button>
                    }
                </div>
            }
        </div>
    </div>

    @if (Message.DeliveryState == MessageDeliveryState.Confirmed && !Message.IsDeleted && !_editing)
    {
        <div class="message-actions @(ModifierKeys.ShiftPressed && _messageHovered ? "expanded" : null)">
            <button title="Reply" @onclick="ReplyAsync" @onclick:stopPropagation="true"><Icon Name="reply" /></button>
            @if (CanEdit) { <button title="Edit" @onclick="BeginEdit" @onclick:stopPropagation="true"><Icon Name="edit" /></button> }
            @if (CanDelete) { <button class="shift-action destructive" title="Delete Message" @onclick="DeleteAsync" @onclick:stopPropagation="true"><Icon Name="trash" /></button> }
            <button title="More actions" @onclick="ToggleMenu" @onclick:stopPropagation="true"><Icon Name="more" /></button>
        </div>
        @if (_menuOpen)
        {
            <div class="message-menu" @onpointerenter="MenuEntered" @onpointerleave="MenuLeft" @onclick:stopPropagation="true">
                <button @onclick="ReplyFromMenuAsync"><Icon Name="reply" /> Reply</button>
                <button @onclick="ForwardFromMenu"><Icon Name="forward" /> Forward</button>
                @if (CanEdit) { <button @onclick="EditFromMenu"><Icon Name="edit" /> Edit</button> }
                @if (CanDelete) { <button class="destructive" @onclick="DeleteAsync"><Icon Name="trash" /> Delete Message</button> }
            </div>
        }
    }
</article>
@if (_forwardOpen)
{
    <ForwardMessageModal Source="ForwardSource" OnClose="CloseForward" />
}
@if (_profile is { } profile)
{
    <AnchoredProfileCard AccountId="profile.AccountId" CurrentAccountId="CurrentAccountId" Username="@profile.Username"
        DisplayName="@(CurrentCommunityAuthor?.DisplayName ?? profile.DisplayName)" Pronouns="@profile.Pronouns" Description="@profile.Description" Presence="profile.Presence"
        AvatarPresetId="CurrentCommunityAuthor?.AvatarPresetId" AvatarRevision="@(CurrentCommunityAuthor?.AvatarRevision ?? 0)"
        ActiveChatDisplayName="CurrentCommunityAuthor?.ActiveChatDisplayName"
        ActiveChatAvatarPresetId="CurrentCommunityAuthor?.ActiveChatAvatarPresetId"
        ActiveChatAvatarRevision="@(CurrentCommunityAuthor?.ActiveChatAvatarRevision ?? 0)"
        NodeAuthority="@NodeAuthority" Roles="_profileRoles" CommunityContext="CommunityManagement"
        NameColor="@_profileColor" X="_profileX" Y="_profileY"
        OnClose="CloseProfile" OnEditProfile="OnEditProfile" OnEditAvatars="OnEditAvatars"
        OnCommunityProfileChanged="OnCommunityProfileChanged" OnMessage="OnMessage"
        IsBlocked="profile.IsBlockedByCurrentAccount"
        OnMemberRolesChanged="OnMemberRolesChanged" />
}
@if (_contextMember is { } contextMember && CommunityManagement is { } contextManagement)
{
    <CommunityMemberContextMenu Management="contextManagement" Target="contextMember" CurrentAccountId="CurrentAccountId"
                                X="_contextX" Y="_contextY" OnProfile="OpenContextProfileAsync"
                                OnMessage="OnMessage" OnMention="OnMention" OnClose="CloseAuthorContext" />
}

@code {
    [Parameter, EditorRequired] public required ChannelMessageDto Message { get; set; }
    [Parameter] public bool StartsGroup { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanDelete { get; set; }
    [Parameter, EditorRequired] public required Guid CurrentAccountId { get; set; }
    [Parameter, EditorRequired] public required string NodeAuthority { get; set; }
    [Parameter] public CommunityManagementDto? CommunityManagement { get; set; }
    [Parameter] public PublicPresence? AuthorPresence { get; set; }
    [Parameter] public bool ShowAuthorPresence { get; set; }
    [Parameter] public EventCallback OnEditProfile { get; set; }
    [Parameter] public EventCallback OnEditAvatars { get; set; }
    [Parameter] public EventCallback OnCommunityProfileChanged { get; set; }
    [Parameter] public EventCallback<Guid> OnMessage { get; set; }
    [Parameter] public EventCallback<CommunityMemberRolesChange> OnMemberRolesChanged { get; set; }
    [Parameter] public EventCallback<CommunityMemberDto> OnMention { get; set; }
    [Parameter] public EventCallback<ChannelMessageDto> OnReply { get; set; }
    [Parameter, EditorRequired] public required Func<MessageEditSubmission, Task<bool>> Edit { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
    [Parameter] public EventCallback<Guid> OnRetryLocal { get; set; }
    [Parameter] public EventCallback<Guid> OnRemoveLocal { get; set; }
    [Parameter] public EventCallback<Guid> OnFocusReply { get; set; }
    [Parameter] public EventCallback<ForwardSourceReferenceDto> OnOpenForwardSource { get; set; }
    [Parameter] public long EditRequest { get; set; }
    [Parameter] public EventCallback<bool> OnEditingChanged { get; set; }
    [Parameter] public EventCallback OnEditCompleted { get; set; }
    private bool _menuOpen => MessageMenus.OpenMessageId == Message.Id;
    private bool _messageHovered;
    private bool _menuHovered;
    private CancellationTokenSource? _menuClose;
    private bool _editing;
    private bool _savingEdit;
    private bool _forwardOpen;
    private string _editContent = string.Empty;
    private IJSObjectReference? _module;
    private ResolvedProfileDto? _profile;
    private double _profileX;
    private double _profileY;
    private IReadOnlyList<CommunityRoleDto> _profileRoles = [];
    private string? _profileColor;
    private CommunityMemberDto? _contextMember;
    private double _contextX;
    private double _contextY;
    private IReadOnlyList<CommunityRoleDto> AuthorRoles => CommunityManagement?.Members
        .FirstOrDefault(value => value.AccountId == Message.Author.AccountId) is { } member
        ? CommunityManagement.Roles.Where(value => member.RoleIds.Contains(value.Id)).OrderByDescending(value => value.Position).ToArray()
        : [];
    private CommunityMemberDto? CurrentCommunityAuthor => CommunityManagement?.Members
        .FirstOrDefault(value => value.AccountId == Message.Author.AccountId);
    private string? AuthorColor => CommunityManagement?.Members
        .FirstOrDefault(value => value.AccountId == Message.Author.AccountId) is { } member
        ? CommunityRolePresentation.MemberColor(member, CommunityManagement.Roles)
        : null;
    private string? AuthorStyle => AuthorColor is null ? null : $"color:{AuthorColor}";
    private string? DeliveryClass => Message.DeliveryState switch
    {
        MessageDeliveryState.Pending => "pending",
        MessageDeliveryState.Failed => "failed",
        _ => null
    };
    private bool MentionsCurrentAccount => CommunityMentionPresentation.IsTargetedAt(Message, CurrentAccountId, CommunityManagement);

    private string? ReplyAuthorStyle(Guid accountId)
    {
        if (CommunityManagement?.Members.FirstOrDefault(value => value.AccountId == accountId) is not { } member)
            return null;
        var color = CommunityRolePresentation.MemberColor(member, CommunityManagement.Roles);
        return color is null ? null : $"color:{color}";
    }
    private string? ReplySummary(MessageReplyDto reply)
    {
        if (!string.IsNullOrWhiteSpace(reply.AttachmentSummary) && string.IsNullOrWhiteSpace(reply.Excerpt))
            return reply.AttachmentSummary;
        return ExternalEmbeds.Resolve(reply.Excerpt ?? string.Empty, 1).Count > 0 ? "YouTube video" : null;
    }
    private Task ReplyAsync() => OnReply.InvokeAsync(Message);
    private Task ReplyFromMenuAsync() { MessageMenus.Close(Message.Id); return ReplyAsync(); }
    private void ForwardFromMenu() { MessageMenus.Close(Message.Id); _forwardOpen = true; }
    private void CloseForward() => _forwardOpen = false;
    private ForwardMessageSourceDto ForwardSource => Message.CommunityId == Guid.Empty
        ? new(MessageLocationKind.DirectConversation, Message.Id, ConversationId: Message.ChannelId)
        : new(MessageLocationKind.CommunityChannel, Message.Id, Message.CommunityId, Message.ChannelId);
    private void ToggleMenu() { CancelMenuClose(); MessageMenus.Toggle(Message.Id); }
    private readonly List<CommunityEmojiDraftReference> _editEmojiReferences = [];
    private readonly List<StandardEmojiDraftReference> _editStandardEmojiReferences = [];
    private readonly List<ComposerEmojiToken> _editEmojiTokens = [];
    private IReadOnlyList<AvailableCommunityEmoji> _editAvailableEmojis = [];
    private async Task BeginEdit()
    {
        MessageMenus.Close(Message.Id);
        _editAvailableEmojis = await Emojis.GetAvailableAsync();
        var draft = CommunityEmojiDraftCodec.Deserialize(Message.Content, _editAvailableEmojis);
        _editEmojiReferences.Clear(); _editStandardEmojiReferences.Clear(); _editEmojiTokens.Clear();
        var source = new System.Text.StringBuilder(draft.Text.Length);
        var position = 0;
        foreach (var reference in draft.References.OrderBy(value => value.Start))
        {
            source.Append(draft.Text, position, reference.Start - position);
            var start = source.Length;
            source.Append(CommunityEmojiDraftCodec.ObjectReplacementCharacter);
            var available = _editAvailableEmojis.First(value => value.Emoji.Id == reference.EmojiId);
            var mediaUrl = await Emojis.GetMediaDataUrlAsync(available.Emoji);
            _editEmojiReferences.Add(reference with { Start = start, Length = 1 });
            _editEmojiTokens.Add(new(start, reference.EmojiId, reference.Name, reference.CommunityId, mediaUrl,
                Math.Max(1, available.Emoji.Width), Math.Max(1, available.Emoji.Height)));
            position = reference.Start + reference.Length;
        }
        source.Append(draft.Text, position, draft.Text.Length - position);
        _editContent = source.ToString();
        _editing = true;
        await OnEditingChanged.InvokeAsync(true);
    }
    private Task EditFromMenu() => BeginEdit();
    private async Task CancelEditAsync()
    {
        _editing = false; _editContent = string.Empty; _editEmojiReferences.Clear();
        _editStandardEmojiReferences.Clear(); _editEmojiTokens.Clear();
        await OnEditingChanged.InvokeAsync(false);
        await OnEditCompleted.InvokeAsync();
    }
    private void CancelEdit() => _ = CancelEditAsync();
    private void EditDocumentChanged(ComposerDocumentSnapshot snapshot)
    {
        _editContent = snapshot.Content ?? string.Empty;
        _editEmojiReferences.Clear();
        _editEmojiReferences.AddRange(snapshot.Tokens.Where(value => value.EmojiId is not null && value.CommunityId is not null)
            .Select(value => new CommunityEmojiDraftReference(value.Start, 1, value.EmojiId!.Value, value.Name,
                value.CommunityId!.Value)));
        _editStandardEmojiReferences.Clear();
        _editStandardEmojiReferences.AddRange(snapshot.Tokens.Where(value => value.StandardArtworkKey is not null && value.Glyph is not null)
            .Select(value => new StandardEmojiDraftReference(value.Start, 1, value.StandardArtworkKey!, value.Glyph!, value.Name)));
    }

    private async Task SaveEditAsync()
    {
        if (_savingEdit || (Message.Forwarded is null && string.IsNullOrWhiteSpace(_editContent))) return;
        var content = CommunityEmojiDraftCodec.SerializeDocument(_editContent.TrimEnd(), _editEmojiReferences,
            _editStandardEmojiReferences);
        if (string.Equals(content, Message.Content, StringComparison.Ordinal))
        {
            await CancelEditAsync();
            await InvokeAsync(StateHasChanged);
            return;
        }

        _savingEdit = true;
        try
        {
            if (await Edit(new MessageEditSubmission(Message.Id, content)))
            {
                _editing = false;
                _editContent = string.Empty;
                await OnEditingChanged.InvokeAsync(false);
                await OnEditCompleted.InvokeAsync();
            }
        }
        finally
        {
            _savingEdit = false;
            await InvokeAsync(StateHasChanged);
        }
    }
    private Task DeleteAsync() { MessageMenus.Close(Message.Id); return OnDelete.InvokeAsync(Message.Id); }

    private long _consumedEditRequest;
    protected override void OnInitialized()
    {
        MessageMenus.Changed += MenuChanged;
        ModifierKeys.Changed += ModifierChanged;
    }
    protected override async Task OnParametersSetAsync()
    {
        if (EditRequest <= _consumedEditRequest || !CanEdit || _editing) return;
        _consumedEditRequest = EditRequest;
        await BeginEdit();
    }
    private void MenuChanged() => _ = InvokeAsync(StateHasChanged);
    private void ModifierChanged() => _ = InvokeAsync(StateHasChanged);
    private void MessageEntered() { _messageHovered = true; CancelMenuClose(); }
    private void MessageLeft() { _messageHovered = false; ScheduleMenuClose(); }
    private void MenuEntered() { _menuHovered = true; CancelMenuClose(); }
    private void MenuLeft() { _menuHovered = false; ScheduleMenuClose(); }
    private void CancelMenuClose() { _menuClose?.Cancel(); _menuClose?.Dispose(); _menuClose = null; }
    private void ScheduleMenuClose()
    {
        CancelMenuClose();
        if (!_menuOpen || _messageHovered || _menuHovered) return;
        var source = _menuClose = new CancellationTokenSource();
        _ = CloseMenuAfterDelayAsync(source);
    }
    private async Task CloseMenuAfterDelayAsync(CancellationTokenSource source)
    {
        try
        {
            await Task.Delay(150, source.Token);
            if (!_messageHovered && !_menuHovered) MessageMenus.Close(Message.Id);
        }
        catch (OperationCanceledException) { }
    }
    private async Task OpenAuthorProfileAsync(MouseEventArgs args)
    {
        ClearProfile();
        var position = await ProfilePositionAsync(args);
        var result = await ProfileResolver.ResolveAsync(IridiumIdentity.Format(Message.Author.Username, NodeAuthority));
        if (result.Profile is null) return;
        _profile = result.Profile with { DisplayName = CurrentCommunityAuthor?.DisplayName ?? result.Profile.DisplayName };
        _profileRoles = AuthorRoles;
        _profileColor = AuthorColor;
        _profileX = position.X;
        _profileY = position.Y;
    }
    private async Task OpenMentionProfileAsync(MentionProfileClick click)
    {
        ClearProfile();
        var position = await ProfilePositionAsync(click.Pointer);
        var member = CommunityManagement?.Members.FirstOrDefault(value => value.AccountId == click.AccountId);
        if (member is null) return;
        var result = await ProfileResolver.ResolveAsync(IridiumIdentity.Format(member.Username, NodeAuthority));
        if (result.Profile is null) return;
        _profile = result.Profile with { DisplayName = member.DisplayName };
        _profileRoles = CommunityManagement!.Roles.Where(value => member.RoleIds.Contains(value.Id))
            .OrderByDescending(value => value.Position).ToArray();
        _profileColor = _profileRoles.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value.Color))?.Color;
        _profileX = position.X;
        _profileY = position.Y;
    }
    private void OpenAuthorContext(MouseEventArgs args)
    {
        if (CommunityManagement?.Members.FirstOrDefault(value => value.AccountId == Message.Author.AccountId) is not { } member) return;
        _contextMember = member; _contextX = args.ClientX; _contextY = args.ClientY;
    }
    private void CloseAuthorContext() => _contextMember = null;
    private async Task OpenContextProfileAsync()
    {
        if (_contextMember is null) return;
        await OpenAuthorProfileAsync(new MouseEventArgs { ClientX = _contextX, ClientY = _contextY });
    }
    private async Task<ProfileCardPosition> ProfilePositionAsync(MouseEventArgs args)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/chat.js");
        return await _module.InvokeAsync<ProfileCardPosition>("profileCardPosition", args.ClientX, args.ClientY, "chat");
    }
    private void CloseProfile() => ClearProfile();
    private void ClearProfile()
    {
        _profile = null;
        _profileRoles = [];
        _profileColor = null;
    }

    public async ValueTask DisposeAsync()
    {
        MessageMenus.Changed -= MenuChanged;
        ModifierKeys.Changed -= ModifierChanged;
        MessageMenus.Close(Message.Id);
        CancelMenuClose();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
