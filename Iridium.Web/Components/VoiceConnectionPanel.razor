@using Iridium.Client.Core
@using Iridium.Protocol
@implements IDisposable
@inject ActiveVoiceSessionCoordinator Voice
@inject BrowserScreenShareCapability ScreenShareCapability
@inject LocalVoicePreferenceService Preferences
@inject ILogger<VoiceConnectionPanel> Logger

@if (Voice.Current is { } session)
{
    <section class="voice-connection-panel @StatusClass(session)" aria-label="Active voice connection">
        <div class="voice-connection-header">
            <span class="voice-signal" aria-hidden="true"><Icon Name="signal" Size="16" /></span>
            <div class="voice-connection-copy">
                <strong>@Status(session)</strong>
                <span title="@PrimaryLabel(session)">@PrimaryLabel(session)</span>
            </div>
            <button class="voice-icon-button @(EnhancedNoiseSuppression ? "active" : null)"
                    title="@(EnhancedNoiseSuppression ? "Enhanced noise suppression is on" : "Enhanced noise suppression is off")"
                    aria-label="Enhanced noise suppression" aria-pressed="@EnhancedNoiseSuppression"
                    @onclick="ToggleNoiseSuppressionAsync"><Icon Name="waveform" Size="20" /></button>
            <button class="voice-icon-button disconnect" title="Disconnect" aria-label="Disconnect" @onclick="DisconnectAsync"><Icon Name="hangup" Size="20" /></button>
        </div>
        <div class="voice-media-actions">
            @* The user panel carries mute and deafen on desktop; phones only have this panel. *@
            <button class="mobile-only @(session.Muted ? "danger" : null)" title="@(Voice.PreferredMuted ? "Unmute" : "Mute")"
                    aria-label="@(Voice.PreferredMuted ? "Unmute" : "Mute")" @onclick="ToggleMuteAsync"><Icon Name="microphone" Size="20" /></button>
            <button class="mobile-only @(session.Deafened ? "danger" : null)" title="@(Voice.PreferredDeafened ? "Undeafen" : "Deafen")"
                    aria-label="@(Voice.PreferredDeafened ? "Undeafen" : "Deafen")" @onclick="ToggleDeafenAsync"><Icon Name="headphones" Size="20" /></button>
            @if (LocalScreenShare is null && session.CanPublishMedia && ScreenShareCapability.IsSupported)
            {
                <button title="Share your screen. Audio availability depends on the selected source and browser."
                        aria-label="Share screen" @onclick="StartScreenShareAsync"><Icon Name="screen-share" Size="20" /></button>
            }
            else if (LocalScreenShare is not null)
            {
                <button class="sharing" title="Stop sharing your screen" aria-label="Stop sharing screen"
                        aria-pressed="true" @onclick="StopScreenShareAsync"><Icon Name="screen-share" Size="20" /></button>
                <button title="Switch the shared screen or window" aria-label="Switch shared source"
                        @onclick="SwitchScreenShareAsync"><Icon Name="refresh" Size="20" /></button>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(_streamError)) { <small class="stream-error">@_streamError</small> }
    </section>
}

@code {
    protected override void OnInitialized()
    {
        Voice.Changed += OnChanged;
        Preferences.Changed += OnChanged;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await ScreenShareCapability.DetectAsync();
        await InvokeAsync(StateHasChanged);
    }
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
    private Task ToggleMuteAsync() => Voice.ToggleMuteAsync();
    private Task ToggleDeafenAsync() => Voice.ToggleDeafenAsync();
    private Task DisconnectAsync() => Voice.LeaveCurrentVoiceSessionAsync("voice connection panel disconnect");
    private PublishedVoiceStreamDto? LocalScreenShare => Voice.PublishedStreams.FirstOrDefault(value =>
        value.OwnerAccountId == Voice.LocalAccountId && value.Kind == VoicePublishedStreamKind.ScreenShare);
    private string? _streamError;
    private async Task StartScreenShareAsync()
    {
        try { _streamError = null; await Voice.StartScreenShareAsync(); }
        catch (Exception exception)
        {
            Logger.LogDebug(exception, "Screen sharing could not be started");
            _streamError = ScreenShareFailure.UserMessage(exception);
        }
    }
    private async Task StopScreenShareAsync()
    {
        try { _streamError = null; await Voice.StopScreenShareAsync(); }
        catch (Exception exception) { _streamError = exception.Message; }
    }
    private async Task SwitchScreenShareAsync()
    {
        try { _streamError = null; await Voice.SwitchScreenShareAsync(); }
        catch (Exception exception)
        {
            Logger.LogDebug(exception, "Screen share source could not be switched");
            _streamError = ScreenShareFailure.UserMessage(exception);
        }
    }
    private bool EnhancedNoiseSuppression => Preferences.NoiseSuppression == NoiseSuppressionMode.Enhanced;
    // Like Discord's Krisp toggle: on is Enhanced, off falls back to the browser's Standard suppression.
    private Task ToggleNoiseSuppressionAsync() => Preferences.SetNoiseSuppressionAsync(
        EnhancedNoiseSuppression ? NoiseSuppressionMode.Standard : NoiseSuppressionMode.Enhanced);
    private static string Status(ActiveVoiceSession session) => session.ConnectionState switch
    {
        CallConnectionState.Connected => "Voice Connected",
        CallConnectionState.Connecting => "Connecting",
        CallConnectionState.Failed => "Media connection failed",
        _ when session.Kind == ActiveVoiceSessionKind.CommunityVoiceChannel => "Media unavailable",
        _ => "Connecting"
    };
    private static string StatusClass(ActiveVoiceSession session) => session.ConnectionState switch
    {
        CallConnectionState.Connected => "connected",
        CallConnectionState.Failed => "failed",
        _ => "connecting"
    };
    private string PrimaryLabel(ActiveVoiceSession session) => session.Kind switch
    {
        ActiveVoiceSessionKind.DirectCall => $"{session.DisplayName} / Direct Call",
        _ => $"{session.DisplayName} / {Voice.CommunityVoice.CurrentRoom?.CommunityName ?? "Server"}"
    };
    public void Dispose()
    {
        Voice.Changed -= OnChanged;
        Preferences.Changed -= OnChanged;
    }
}
