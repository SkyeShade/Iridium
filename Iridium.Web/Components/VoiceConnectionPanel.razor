@using Iridium.Client.Core
@using Iridium.Protocol
@implements IDisposable
@inject ActiveVoiceSessionCoordinator Voice

@if (Voice.Current is { } session)
{
    <section class="voice-connection-panel" aria-label="Active voice connection">
        <div class="voice-connection-copy">
            <strong><span class="connection-dot"></span>@Status(session)</strong>
            <span>@PrimaryLabel(session)</span>
            @if (LocalScreenShare is not null) { <small class="sharing-status"><Icon Name="screen" /> Sharing screen</small> }
            @if (session.StartedAt is { } startedAt) { <VoiceElapsedTimer StartedAt="startedAt" /> }
        </div>
        <div class="voice-controls">
            @if (LocalScreenShare is null)
            {
                <button title="Share screen" @onclick="StartScreenShareAsync"><Icon Name="screen" /></button>
            }
            else
            {
                <button class="streaming" title="Stop sharing screen" @onclick="StopScreenShareAsync"><Icon Name="screen" /></button>
            }
            <button class="@(session.Muted ? "active" : null)" title="@(session.Muted ? "Unmute" : "Mute")" @onclick="ToggleMuteAsync"><Icon Name="microphone" /></button>
            <button class="@(session.Deafened ? "active" : null)" title="@(session.Deafened ? "Undeafen" : "Deafen")" @onclick="ToggleDeafenAsync"><Icon Name="headphones" /></button>
            <button class="disconnect" title="Disconnect" @onclick="DisconnectAsync"><Icon Name="hangup" /></button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_streamError)) { <small class="stream-error">@_streamError</small> }
    </section>
}

@code {
    protected override void OnInitialized() => Voice.Changed += OnChanged;
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
    private Task ToggleMuteAsync() => Voice.ToggleMuteAsync();
    private Task ToggleDeafenAsync() => Voice.ToggleDeafenAsync();
    private Task DisconnectAsync() => Voice.LeaveCurrentVoiceSessionAsync("voice connection panel disconnect");
    private PublishedVoiceStreamDto? LocalScreenShare => Voice.PublishedStreams.FirstOrDefault(value =>
        value.OwnerAccountId == Voice.LocalAccountId && value.Kind == VoicePublishedStreamKind.ScreenShare);
    private string? _streamError;
    private async Task StartScreenShareAsync()
    {
        try { _streamError = null; await Voice.StartScreenShareAsync(); }
        catch (Exception exception) when (exception.Message.Contains("NotAllowedError", StringComparison.OrdinalIgnoreCase))
        { _streamError = null; }
        catch (Exception exception) { _streamError = exception.Message; }
    }
    private async Task StopScreenShareAsync()
    {
        try { _streamError = null; await Voice.StopScreenShareAsync(); }
        catch (Exception exception) { _streamError = exception.Message; }
    }
    private static string Status(ActiveVoiceSession session) => session.ConnectionState switch
    {
        CallConnectionState.Connected => "Connected",
        CallConnectionState.Connecting => "Connecting",
        CallConnectionState.Failed => "Media connection failed",
        _ when session.Kind == ActiveVoiceSessionKind.CommunityVoiceChannel => "Control connected · Media unavailable",
        _ => "Connecting"
    };
    private string PrimaryLabel(ActiveVoiceSession session) => session.Kind switch
    {
        ActiveVoiceSessionKind.DirectCall => $"{session.DisplayName} · Direct Call",
        _ => $"{Voice.CommunityVoice.CurrentRoom?.CommunityName ?? "Server"} · {session.DisplayName}"
    };
    public void Dispose() => Voice.Changed -= OnChanged;
}
