@using Iridium.Protocol
@implements IDisposable
@inject CallClientService Calls

@if (Calls.CurrentCall is null && Calls.IncomingCall is null &&
         (!string.IsNullOrWhiteSpace(Calls.StatusMessage) || !string.IsNullOrWhiteSpace(Calls.ErrorMessage)))
{
    <section class="call-toast @(Calls.ErrorMessage is null ? null : "error")" role="status">
        @if (Calls.ErrorMessage is not null)
        {
            <span class="call-toast-copy"><strong>Voice connection failed</strong><small>@Calls.ErrorMessage</small></span>
        }
        else
        {
            <span>@Calls.StatusMessage</span>
        }
        <button type="button" aria-label="Dismiss" @onclick="Calls.DismissStatus"><Icon Name="close" /></button>
    </section>
}

@code {
    [Parameter] public Guid? ActiveConversationId { get; set; }
    protected override void OnInitialized() => Calls.Changed += CallsChanged;
    private void CallsChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Calls.Changed -= CallsChanged;
}
