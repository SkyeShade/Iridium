@using Iridium.Client.Core
@using Iridium.Protocol
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<ModalShell Title="Add Friend" Size="medium" OnClose="OnClose">
<section class="add-friend-view">
    <div class="add-friend-content friend-lookup" @ref="_lookupRoot">
        <h1>Add a friend by Iridium identity</h1>
        <p>Search this Node, or enter a complete Iridium identity.</p>
        <label>
            Iridium identity
            <input @ref="_searchInput" value="@_identity" @oninput="IdentityChanged"
                   placeholder="skye@friends.example" autocomplete="off" spellcheck="false"
                   role="combobox" aria-autocomplete="list" aria-expanded="@(_suggestions.Count > 0)"
                   aria-controls="friend-search-suggestions" />
        </label>

        @if (_suggestions.Count > 0)
        {
            <div id="friend-search-suggestions" class="friend-suggestions" role="listbox" aria-label="Accounts on this Node">
                @for (var index = 0; index < _suggestions.Count; index++)
                {
                    var suggestion = _suggestions[index];
                    var relationship = RelationshipFor(suggestion);
                    var friend = FriendFor(suggestion.AccountId);
                    <article class="resolved-card suggestion-card @(index == _suggestionIndex ? "highlighted" : null)"
                             role="option" aria-selected="@(index == _suggestionIndex)"
                             @onpointerdown="() => SelectSuggestionAsync(suggestion)">
                        <ProfileAvatar AccountId="suggestion.AccountId" DisplayName="@suggestion.DisplayName"
                                       Presence="@(friend?.Presence ?? suggestion.Presence)" Size="medium" Surface="sidebar" />
                        <div class="resolved-copy"><strong class="display-name">@suggestion.DisplayName</strong><span>@IridiumIdentity.Format(suggestion.Username, NodeAuthority)</span></div>
                        <div class="resolved-actions" @onpointerdown:stopPropagation="true">
                            @switch (relationship)
                            {
                                case ProfileRelationshipStatus.None:
                                    <button class="primary" disabled="@_busy" @onclick="() => SendSuggestionRequestAsync(suggestion)">Add Friend</button>
                                    break;
                                case ProfileRelationshipStatus.IncomingPending:
                                    <button class="primary" disabled="@_busy" @onclick="() => AcceptSuggestionAsync(suggestion)">Accept</button>
                                    break;
                                case ProfileRelationshipStatus.OutgoingPending:
                                    <span>Request sent</span>
                                    break;
                                case ProfileRelationshipStatus.Friends:
                                    <span>Friend</span>
                                    break;
                            }
                        </div>
                    </article>
                }
            </div>
        }
        else if (_searching)
        {
            <p class="search-state">Searching this Node...</p>
        }

        <div class="resolution" aria-live="polite">
            @if (_resolving)
            {
                <p class="resolution-state">Resolving profile…</p>
            }
            else if (_result?.State == ProfileResolutionState.Resolved && _result.Profile is { } profile && _result.Identity is { } identity)
            {
                <article class="resolved-card @(profile.Relationship == ProfileRelationshipStatus.Self ? null : "clickable")"
                         role="button" tabindex="0" @onclick="() => OpenProfileAsync(profile)">
                    <ProfileAvatar AccountId="profile.AccountId" DisplayName="@profile.DisplayName" Presence="profile.Presence" Size="medium" Surface="sidebar" />
                    <div class="resolved-copy"><strong class="display-name">@profile.DisplayName</strong><span>@identity</span>@if (!string.IsNullOrWhiteSpace(profile.Pronouns)) { <small>@profile.Pronouns</small> }</div>
                    <div class="resolved-actions">
                        @switch (profile.Relationship)
                        {
                            case ProfileRelationshipStatus.None:
                                <button class="primary" disabled="@_busy" @onclick="SendRequestAsync" @onclick:stopPropagation="true">Add Friend</button>
                                break;
                            case ProfileRelationshipStatus.IncomingPending:
                                <button class="primary" disabled="@_busy" @onclick="AcceptAsync" @onclick:stopPropagation="true">Accept Request</button>
                                break;
                            case ProfileRelationshipStatus.OutgoingPending:
                                <span>Request pending</span>
                                break;
                            case ProfileRelationshipStatus.Friends:
                                <span>Click profile to message</span>
                                break;
                            case ProfileRelationshipStatus.Self:
                                <span>This is your account</span>
                                break;
                        }
                    </div>
                </article>
            }
            else if (_result is not null && _result.State != ProfileResolutionState.Invalid)
            {
                <p class="resolution-state">@_result.Message</p>
            }
            @if (!string.IsNullOrWhiteSpace(_error)) { <p class="friend-error">@_error</p> }
        </div>
    </div>
</section>
</ModalShell>

@code {
    [Parameter, EditorRequired] public required Func<string, CancellationToken, Task<ProfileResolutionResult>> Resolve { get; set; }
    [Parameter, EditorRequired] public required Func<string, CancellationToken, Task<IReadOnlyList<FriendSearchResultDto>>> Search { get; set; }
    [Parameter, EditorRequired] public required string NodeAuthority { get; set; }
    [Parameter] public IReadOnlyList<FriendDto> Friends { get; set; } = [];
    [Parameter] public EventCallback<string> OnRequest { get; set; }
    [Parameter] public EventCallback<Guid> OnAccept { get; set; }
    [Parameter] public EventCallback<Guid> OnMessage { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private string _identity = string.Empty;
    private ProfileResolutionResult? _result;
    private IReadOnlyList<FriendSearchResultDto> _suggestions = [];
    private CancellationTokenSource? _debounce;
    private IJSObjectReference? _module;
    private DotNetObjectReference<AddFriendView>? _selfReference;
    private ElementReference _searchInput;
    private ElementReference _lookupRoot;
    private long _queryGeneration;
    private int _suggestionIndex;
    private bool _resolving;
    private bool _searching;
    private bool _busy;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/chat.js");
        _selfReference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("wireFriendAutocomplete", _searchInput, _lookupRoot, _selfReference);
    }

    private void IdentityChanged(ChangeEventArgs args)
    {
        _identity = args.Value?.ToString() ?? string.Empty;
        _result = null;
        _suggestions = [];
        _suggestionIndex = 0;
        _error = null;
        _debounce?.Cancel();
        _debounce?.Dispose();
        _debounce = new CancellationTokenSource();
        var generation = ++_queryGeneration;
        _ = LookupAfterDelayAsync(generation, _debounce.Token);
    }

    private async Task LookupAfterDelayAsync(long generation, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(225, cancellationToken);
            var query = _identity.Trim();
            if (IridiumIdentity.TryParse(query, out _))
            {
                _resolving = true;
                await InvokeAsync(StateHasChanged);
                var result = await Resolve(query, cancellationToken);
                if (generation == _queryGeneration) _result = result;
            }
            else if (!query.Contains('@') && query.Length >= 2)
            {
                _searching = true;
                await InvokeAsync(StateHasChanged);
                var results = await Search(query, cancellationToken);
                if (generation == _queryGeneration)
                {
                    _suggestions = results;
                    _suggestionIndex = 0;
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception exception)
        {
            if (generation == _queryGeneration) _error = exception.Message;
        }
        finally
        {
            if (!cancellationToken.IsCancellationRequested && generation == _queryGeneration)
            {
                _resolving = false;
                _searching = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task SelectSuggestionAsync(FriendSearchResultDto suggestion)
    {
        _identity = IridiumIdentity.Format(suggestion.Username, NodeAuthority);
        CloseSuggestions();
        _resolving = true;
        try { _result = await Resolve(_identity, CancellationToken.None); }
        catch (Exception exception) { _error = exception.Message; }
        finally { _resolving = false; }
    }

    private async Task SendSuggestionRequestAsync(FriendSearchResultDto suggestion)
    {
        _identity = IridiumIdentity.Format(suggestion.Username, NodeAuthority);
        CloseSuggestions();
        await RunActionAsync(() => OnRequest.InvokeAsync(suggestion.Username));
    }

    private async Task AcceptSuggestionAsync(FriendSearchResultDto suggestion)
    {
        var friendshipId = FriendFor(suggestion.AccountId)?.FriendshipId ?? suggestion.FriendshipId;
        if (friendshipId is null) return;
        _identity = IridiumIdentity.Format(suggestion.Username, NodeAuthority);
        CloseSuggestions();
        await RunActionAsync(() => OnAccept.InvokeAsync(friendshipId.Value));
    }

    private async Task SendRequestAsync()
    {
        if (_result?.Identity is not { } identity) return;
        await RunActionAsync(() => OnRequest.InvokeAsync(identity.Username));
    }

    private async Task AcceptAsync()
    {
        if (_result?.Profile?.FriendshipId is not { } id) return;
        await RunActionAsync(() => OnAccept.InvokeAsync(id));
    }

    private Task OpenProfileAsync(ResolvedProfileDto profile) =>
        profile.Relationship == ProfileRelationshipStatus.Self
            ? Task.CompletedTask
            : OnMessage.InvokeAsync(profile.AccountId);

    private async Task RunActionAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            _result = await Resolve(_identity, CancellationToken.None);
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _busy = false; }
    }

    private FriendDto? FriendFor(Guid accountId) => Friends.FirstOrDefault(value => value.AccountId == accountId);

    private ProfileRelationshipStatus RelationshipFor(FriendSearchResultDto suggestion)
    {
        var friend = FriendFor(suggestion.AccountId);
        if (friend is null) return suggestion.Relationship;
        if (friend.Status == FriendshipStatus.Accepted) return ProfileRelationshipStatus.Friends;
        return friend.IsOutgoing
            ? ProfileRelationshipStatus.OutgoingPending
            : ProfileRelationshipStatus.IncomingPending;
    }

    [JSInvokable]
    public async Task HandleFriendSearchKeyAsync(string key)
    {
        if (key == "Escape") { CancelLookup(); CloseSuggestions(); await InvokeAsync(StateHasChanged); return; }
        if (_suggestions.Count == 0) return;
        if (key == "ArrowDown") _suggestionIndex = (_suggestionIndex + 1) % _suggestions.Count;
        else if (key == "ArrowUp") _suggestionIndex = (_suggestionIndex - 1 + _suggestions.Count) % _suggestions.Count;
        else if (key == "Enter") { await SelectSuggestionAsync(_suggestions[_suggestionIndex]); return; }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task CloseFriendSearchAsync()
    {
        CancelLookup();
        CloseSuggestions();
        return InvokeAsync(StateHasChanged);
    }

    private void CancelLookup()
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
        _debounce = null;
        _queryGeneration++;
    }

    private void CloseSuggestions()
    {
        _suggestions = [];
        _searching = false;
        _suggestionIndex = 0;
    }

    public async ValueTask DisposeAsync()
    {
        CancelLookup();
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unwireFriendAutocomplete", _searchInput);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _selfReference?.Dispose();
    }
}
