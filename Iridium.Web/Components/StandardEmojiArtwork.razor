<span class="standard-emoji-artwork @Class" title="@Title" aria-label="@Title">
    @if (!_failed)
    {
        <img src="@ArtworkUrl" alt="@Glyph" loading="lazy" @onerror="() => _failed = true" />
    }
    else
    {
        <span class="native-fallback">@Glyph</span>
    }
</span>

@code {
    [Parameter, EditorRequired] public required string Glyph { get; set; }
    [Parameter, EditorRequired] public required string ArtworkKey { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Class { get; set; }
    private bool _failed;
    private string ArtworkUrl => LocalArtwork.Contains(ArtworkKey)
        ? $"/vendor/twemoji/svg/{ArtworkKey}.svg"
        : $"https://cdn.jsdelivr.net/gh/jdecked/twemoji@v17.0.3/assets/svg/{ArtworkKey}.svg";
    private static readonly HashSet<string> LocalArtwork =
    [
        "1f1e9-1f1f0", "1f308", "1f389", "1f431", "1f436", "1f44b", "1f44d-1f3fd", "1f44d",
        "1f44e", "1f44f", "1f469-200d-1f4bb", "1f525", "1f600", "1f602", "1f60d", "1f60e",
        "1f62d", "1f64f", "1f914", "2705", "2728", "274c", "2764"
    ];
}
