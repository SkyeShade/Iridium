@using Iridium.Web.Models

<span class="standard-emoji-artwork @Class" title="@Title" aria-label="@Title">
    @if (!_failed)
    {
        <img src="@ArtworkUrl" alt="@Glyph" loading="lazy" decoding="async" @onerror="() => _failed = true" />
    }
    else
    {
        <span class="native-fallback">@Glyph</span>
    }
</span>

@code {
    [Parameter, EditorRequired] public required string Glyph { get; set; }
    [Parameter, EditorRequired] public required string ArtworkKey { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Class { get; set; }
    private bool _failed;
    private string ArtworkUrl => StandardEmojiArtworkSource.Resolve(ArtworkKey);
}
