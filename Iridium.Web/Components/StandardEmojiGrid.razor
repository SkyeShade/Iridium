@using Iridium.Protocol

<div class="virtual-emoji-grid" style="--emoji-columns:@Columns" role="grid">
    <Virtualize @key="Columns" Items="_rows" Context="row" ItemSize="42" OverscanCount="2">
        <div class="emoji-grid-row" role="row">
            @foreach (var emoji in row)
            {
                <button @key="emoji.ArtworkKey" type="button" title=":@emoji.Name:" role="gridcell"
                        @onclick="() => OnSelected.InvokeAsync(emoji)">
                    <StandardEmojiArtwork Glyph="@emoji.Glyph" ArtworkKey="@emoji.ArtworkKey" />
                </button>
            }
        </div>
    </Virtualize>
</div>

@code {
    [Parameter, EditorRequired] public required IReadOnlyList<StandardEmoji> Emojis { get; set; }
    [Parameter] public int Columns { get; set; } = 8;
    [Parameter] public EventCallback<StandardEmoji> OnSelected { get; set; }
    private ICollection<IReadOnlyList<StandardEmoji>> _rows = [];

    protected override void OnParametersSet() => _rows = Emojis
        .Chunk(Math.Max(1, Columns)).Select(row => (IReadOnlyList<StandardEmoji>)row).ToArray();
}
