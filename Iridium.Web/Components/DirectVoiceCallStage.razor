@using Iridium.Protocol
@inject CallClientService Calls
@inject ActiveVoiceSessionCoordinator VoiceSessions
@inject BrowserScreenShareCapability ScreenShareCapability
@inject ILogger<DirectVoiceCallStage> Logger

@if (IncomingForConversation is { } incoming)
{
    <section class="dm-call-stage incoming" aria-label="Incoming voice call">
        <div class="single-call-participant">
            <div class="call-avatar"><ProfileAvatar AccountId="incoming.CallerAccountId" DisplayName="@incoming.CallerDisplayName" Presence="@Participant.Presence" Size="large" Surface="base" /></div>
            <strong>@incoming.CallerDisplayName</strong>
            <span>Incoming voice call</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(Calls.ErrorMessage)) { <p class="call-error">@Calls.ErrorMessage</p> }
        <div class="incoming-actions">
            <button type="button" class="answer-button" disabled="@Calls.IsAccepting" @onclick="AcceptAsync"><Icon Name="phone" /> @(Calls.IsAccepting ? "Answering..." : "Answer")</button>
            <button type="button" class="decline-button" disabled="@Calls.IsAccepting" @onclick="DeclineAsync"><Icon Name="hangup" /> Decline</button>
        </div>
    </section>
}
else if (CallForConversation is { } call)
{
    var isRinging = call.State == CallState.Ringing;
    <section class="dm-call-stage @(isRinging ? "outgoing" : "active") @(MobileExpanded ? "mobile-expanded" : null)" aria-label="@(isRinging ? "Outgoing voice call" : "Active voice call")">
        @if (MobileExpanded)
        {
            <button type="button" class="mobile-call-minimize" title="Minimize call" aria-label="Minimize call"
                    @onclick="MinimizeMobileAsync"><Icon Name="minus" /></button>
        }
        @if (isRinging)
        {
            @if (MobileExpanded)
            {
                <div class="call-participants mobile-preanswer-participants">
                    <div class="call-participant">
                        <div class="call-avatar"><ProfileAvatar AccountId="CurrentAccountId" DisplayName="@CurrentParticipantName" Presence="PublicPresence.Online" Size="large" Surface="base" /></div>
                        <strong>@CurrentParticipantName</strong><span>You</span>
                    </div>
                    <div class="call-participant">
                        <div class="call-avatar"><ProfileAvatar AccountId="Participant.AccountId" DisplayName="@Participant.DisplayName" Presence="@Participant.Presence" Size="large" Surface="base" /></div>
                        <strong>@Participant.DisplayName</strong><span>Calling</span>
                    </div>
                </div>
            }
            else
            {
            <div class="single-call-participant">
                <div class="call-avatar"><ProfileAvatar AccountId="Participant.AccountId" DisplayName="@Participant.DisplayName" Presence="@Participant.Presence" Size="large" Surface="base" /></div>
                <strong>@Participant.DisplayName</strong>
                <span>Calling…</span>
            </div>
            }
            @if (MobileExpanded) { <span class="mobile-call-duration" aria-live="off"><VoiceElapsedTimer StartedAt="call.CreatedAt" /></span> }
            <button type="button" class="leave-button" aria-label="Cancel call" @onclick="HangUpAsync"><Icon Name="hangup" /> Cancel</button>
        }
        else
        {
            <div class="call-participants">
                @foreach (var callParticipant in call.Participants)
                {
                    var participantStream = Calls.PublishedStreams.FirstOrDefault(value =>
                        value.OwnerAccountId == callParticipant.AccountId);
                    <div class="call-participant" @oncontextmenu="() => OpenParticipantMenu(callParticipant)"
                         @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
                        @if (participantStream is not null)
                        {
                            <button type="button" class="dm-participant-stream @(callParticipant.IsSpeaking ? "speaking" : null)"
                                    title="@(callParticipant.AccountId == CurrentAccountId ? "Preview your screen share" : $"Watch {callParticipant.DisplayName}'s stream")"
                                    @onclick="() => WatchStreamAsync(participantStream.StreamId)" @onclick:stopPropagation="true">
                                @if (VoiceSessions.GetStreamThumbnail(participantStream.StreamId) is { Length: > 0 } thumbnail)
                                {
                                    <img class="dm-participant-stream-thumbnail" src="@thumbnail" alt="" />
                                }
                                else
                                {
                                    <span class="dm-participant-stream-placeholder"><Icon Name="screen" /> Screen Share</span>
                                }
                                <span class="dm-participant-stream-live">LIVE</span>
                                <span class="dm-participant-stream-avatar">
                                    <ProfileAvatar AccountId="callParticipant.AccountId" DisplayName="@callParticipant.DisplayName"
                                                   Presence="@(callParticipant.AccountId == CurrentAccountId ? PublicPresence.Online : Participant.Presence)"
                                                   Size="small" Surface="base" />
                                </span>
                            </button>
                        }
                        else
                        {
                            <div class="call-avatar @(callParticipant.IsSpeaking ? "speaking" : null)">
                                <ProfileAvatar AccountId="callParticipant.AccountId" DisplayName="@callParticipant.DisplayName"
                                               Presence="@(callParticipant.AccountId == CurrentAccountId ? PublicPresence.Online : Participant.Presence)"
                                               Size="large" Surface="base" />
                            </div>
                        }
                        <strong>@callParticipant.DisplayName</strong>
                        @if (callParticipant.IsMuted) { <span>Muted</span> }
                        @if (MobileExpanded && callParticipant.IsDeafened) { <span>Deafened</span> }
                        @if (_menuRemoteAccountId == callParticipant.AccountId)
                        {
                            <VoiceParticipantMenu AccountId="callParticipant.AccountId" DisplayName="callParticipant.DisplayName"
                                                  Username="Participant.Username" />
                        }
                    </div>
                }
            </div>
            <div class="media-status @(Calls.MediaConnectionState == CallConnectionState.Failed ? "failed" : null)">
                <span>@(MobileExpanded ? MobileProjection?.Status ?? MediaStatus : Calls.StatusMessage ?? MediaStatus)</span>
                @if (MobileExpanded)
                {
                    <small aria-live="off"><VoiceElapsedTimer StartedAt="@(call.AcceptedAt ?? call.CreatedAt)" /></small>
                }
                else if (!string.IsNullOrWhiteSpace(Calls.ErrorMessage)) { <small>@Calls.ErrorMessage</small> }
                @if (!string.IsNullOrWhiteSpace(_shareError)) { <small>@_shareError</small> }
            </div>
            <div class="active-call-controls">
                <button type="button" class="call-control @(Calls.IsMuted ? "selected" : null)" title="@(VoiceSessions.PreferredMuted ? "Unmute microphone" : "Mute microphone")"
                        aria-label="@(VoiceSessions.PreferredMuted ? "Unmute microphone" : "Mute microphone")"
                        aria-pressed="@VoiceSessions.PreferredMuted" @onclick="ToggleMuteAsync"><Icon Name="microphone" /><span>@(VoiceSessions.PreferredMuted ? "Unmute" : "Mute")</span></button>
                <button type="button" class="call-control @(Calls.IsDeafened ? "selected" : null)" title="@(VoiceSessions.PreferredDeafened ? "Undeafen" : "Deafen")"
                        aria-label="@(VoiceSessions.PreferredDeafened ? "Undeafen" : "Deafen")"
                        aria-pressed="@VoiceSessions.PreferredDeafened" @onclick="ToggleDeafenAsync"><Icon Name="headphones" /><span>@(VoiceSessions.PreferredDeafened ? "Undeafen" : "Deafen")</span></button>
                @if (IsSharing || CanStartScreenShare)
                {
                    <button type="button" class="call-control @(IsSharing ? "selected" : null)"
                            title="@(IsSharing ? "Stop sharing" : "Share screen. Audio availability depends on the selected source and browser.")"
                            aria-label="@(IsSharing ? "Stop screen sharing" : "Start screen sharing")" @onclick="ToggleScreenShareAsync">
                        <Icon Name="screen" /><span>@(IsSharing ? "Stop Sharing" : MobileExpanded ? "Start Screen Share" : "Share Screen")</span>
                    </button>
                }
                @if (MobileExpanded && RemoteScreenShare is { } remoteStream)
                {
                    @if (Calls.WatchedStream?.StreamId == remoteStream.StreamId)
                    {
                        <button type="button" class="call-control selected" title="Stop watching stream"
                                aria-label="Stop watching stream" @onclick="StopWatchingAsync">
                            <Icon Name="screen" /><span>Stop Watching</span>
                        </button>
                    }
                    else
                    {
                        <button type="button" class="call-control" title="Watch stream"
                                aria-label="Watch stream" @onclick="() => WatchStreamAsync(remoteStream.StreamId)">
                            <Icon Name="screen" /><span>Watch Stream</span>
                        </button>
                    }
                }
                @if (Calls.CanRetry)
                {
                    <button type="button" class="call-control retry" title="Retry media connection" aria-label="Retry media connection" @onclick="RetryAsync"><Icon Name="refresh" /><span>Retry</span></button>
                }
                <button type="button" class="call-control leave" title="@(MobileExpanded ? "Hang up" : "Leave call")"
                        aria-label="@(MobileExpanded ? "Hang up" : "Leave call")" @onclick="HangUpAsync"><Icon Name="hangup" /><span>@(MobileExpanded ? "Hang Up" : "Leave")</span></button>
            </div>
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public required Guid ConversationId { get; set; }
    [Parameter, EditorRequired] public required Guid CurrentAccountId { get; set; }
    [Parameter, EditorRequired] public required DirectParticipantDto Participant { get; set; }
    [Parameter] public bool MobileExpanded { get; set; }
    [Parameter] public EventCallback OnMobileMinimize { get; set; }
    private IncomingCallEvent? IncomingForConversation => Calls.IncomingCall is { DirectConversationId: var id } incoming && id == ConversationId ? incoming : null;
    private CallSessionDto? CallForConversation => Calls.CurrentCall is { DirectConversationId: var id } call && id == ConversationId ? call : null;
    private string MediaStatus => Calls.MediaConnectionState switch
    {
        CallConnectionState.Connected => "Connected",
        CallConnectionState.Failed => "Connection failed",
        CallConnectionState.Disconnected => "Connection interrupted…",
        _ => "Connecting media…"
    };
    private Guid? _menuRemoteAccountId;
    private string? _shareError;
    private string CurrentParticipantName => CallForConversation?.Participants
        .FirstOrDefault(value => value.AccountId == CurrentAccountId)?.DisplayName ?? "You";
    private MobileDirectCallBarProjection? MobileProjection => MobileDirectCallBarState.Project(
        Calls.CurrentCall, Calls.MediaConnectionState);
    private bool IsSharing => Calls.PublishedStreams.Any(value => value.OwnerAccountId == CurrentAccountId &&
        value.Kind == VoicePublishedStreamKind.ScreenShare);
    private PublishedVoiceStreamDto? RemoteScreenShare => Calls.PublishedStreams.FirstOrDefault(value =>
        value.OwnerAccountId != CurrentAccountId && value.Kind == VoicePublishedStreamKind.ScreenShare);
    private bool CanStartScreenShare => Calls.CurrentCall?.State == CallState.Active &&
        Calls.MediaConnectionState == CallConnectionState.Connected && ScreenShareCapability.IsSupported;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await ScreenShareCapability.DetectAsync();
        await InvokeAsync(StateHasChanged);
    }
    private void OpenParticipantMenu(CallParticipantDto participant) =>
        _menuRemoteAccountId = participant.AccountId == CurrentAccountId ? null : participant.AccountId;
    private Task AcceptAsync() => VoiceSessions.AcceptIncomingDirectAsync();
    private Task DeclineAsync() => VoiceSessions.DeclineIncomingDirectAsync();
    private Task HangUpAsync() => VoiceSessions.LeaveCurrentVoiceSessionAsync("Direct Call UI leave");
    private Task ToggleMuteAsync() => VoiceSessions.ToggleMuteAsync();
    private Task ToggleDeafenAsync() => VoiceSessions.ToggleDeafenAsync();
    private Task RetryAsync() => Calls.RetryMediaAsync();
    private Task WatchStreamAsync(Guid streamId) => VoiceSessions.WatchStreamAsync(streamId);
    private Task StopWatchingAsync() => VoiceSessions.StopWatchingAsync();
    private Task MinimizeMobileAsync() => OnMobileMinimize.InvokeAsync();
    private async Task ToggleScreenShareAsync()
    {
        try
        {
            _shareError = null;
            if (IsSharing) await VoiceSessions.StopScreenShareAsync();
            else await VoiceSessions.StartScreenShareAsync();
        }
        catch (Exception exception)
        {
            Logger.LogDebug(exception, "Screen sharing could not be started in a Direct Call");
            _shareError = ScreenShareFailure.UserMessage(exception);
        }
    }
}
