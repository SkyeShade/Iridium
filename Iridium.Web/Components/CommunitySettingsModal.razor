@using Iridium.Client.Core
@using Iridium.Protocol
@inject IJSRuntime JS
@inject NodeSession Session
@implements IAsyncDisposable

<ModalShell Title="Server Settings" Size="extra-large" OnClose="OnClose">
    <div class="community-settings">
        <aside>
            <p>@Community.Name</p>
            @foreach (var section in Sections)
            {
                <button class="@(section == _section ? "active" : null)" @onclick="() => SelectSection(section)">@section</button>
            }
            <p class="settings-group">EXPRESSIONS</p>
            <button class="@(_section == "Emoji" ? "active" : null)" @onclick='() => SelectSection("Emoji")'>Emoji</button>
        </aside>
        <main>
            @if (_loading)
            {
                <p class="muted">Loading Server settings...</p>
            }
            else if (!string.IsNullOrWhiteSpace(_error))
            {
                <p class="error" role="alert">@_error</p>
            }
            else if (State.Management is { } management)
            {
                @if (_section == "Overview")
                {
                    <h1>Overview</h1>
                    <section class="community-media-settings" aria-label="Server media">
                        <div>
                            <span class="media-label">Server Icon</span>
                            <button type="button" class="community-icon-edit" disabled="@(!management.Access.Has(CommunityPermission.ManageCommunity))"
                                    aria-label="Edit Server icon" @onclick="() => _avatarEditorOpen = true">
                                @if (!string.IsNullOrWhiteSpace(CurrentCommunity.AvatarUrl)) { <AvatarCroppedPreview State="CurrentCommunityAvatarState" /> }
                                else { <strong>@CommunityInitials(CurrentCommunity.Name)</strong> }
                                <span class="media-edit-overlay">Edit</span>
                            </button>
                        </div>
                        <div class="community-banner-setting">
                            <span class="media-label">Server Banner</span>
                            <button type="button" class="community-banner-edit" disabled="@(!management.Access.Has(CommunityPermission.ManageCommunity))"
                                    aria-label="Edit Server banner" @onclick="() => _bannerEditorOpen = true">
                                @if (CurrentCommunity.BannerIsProcessed && !string.IsNullOrWhiteSpace(CurrentCommunity.BannerUrl))
                                { <img class="community-banner-image" src="@CurrentCommunity.BannerUrl" alt="" /> }
                                else if (CurrentCommunityBannerState is not null) { <AvatarCroppedPreview State="CurrentCommunityBannerState" Shape="banner" /> }
                                else { <span class="banner-fallback"></span> }
                                <span class="media-edit-overlay">Edit</span>
                            </button>
                        </div>
                    </section>
                    <label>Server Name<input @bind="_communityName" maxlength="100" disabled="@(!management.Access.Has(CommunityPermission.ManageCommunity))" /></label>
                    <label>Description<textarea @bind="_communityDescription" maxlength="500" disabled="@(!management.Access.Has(CommunityPermission.ManageCommunity))"></textarea></label>
                    @if (management.Access.Has(CommunityPermission.ManageCommunity))
                    {
                        <button class="primary" @onclick="SaveOverviewAsync">Save Changes</button>
                    }
                }
                else if (_section == "Roles")
                {
                    <div class="section-heading"><div><h1>Roles</h1><p>Higher roles appear first. The owner always has every permission.</p></div>
                        @if (management.Access.Has(CommunityPermission.ManageRoles)) { <button class="primary" @onclick="NewRole">Create Role</button> }
                    </div>
                    <div class="roles-layout">
                        <div class="role-list">
                            <input class="role-search" placeholder="Search roles" @bind="_roleSearch" @bind:event="oninput" />
                            @if (management.Roles.FirstOrDefault(value => value.IsDefault) is { } defaultRole)
                            {
                                <button class="default-permissions @(_selectedRole?.Id == defaultRole.Id ? "active" : null)" @onclick="() => SelectRole(defaultRole)">
                                    <span>Default permissions</span><small>ALL MEMBERS</small>
                                </button>
                            }
                            <div class="role-sort-list" @ref="_roleList">
                                @foreach (var role in FilteredRoles)
                                {
                                    <div class="role-list-row" data-iridium-role-drag="@(CanManageRoleInSettings(role) ? role.Id : null)">
                                        <button class="role-select @(_selectedRole?.Id == role.Id ? "active" : null)" @onclick="() => SelectRole(role)">
                                            <span class="role-indicator" style="background:@(role.Color ?? "var(--text-muted)")"></span>
                                            <span class="role-name" style="color:@(role.Color ?? "var(--text-muted)")">@role.Name</span>
                                            <small>@MemberCount(role.Id) members</small>
                                        </button>
                                        <button class="role-row-action" title="Edit @role.Name" @onclick="() => SelectRole(role)"><Icon Name="edit" /></button>
                                        <button class="role-row-action" title="More options" @onclick="() => SelectRole(role)"><Icon Name="more" /></button>
                                    </div>
                                }
                            </div>
                        </div>
                        @if (_editingNewRole || _selectedRole is not null)
                        {
                            <div class="role-editor">
                                <nav class="role-editor-tabs">
                                    @foreach (var tab in RoleEditorTabs) { <button class="@(_roleEditorTab == tab ? "active" : null)" @onclick="() => _roleEditorTab = tab">@tab</button> }
                                </nav>
                                @if (_roleEditorTab == "Display")
                                {
                                <label>Role Name<input @bind="_roleName" maxlength="64" disabled="@(!management.Access.Has(CommunityPermission.ManageRoles) || _selectedRole?.IsDefault == true)" /></label>
                                <label>Display Color</label>
                                <div class="role-color-control">
                                    <input class="role-swatch" type="color" @bind="_roleColor" disabled="@(!management.Access.Has(CommunityPermission.ManageRoles))" aria-label="Role color picker" />
                                    <input class="role-hex" value="@_roleColor" @oninput="UpdateRoleHex" maxlength="7" spellcheck="false"
                                           disabled="@(!management.Access.Has(CommunityPermission.ManageRoles))" aria-label="Role color hex value" />
                                </div>
                                <label class="display-separately"><input type="checkbox" @bind="_roleDisplaySeparately"
                                    disabled="@(!management.Access.Has(CommunityPermission.ManageRoles) || _selectedRole?.IsDefault == true)" />
                                    Display members separately in the member list</label>
                                <label class="display-separately"><input type="checkbox" @bind="_roleIsMentionable"
                                    disabled="@(!management.Access.Has(CommunityPermission.ManageRoles) || _selectedRole?.IsDefault == true)" />
                                    Members may mention this role</label>
                                }
                                else if (_roleEditorTab == "Permissions")
                                {
                                <input class="permission-search" placeholder="Search permissions" @bind="_permissionSearch" @bind:event="oninput" />
                                <div class="permission-list">
                                    @foreach (var permission in FilteredPermissions)
                                    {
                                        <label><input type="checkbox" checked="@HasRolePermission(permission)"
                                                      disabled="@(!management.Access.Has(CommunityPermission.ManageRoles))"
                                                      @onchange="args => ToggleRolePermission(permission, args)" />
                                            <span><strong>@PermissionLabel(permission)</strong><small>@PermissionDescription(permission)</small></span>
                                        </label>
                                    }
                                </div>
                                }
                                else
                                {
                                    <div class="role-member-list">
                                        @foreach (var member in MembersForSelectedRole)
                                        {
                                            <div><ProfileAvatar AccountId="member.AccountId" DisplayName="@member.DisplayName" Presence="member.Presence" Size="small" Surface="panel" /><span class="display-name">@member.DisplayName</span><button disabled="@(!CanManageRoleInSettings(_selectedRole!))" @onclick="() => RemoveSelectedRoleFromMemberAsync(member)">Remove</button></div>
                                        }
                                        @if (MembersForSelectedRole.Count == 0) { <p class="muted">No members have this role.</p> }
                                        @if (_selectedRole is { IsDefault: false } selectedRole && CanManageRoleInSettings(selectedRole))
                                        {
                                            <select value="" @onchange="AddSelectedRoleToMemberAsync"><option value="">Add member...</option>@foreach (var member in MembersWithoutSelectedRole) { <option value="@member.AccountId">@member.DisplayName</option> }</select>
                                        }
                                    </div>
                                }
                                @if (management.Access.Has(CommunityPermission.ManageRoles))
                                {
                                    <div class="actions">
                                        <button class="primary" @onclick="SaveRoleAsync">@(_editingNewRole ? "Create Role" : "Save Role")</button>
                                        @if (_selectedRole is { IsDefault: false } selected)
                                        {
                                            @if (_confirmRoleDelete)
                                            {
                                                <button class="danger" @onclick="DeleteRoleAsync">Confirm Delete</button>
                                            }
                                            else
                                            {
                                                <button class="danger-link" @onclick="() => _confirmRoleDelete = true">Delete Role</button>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else if (_section == "Members")
                {
                    <h1>Members</h1>
                    <div class="member-list">
                        @foreach (var member in management.Members)
                        {
                            <button class="member-row @(_selectedMember?.AccountId == member.AccountId ? "active" : null)" @onclick="() => SelectMember(member)">
                                <ProfileAvatar AccountId="member.AccountId" DisplayName="@member.DisplayName" Presence="member.Presence" Size="small" Surface="panel" />
                                <span><span class="display-name">@member.DisplayName</span><small>@IridiumIdentity.Format(member.Username, NodeAuthority)</small></span>
                                @if (member.IsOwner) { <em>OWNER</em> }
                            </button>
                        }
                    </div>
                    @if (_selectedMember is { } memberValue)
                    {
                        <div class="member-editor">
                            <h2 class="display-name">@memberValue.DisplayName</h2>
                            <div class="member-roles">
                                @foreach (var role in management.Roles.Where(value => !value.IsDefault).OrderByDescending(value => value.Position))
                                {
                                    <label><input type="checkbox" checked="@_memberRoleIds.Contains(role.Id)"
                                                  disabled="@(!management.Access.Has(CommunityPermission.ManageRoles) || memberValue.IsOwner && !management.Access.IsOwner)"
                                                  @onchange="args => ToggleMemberRole(role.Id, args)" /> <span style="color:@(role.Color ?? "var(--text-muted)")">@role.Name</span></label>
                                }
                            </div>
                            <div class="actions">
                                @if (management.Access.Has(CommunityPermission.ManageRoles)) { <button class="primary" @onclick="SaveMemberRolesAsync">Save Roles</button> }
                                @if (!memberValue.IsOwner && management.Access.Has(CommunityPermission.KickMembers))
                                {
                                    <button class="danger-link" @onclick="KickSelectedAsync">@(_confirmKick ? "Confirm Kick" : "Kick Member")</button>
                                }
                                @if (!memberValue.IsOwner && management.Access.Has(CommunityPermission.BanMembers))
                                {
                                    <button class="danger" @onclick="BanSelectedAsync">@(_confirmBan ? "Confirm Ban" : "Ban Member")</button>
                                }
                            </div>
                        </div>
                    }
                    @if (management.Access.Has(CommunityPermission.BanMembers) && management.Bans.Count > 0)
                    {
                        <h2>Banned Accounts</h2>
                        @foreach (var ban in management.Bans)
                        {
                            <div class="ban-row"><span><span class="display-name">@ban.DisplayName</span><small>@IridiumIdentity.Format(ban.Username, NodeAuthority)</small></span><button @onclick="() => UnbanAsync(ban.AccountId)">Unban</button></div>
                        }
                    }
                }
                else if (_section == "Node Limits")
                {
                    <div class="section-heading"><div><h1>Node Limits</h1><p>Infrastructure policies applied by the Node hosting this Server.</p></div></div>
                    <div class="node-limits" aria-label="Read-only Node limits">
                        <div><span>Maximum message length</span><strong>@management.Limits.MaxMessageCharacters.ToString("N0") characters</strong></div>
                        <div><span>Maximum file size per upload</span><strong>@AttachmentComposerService.FormatSize(management.Limits.MaxAttachmentBytes)</strong></div>
                        <div><span>Maximum attachments per message</span><strong>@management.Limits.MaxAttachmentsPerMessage.ToString("N0")</strong></div>
                    </div>
                    <p class="muted limit-note">These limits are controlled by the Node and cannot be changed by Server managers.</p>
                }
                else if (_section == "Invites")
                {
                    <div class="section-heading"><div><h1>Invites</h1><p>Invite secrets are shown only once when created.</p></div></div>
                    @if (management.Access.Has(CommunityPermission.CreateInvites))
                    {
                        <div class="invite-create">
                            <label>Expires<select @bind="_inviteLifetime"><option value="never">Never</option><option value="day">24 hours</option><option value="week">7 days</option></select></label>
                            <label>Maximum Uses<input type="number" min="1" placeholder="Unlimited" @bind="_inviteMaxUses" /></label>
                            <button class="join" @onclick="CreateInviteAsync">Create Invite</button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_createdInviteUrl))
                        {
                            <div class="created-invite"><span>Share this invite now:</span><code>@_createdInviteUrl</code>
                                <button class="copy-link" @onclick="CopyInviteAsync">@(_inviteCopied ? "Copied" : "Copy Link")</button>
                            </div>
                        }
                        <div class="invite-list">
                            @foreach (var invite in management.Invites)
                            {
                                <div class="invite-row"><code>@invite.CodePrefix...</code><span>by <span class="display-name">@invite.CreatorDisplayName</span></span><span>@invite.Uses / @(invite.MaxUses?.ToString() ?? "unlimited") uses</span><span>@Expiration(invite)</span><button class="danger-link" @onclick="() => RevokeInviteAsync(invite.Id)">Revoke</button></div>
                            }
                        </div>
                    }
                    else { <p class="muted">You do not have permission to create or manage invites.</p> }
                }
                else if (_section == "Emoji")
                {
                    <CommunityEmojiSettings Community="CurrentCommunity" CanManage="management.Access.Has(CommunityPermission.ManageExpressions)" />
                }
            }
        </main>
    </div>
</ModalShell>

@if (_avatarEditorOpen)
{
    <AvatarEditorModal Community="CurrentCommunity" OnSaved="RefreshCommunityMediaAsync" OnClosed="() => _avatarEditorOpen = false" />
}
@if (_bannerEditorOpen)
{
    <BannerEditorModal Community="CurrentCommunity" OnSaved="RefreshCommunityMediaAsync" OnClosed="() => _bannerEditorOpen = false" />
}

@code {
    [Parameter, EditorRequired] public required CommunityDto Community { get; set; }
    [Parameter, EditorRequired] public required CommunitySession State { get; set; }
    [Parameter, EditorRequired] public required string NodeAuthority { get; set; }
    [Parameter, EditorRequired] public required Guid CurrentAccountId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<CommunityDto> OnCommunityUpdated { get; set; }
    private static readonly string[] Sections = ["Overview", "Roles", "Members", "Node Limits", "Invites"];
    private static readonly CommunityPermission[] PermissionOptions =
    [
        CommunityPermission.ViewChannels, CommunityPermission.SendMessages, CommunityPermission.ManageMessages,
        CommunityPermission.ManageChannels, CommunityPermission.ManageCommunity, CommunityPermission.ManageRoles,
        CommunityPermission.CreateInvites, CommunityPermission.KickMembers, CommunityPermission.BanMembers,
        CommunityPermission.MentionEveryone, CommunityPermission.ConnectVoice, CommunityPermission.SpeakVoice,
        CommunityPermission.ShareScreen,
        CommunityPermission.ManagePermissions, CommunityPermission.ReadMessageHistory,
        CommunityPermission.AttachFiles, CommunityPermission.EmbedLinks, CommunityPermission.AddReactions,
        CommunityPermission.MuteMembers, CommunityPermission.DeafenMembers, CommunityPermission.MoveMembers,
        CommunityPermission.ManageExpressions,
        CommunityPermission.Administrator
    ];
    private string _section = "Overview";
    private bool _loading = true;
    private bool _avatarEditorOpen, _bannerEditorOpen;
    private string? _error;
    private string _communityName = string.Empty;
    private string? _communityDescription;
    private CommunityRoleDto? _selectedRole;
    private bool _editingNewRole;
    private bool _confirmRoleDelete;
    private string _roleName = string.Empty;
    private string _roleColor = "#6677E8";
    private string _roleSearch = string.Empty;
    private string _permissionSearch = string.Empty;
    private string _roleEditorTab = "Display";
    private static readonly string[] RoleEditorTabs = ["Display", "Permissions", "Manage Members"];
    private CommunityPermission _rolePermissions;
    private bool _roleDisplaySeparately;
    private bool _roleIsMentionable;
    private CommunityMemberDto? _selectedMember;
    private readonly HashSet<Guid> _memberRoleIds = [];
    private bool _confirmKick;
    private bool _confirmBan;
    private string _inviteLifetime = "never";
    private int? _inviteMaxUses;
    private string? _createdInviteUrl;
    private bool _inviteCopied;
    private ElementReference _roleList;
    private IJSObjectReference? _roleSortModule;
    private DotNetObjectReference<CommunitySettingsModal>? _roleSortReference;
    private bool _roleSorterWired;
    private CommunityDto CurrentCommunity => Session.Communities.FirstOrDefault(value => value.Id == Community.Id) ?? Community;
    private ProfileMediaEditState? CurrentCommunityAvatarState => string.IsNullOrWhiteSpace(CurrentCommunity.AvatarUrl) ? null : new AvatarEditState(
        CurrentCommunity.AvatarUrl, Math.Max(1, CurrentCommunity.AvatarWidth), Math.Max(1, CurrentCommunity.AvatarHeight),
        760, 1000, 1000, Math.Max(1, CurrentCommunity.AvatarZoom), CurrentCommunity.AvatarCropX, CurrentCommunity.AvatarCropY);
    private ProfileMediaEditState? CurrentCommunityBannerState => string.IsNullOrWhiteSpace(CurrentCommunity.BannerUrl) ||
        CurrentCommunity.BannerIsProcessed ? null : new(CurrentCommunity.BannerUrl,
            Math.Max(1, CurrentCommunity.BannerWidth), Math.Max(1, CurrentCommunity.BannerHeight),
            CommunityBannerLimits.CropWidth, CommunityBannerLimits.CropHeight, 1200, 900,
            Math.Max(1, CurrentCommunity.BannerZoom), CurrentCommunity.BannerCropX, CurrentCommunity.BannerCropY);

    private IReadOnlyList<CommunityRoleDto> FilteredRoles => State.Management?.Roles
        .Where(value => !value.IsDefault && (string.IsNullOrWhiteSpace(_roleSearch) || value.Name.Contains(_roleSearch, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(value => value.Position).ToArray() ?? [];
    private IReadOnlyList<CommunityPermission> FilteredPermissions => PermissionOptions
        .Where(value => string.IsNullOrWhiteSpace(_permissionSearch) || PermissionLabel(value).Contains(_permissionSearch, StringComparison.OrdinalIgnoreCase)).ToArray();
    private IReadOnlyList<CommunityMemberDto> MembersForSelectedRole => _selectedRole is null ? [] :
        State.Management?.Members.Where(value => value.RoleIds.Contains(_selectedRole.Id))
            .OrderBy(value => value.DisplayName, StringComparer.OrdinalIgnoreCase).ToArray() ?? [];
    private IReadOnlyList<CommunityMemberDto> MembersWithoutSelectedRole => _selectedRole is null ? [] :
        State.Management?.Members.Where(value => !value.IsOwner && !value.RoleIds.Contains(_selectedRole.Id))
            .OrderBy(value => value.DisplayName, StringComparer.OrdinalIgnoreCase).ToArray() ?? [];
    private int MemberCount(Guid roleId) => State.Management?.Members.Count(value => value.RoleIds.Contains(roleId)) ?? 0;
    private bool CanManageRoleInSettings(CommunityRoleDto role)
    {
        if (role.IsDefault || State.Management is not { } management || !management.Access.Has(CommunityPermission.ManageRoles)) return false;
        if (management.Access.IsOwner) return true;
        var member = management.Members.FirstOrDefault(value => value.AccountId == CurrentAccountId);
        if (member is null) return false;
        var highest = management.Roles.Where(value => member.RoleIds.Contains(value.Id)).Select(value => value.Position).DefaultIfEmpty(-1).Max();
        return role.Position < highest;
    }

    private async Task RemoveSelectedRoleFromMemberAsync(CommunityMemberDto member)
    {
        if (_selectedRole is null || !CanManageRoleInSettings(_selectedRole)) return;
        await RunAsync(() => State.SetMemberRolesAsync(member.AccountId, member.RoleIds.Where(value => value != _selectedRole.Id).ToArray()));
    }
    private async Task AddSelectedRoleToMemberAsync(ChangeEventArgs args)
    {
        if (_selectedRole is null || !CanManageRoleInSettings(_selectedRole) || !Guid.TryParse(args.Value?.ToString(), out var accountId)) return;
        var member = State.Management?.Members.FirstOrDefault(value => value.AccountId == accountId);
        if (member is null) return;
        await RunAsync(() => State.SetMemberRolesAsync(accountId, member.RoleIds.Append(_selectedRole.Id).Distinct().ToArray()));
    }

    protected override async Task OnInitializedAsync()
    {
        _communityName = Community.Name;
        _communityDescription = Community.Description;
        await RunAsync(() => State.LoadManagementAsync());
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_section != "Roles" || _loading || _roleSorterWired || State.Management?.Access.Has(CommunityPermission.ManageRoles) != true) return;
        _roleSortModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/chat.js");
        _roleSortReference ??= DotNetObjectReference.Create(this);
        await _roleSortModule.InvokeVoidAsync("wireRoleSorter", _roleList, _roleSortReference);
        _roleSorterWired = true;
    }

    private void SelectSection(string section) { _section = section; _error = null; }
    private void NewRole() { _editingNewRole = true; _selectedRole = null; _roleEditorTab = "Display"; _roleName = "New Role"; _roleColor = "#6677E8"; _rolePermissions = CommunityPermission.None; _roleDisplaySeparately = false; _roleIsMentionable = false; _confirmRoleDelete = false; }
    private void SelectRole(CommunityRoleDto role) { _editingNewRole = false; _selectedRole = role; _roleEditorTab = role.IsDefault ? "Permissions" : "Display"; _roleName = role.Name; _roleColor = role.Color ?? "#6677E8"; _rolePermissions = role.Permissions; _roleDisplaySeparately = role.DisplaySeparately; _roleIsMentionable = role.IsMentionable; _confirmRoleDelete = false; }
    private bool HasRolePermission(CommunityPermission permission) => (_rolePermissions & permission) != 0;
    private void ToggleRolePermission(CommunityPermission permission, ChangeEventArgs args)
    {
        if (args.Value is true) _rolePermissions |= permission; else _rolePermissions &= ~permission;
    }
    private async Task SaveRoleAsync() => await RunAsync(async () =>
    {
        if (!System.Text.RegularExpressions.Regex.IsMatch(_roleColor, "^#[0-9A-Fa-f]{6}$"))
            throw new InvalidOperationException("Role color must use the format #RRGGBB.");
        _roleColor = _roleColor.ToUpperInvariant();
        if (_editingNewRole) await State.CreateRoleAsync(_roleName, _rolePermissions, _roleColor, _roleDisplaySeparately, _roleIsMentionable);
        else if (_selectedRole is { } role) await State.UpdateRoleAsync(role.Id, _roleName, _rolePermissions, _roleColor, _roleDisplaySeparately, _roleIsMentionable);
        _editingNewRole = false;
        _selectedRole = State.Management?.Roles.FirstOrDefault(value => value.Name == _roleName);
    });
    private void UpdateRoleHex(ChangeEventArgs args)
    {
        var value = args.Value?.ToString()?.Trim() ?? string.Empty;
        _roleColor = value.Length <= 7 ? value : value[..7];
    }
    private async Task MoveRoleAsync(CommunityRoleDto role, int delta) => await RunAsync(async () =>
    {
        await State.MoveRoleAsync(role.Id, role.Position + delta);
        _selectedRole = State.Management?.Roles.FirstOrDefault(value => value.Id == role.Id);
    });
    [JSInvokable]
    public async Task CommitRoleDropAsync(string roleId, int displayIndex)
    {
        if (!Guid.TryParse(roleId, out var id) || State.Management is not { } management) return;
        var roles = management.Roles.Where(value => !value.IsDefault).OrderByDescending(value => value.Position).ToArray();
        if (roles.All(value => value.Id != id)) return;
        var position = Math.Clamp(roles.Length - displayIndex, 1, roles.Length);
        await RunAsync(() => State.MoveRoleAsync(id, position));
        _selectedRole = State.Management?.Roles.FirstOrDefault(value => value.Id == id);
    }
    private async Task DeleteRoleAsync() => await RunAsync(async () =>
    {
        if (_selectedRole is null) return;
        await State.DeleteRoleAsync(_selectedRole.Id);
        _selectedRole = null;
        _confirmRoleDelete = false;
    });
    private void SelectMember(CommunityMemberDto member) { _selectedMember = member; _memberRoleIds.Clear(); _memberRoleIds.UnionWith(member.RoleIds); _confirmKick = _confirmBan = false; }
    private void ToggleMemberRole(Guid roleId, ChangeEventArgs args) { if (args.Value is true) _memberRoleIds.Add(roleId); else _memberRoleIds.Remove(roleId); }
    private async Task SaveMemberRolesAsync() => await RunAsync(async () =>
    {
        if (_selectedMember is null) return;
        await State.SetMemberRolesAsync(_selectedMember.AccountId, _memberRoleIds.ToArray());
        _selectedMember = State.Management?.Members.FirstOrDefault(value => value.AccountId == _selectedMember.AccountId);
    });
    private async Task KickSelectedAsync()
    {
        if (!_confirmKick) { _confirmKick = true; return; }
        await RunAsync(async () => { await State.KickMemberAsync(_selectedMember!.AccountId); _selectedMember = null; });
    }
    private async Task BanSelectedAsync()
    {
        if (!_confirmBan) { _confirmBan = true; return; }
        await RunAsync(async () => { await State.BanMemberAsync(_selectedMember!.AccountId, null); _selectedMember = null; });
    }
    private Task UnbanAsync(Guid accountId) => RunAsync(() => State.UnbanMemberAsync(accountId));
    private async Task SaveOverviewAsync() => await RunAsync(async () =>
    {
        var updated = await State.UpdateCommunityAsync(_communityName, _communityDescription);
        await OnCommunityUpdated.InvokeAsync(updated);
    });
    private async Task RefreshCommunityMediaAsync()
    {
        await Session.RefreshCommunitiesAsync();
        if (Session.Communities.FirstOrDefault(value => value.Id == Community.Id) is { } updated)
            await OnCommunityUpdated.InvokeAsync(updated);
    }
    private async Task CreateInviteAsync() => await RunAsync(async () =>
    {
        var expires = _inviteLifetime switch { "day" => DateTimeOffset.UtcNow.AddDays(1), "week" => DateTimeOffset.UtcNow.AddDays(7), _ => (DateTimeOffset?)null };
        var created = await State.CreateInviteAsync(expires, _inviteMaxUses);
        _createdInviteUrl = created.InviteUrl;
        _inviteCopied = false;
    });
    private async Task CopyInviteAsync()
    {
        if (string.IsNullOrWhiteSpace(_createdInviteUrl)) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _createdInviteUrl);
        _inviteCopied = true;
    }
    private Task RevokeInviteAsync(Guid inviteId) => RunAsync(() => State.RevokeInviteAsync(inviteId));
    private async Task RunAsync(Func<Task> action)
    {
        _error = null;
        try { await action(); }
        catch (Exception exception) { _error = exception.Message; }
        await InvokeAsync(StateHasChanged);
    }
    private static string PermissionLabel(CommunityPermission permission) => string.Concat(permission.ToString().Select((character, index) => index > 0 && char.IsUpper(character) ? $" {character}" : character.ToString()));
    private static string PermissionDescription(CommunityPermission permission) => permission switch
    {
        CommunityPermission.ManageChannels => "Create, edit, delete, move and organize channels and categories.",
        CommunityPermission.ManagePermissions => "Change channel/category permission overrides and private access.",
        CommunityPermission.ManageExpressions => "Create, rename and delete custom emoji and future Server expression assets.",
        _ => $"Grants {PermissionLabel(permission).ToLowerInvariant()} across this Server."
    };
    private static string Expiration(CommunityInviteDto invite) => invite.ExpiresAt is null ? "Never expires" : $"Expires {invite.ExpiresAt.Value.ToLocalTime():g}";
    private static string CommunityInitials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(value => char.ToUpperInvariant(value[0])));
    public async ValueTask DisposeAsync()
    {
        if (_roleSortModule is not null)
        {
            try { await _roleSortModule.InvokeVoidAsync("unwireRoleSorter", _roleList); await _roleSortModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _roleSortReference?.Dispose();
    }
}
