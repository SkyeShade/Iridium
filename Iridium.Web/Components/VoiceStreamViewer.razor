@using Iridium.Client.Core
@using Iridium.Protocol
@implements IAsyncDisposable
@inject ActiveVoiceSessionCoordinator Voice
@inject VoiceParticipantPreferencesService Preferences
@inject IJSRuntime JS
@inject ILogger<VoiceStreamViewer> Logger

@if (Voice.WatchedStream is { } stream)
{
    <section id="@_containerId" class="voice-stream-viewer @(Floating ? "floating" : null)" aria-label="Watching @stream.OwnerDisplayName's stream">
        <div class="stream-stage">
            <video id="@_elementId" autoplay playsinline></video>
            <div class="stream-toolbar floating-drag-handle">
                <div><strong>@stream.OwnerDisplayName</strong><span class="live-badge">LIVE</span><small>@KindLabel(stream.Kind)</small></div>
                <div class="toolbar-actions">
                    @if (stream.HasAudio)
                    {
                        <div class="stream-volume-control">
                        <button type="button" class="@(_audioMuted ? "selected" : null)"
                                title="@(_audioMuted ? "Unmute stream audio" : "Mute stream audio")"
                                aria-label="@(_audioMuted ? "Unmute shared stream audio" : "Mute shared stream audio")"
                                @onclick="ToggleStreamAudioAsync"><Icon Name="speaker" /></button>
                        <details>
                        <summary aria-label="Adjust shared stream volume">@_audioVolume%</summary>
                        <label title="Shared stream volume is local to this device">
                            <span class="sr-only">Shared stream volume</span>
                            <input type="range" min="0" max="300" step="5" value="@_audioVolume"
                                   aria-label="Shared stream volume" @oninput="SetStreamVolumeAsync" />
                            <output>@_audioVolume%</output>
                        </label>
                        </details>
                        </div>
                    }
                    else
                    {
                        <span class="no-audio" title="Audio availability depends on the selected source and browser."><Icon Name="speaker" /> No share audio</span>
                    }
                    @if (_fullscreenSupported)
                    {
                        <button type="button" title="Fullscreen" aria-label="View stream fullscreen"
                                @onclick="FullscreenAsync"><Icon Name="fullscreen" /></button>
                    }
                    @if (!Floating)
                    {
                        <button type="button" title="Minimize to floating viewer" @onclick="MinimizeAsync"><Icon Name="minus" /></button>
                    }
                    @if (stream.OwnerAccountId == Voice.LocalAccountId)
                    {
                        <button type="button" title="Choose a different screen, window, or tab"
                                aria-label="Switch shared source" @onclick="SwitchSharingAsync"><Icon Name="refresh" /></button>
                        <button type="button" title="Stop sharing" @onclick="StopSharingAsync"><Icon Name="screen" /></button>
                    }
                    <button type="button" title="Stop watching" @onclick="CloseAsync"><Icon Name="close" /></button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_error)) { <p class="stream-error">@_error</p> }
            @if (Floating)
            {
                <button type="button" class="floating-expand" title="Expand stream" @onclick="ExpandAsync"><Icon Name="fullscreen" /> Expand</button>
            }
        </div>
        @if (!Floating)
        {
        <div class="viewer-participants" aria-label="Voice participants">
            @if (Voice.Current?.Kind == ActiveVoiceSessionKind.DirectCall)
            {
                @foreach (var participant in Voice.DirectCalls.CurrentCall?.Participants ?? [])
                {
                    <div class="viewer-participant">
                        <span class="participant-avatar @(participant.IsSpeaking ? "speaking" : null)">
                            <ProfileAvatar AccountId="participant.AccountId" DisplayName="participant.DisplayName" Size="medium" Surface="base" />
                        </span>
                        <span>@participant.DisplayName</span>
                    </div>
                }
            }
            else
            {
                @foreach (var participant in Voice.CommunityVoice.CurrentRoom?.Participants ?? [])
                {
                    <div class="viewer-participant">
                        <span class="participant-avatar @(participant.Speaking ? "speaking" : null)">
                            <ProfileAvatar AccountId="participant.AccountId" DisplayName="participant.DisplayName"
                                           Presence="participant.Presence" Size="medium" Surface="base" />
                        </span>
                        <span>@participant.DisplayName</span>
                    </div>
                }
            }
        </div>
        <div class="viewer-controls">
            <button type="button" class="@(Voice.Current?.Muted == true ? "selected" : null)" @onclick="ToggleMuteAsync"><Icon Name="microphone" /> Mute</button>
            <button type="button" class="@(Voice.Current?.Deafened == true ? "selected" : null)" @onclick="ToggleDeafenAsync"><Icon Name="headphones" /> Deafen</button>
            <button type="button" @onclick="CloseAsync"><Icon Name="close" /> Stop Watching</button>
            <button type="button" class="leave" @onclick="LeaveAsync"><Icon Name="hangup" /> Leave Voice</button>
        </div>
        }
    </section>
}

@code {
    private readonly string _elementId = $"voice-stream-{Guid.NewGuid():N}";
    private readonly string _containerId = $"floating-stream-{Guid.NewGuid():N}";
    private Guid? _attachedStreamId;
    private bool _audioMuted;
    private int _audioVolume = 100;
    private bool _fullscreenSupported;
    private string? _error;
    private IJSObjectReference? _floatingModule;
    private IJSObjectReference? _floatingHandle;
    [Parameter] public bool Floating { get; set; }
    [Parameter] public EventCallback OnExpand { get; set; }
    [Parameter] public EventCallback OnMinimize { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var stream = Voice.WatchedStream;
        if (stream is null) return;
        if (_attachedStreamId == stream.StreamId)
        {
            var nextMuted = !stream.HasAudio || Voice.IsStreamAudioMuted(stream.StreamId);
            if (nextMuted != _audioMuted)
            {
                _audioMuted = nextMuted;
                await Voice.SetStreamAudioMutedAsync(_elementId, _audioMuted);
            }
            return;
        }
        try
        {
            if (_attachedStreamId is not null) await Voice.DetachWatchedStreamAsync(_elementId);
            _audioMuted = !stream.HasAudio || Voice.IsStreamAudioMuted(stream.StreamId);
            _audioVolume = (await Preferences.GetAsync(stream.OwnerAccountId)).ScreenShareVolumePercent;
            await Voice.AttachWatchedStreamAsync(_elementId, _audioVolume);
            _attachedStreamId = stream.StreamId;
            _error = null;
            var viewerModule = await JS.InvokeAsync<IJSObjectReference>("import",
                $"./js/streamViewerUi.js?build={Uri.EscapeDataString(MediaBuildInfo.Id)}");
            _fullscreenSupported = await viewerModule.InvokeAsync<bool>("supportsFullscreen", _elementId);
            await viewerModule.DisposeAsync();
            if (Floating && _floatingHandle is null)
            {
                _floatingModule ??= await JS.InvokeAsync<IJSObjectReference>("import",
                    $"./js/floatingStreamViewer.js?build={Uri.EscapeDataString(MediaBuildInfo.Id)}");
                _floatingHandle = await _floatingModule.InvokeAsync<IJSObjectReference>("initialize", _containerId);
            }
        }
        catch (Exception exception)
        {
            if (exception.Message.Contains("not initialized", StringComparison.OrdinalIgnoreCase) ||
                exception.Message.Contains("no longer active", StringComparison.OrdinalIgnoreCase))
            {
                _error = "Stream is no longer available.";
                await Voice.StopWatchingAsync();
            }
            else
            {
                Logger.LogDebug(exception, "Screen stream playback failed");
                _error = "Unable to play this stream.";
            }
        }
        await InvokeAsync(StateHasChanged);
    }
    private async Task SetStreamVolumeAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var value) || Voice.WatchedStream is not { } stream) return;
        _audioVolume = Math.Clamp(value, 0, 300);
        await Voice.SetStreamAudioVolumeAsync(_elementId, _audioVolume);
        await Preferences.SetScreenShareVolumeAsync(stream.OwnerAccountId, _audioVolume);
    }

    private async Task ToggleStreamAudioAsync()
    {
        _audioMuted = !_audioMuted;
        await Voice.SetStreamAudioMutedAsync(_elementId, _audioMuted);
    }
    private Task FullscreenAsync() => Voice.RequestStreamFullscreenAsync(_elementId);
    private Task ExpandAsync() => OnExpand.InvokeAsync();
    private Task MinimizeAsync()
    {
        if (OnMinimize.HasDelegate) return OnMinimize.InvokeAsync();
        Voice.MinimizeWatchedStream();
        return Task.CompletedTask;
    }
    private Task StopSharingAsync() => Voice.StopScreenShareAsync();
    private async Task SwitchSharingAsync()
    {
        try { _error = null; await Voice.SwitchScreenShareAsync(); }
        catch (Exception exception)
        {
            Logger.LogDebug(exception, "Screen share source could not be switched");
            _error = ScreenShareFailure.UserMessage(exception);
        }
    }
    private Task ToggleMuteAsync() => Voice.ToggleMuteAsync();
    private Task ToggleDeafenAsync() => Voice.ToggleDeafenAsync();
    private async Task CloseAsync()
    {
        await Voice.DetachWatchedStreamAsync(_elementId);
        _attachedStreamId = null;
        await Voice.StopWatchingAsync();
    }
    private async Task LeaveAsync()
    {
        await Voice.DetachWatchedStreamAsync(_elementId);
        await Voice.LeaveCurrentVoiceSessionAsync("stream viewer leave");
    }
    private static string KindLabel(VoicePublishedStreamKind kind) => kind switch
    {
        VoicePublishedStreamKind.Camera => "Camera",
        _ => "Screen Share"
    };
    public async ValueTask DisposeAsync()
    {
        try { if (_attachedStreamId is not null) await Voice.DetachWatchedStreamAsync(_elementId); } catch { }
        if (_floatingHandle is not null) { try { await _floatingHandle.InvokeVoidAsync("dispose"); } catch { } await _floatingHandle.DisposeAsync(); }
        if (_floatingModule is not null) await _floatingModule.DisposeAsync();
    }
}
