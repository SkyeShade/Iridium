@using System.Globalization
@using Iridium.Protocol
@inject NodeSession NodeSession
@inject ILogger<PostedVideo> Logger
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="posted-video" style="--video-aspect:@AspectRatio" @ref="_root">
    @if (Attachment.IsSpoiler && !_spoilerRevealed)
    {
        <button type="button" class="video-spoiler-cover" @onclick="Reveal" aria-label="Reveal spoiler video">
            Spoiler<br /><small>Click to reveal</small>
        </button>
    }
    else if (_source is not null)
    {
        <video src="@_source" controls preload="metadata" playsinline aria-label="Video attachment: @Attachment.OriginalFileName"></video>
    }
    else if (_failed)
    {
        <button type="button" class="video-state video-retry" @onclick="LoadAsync">Video unavailable<br /><small>Click to retry</small></button>
    }
    else
    {
        <div class="video-state" aria-label="Loading video metadata">Loading video...</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public required AttachmentDto Attachment { get; set; }
    private CancellationTokenSource? _loadCancellation;
    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<PostedVideo>? _selfReference;
    private Guid _loadedAttachmentId;
    private string? _source;
    private bool _failed;
    private bool _spoilerRevealed;
    private bool _visible;
    private string AspectRatio => Attachment.Width is > 0 && Attachment.Height is > 0
        ? $"{Attachment.Width.Value.ToString(CultureInfo.InvariantCulture)}/{Attachment.Height.Value.ToString(CultureInfo.InvariantCulture)}"
        : "16/9";

    protected override void OnParametersSet()
    {
        if (_loadedAttachmentId == Attachment.Id) return;
        _loadedAttachmentId = Attachment.Id;
        _source = null;
        _failed = false;
        _spoilerRevealed = false;
        CancelLoad();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/mediaEmbeds.js");
        _selfReference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("observeOnce", _root, _selfReference);
    }

    [JSInvokable]
    public async Task VideoBecameVisibleAsync()
    {
        _visible = true;
        if (!Attachment.IsSpoiler || _spoilerRevealed) await LoadAsync();
    }

    private void Reveal()
    {
        _spoilerRevealed = true;
        if (_visible) _ = LoadAsync();
    }

    private async Task LoadAsync()
    {
        CancelLoad();
        var source = _loadCancellation = new CancellationTokenSource();
        _failed = false;
        try
        {
            var access = await NodeSession.GetAttachmentPlaybackAccessAsync(Attachment.Id, source.Token);
            if (source.IsCancellationRequested || Attachment.Id != _loadedAttachmentId) return;
            _source = access.Url;
        }
        catch (OperationCanceledException) when (source.IsCancellationRequested) { }
        catch (Exception exception)
        {
            if (source.IsCancellationRequested) return;
            _failed = true;
            Logger.LogWarning(exception, "Could not obtain playback access for video attachment {AttachmentId}.", Attachment.Id);
        }
        await InvokeAsync(StateHasChanged);
    }

    private void CancelLoad()
    {
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
        _loadCancellation = null;
    }

    public async ValueTask DisposeAsync()
    {
        CancelLoad();
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("unobserve", _root); }
            catch (JSDisconnectedException) { }
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _selfReference?.Dispose();
    }
}
