@using Iridium.Protocol
@using Iridium.Web.Models

<ModalShell Title="Edit Profile" Size="large" OnClose="TryCloseAsync">
    <div class="profile-editor">
        <header>
            <span>PROFILE</span>
            <h1>Edit Profile</h1>
            <p>Changes are saved automatically when you close this window.</p>
        </header>
        <div class="editor-layout">
            <div class="fields">
                <EditableAvatar AccountId="Account.Id" AvatarRevision="Account.AvatarRevision" DisplayName="@_displayName"
                                Size="large" Surface="panel" OnEdit="OpenAvatarEditor"
                                Style="margin:0 0 1.25rem;box-shadow:0 0 0 1px var(--border)" />
                <label>Display Name <input @bind="_displayName" @bind:event="oninput" maxlength="64" /></label>
                <label>Pronouns <input @bind="_pronouns" @bind:event="oninput" maxlength="64" placeholder="Optional" /></label>
                <label class="about-field"><span>About Me</span><textarea class="iridium-textarea-scrollbar bio-input" @bind="_description" @bind:event="oninput" maxlength="400" rows="6" placeholder="Tell people a little about yourself"></textarea><small>@_description.Length / 400</small></label>
                <div class="readonly"><span>Public identity</span><strong>@PublicIdentity</strong></div>
                @if (!string.IsNullOrWhiteSpace(_error)) { <p class="error" role="alert">@_error</p> }
                @if (_saving) { <p class="saving">Saving profile…</p> }
            </div>
            <aside class="profile-preview">
                <ProfileIdentityCard AccountId="Account.Id" AvatarRevision="Account.AvatarRevision"
                                     BannerRevision="Account.BannerRevision"
                                     DisplayName="@_displayName" Identity="@PublicIdentity" Pronouns="@_pronouns"
                                     Description="@_description" Presence="PresenceVisibility.ToPublic(Account.PreferredPresence)"
                                     Editable="true" EditableBanner="true" OnEditAvatar="OpenAvatarEditor"
                                     OnEditBanner="OpenBannerEditor" />
            </aside>
        </div>
    </div>
</ModalShell>
@if (_avatarEditorOpen)
{
    <AvatarEditorModal Account="Account" OnClosed="() => _avatarEditorOpen = false" />
}
@if (_bannerEditorOpen)
{
    <BannerEditorModal Account="Account" DisplayName="@_displayName" PublicIdentity="@PublicIdentity"
                       Pronouns="@_pronouns" Description="@_description"
                       OnClosed="() => _bannerEditorOpen = false" />
}

@code {
    [Parameter, EditorRequired] public required NodeAccountDto Account { get; set; }
    [Parameter, EditorRequired] public required string PublicIdentity { get; set; }
    [Parameter, EditorRequired] public required Func<ProfileSubmission, Task<bool>> Save { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }
    private string _displayName = string.Empty;
    private string _pronouns = string.Empty;
    private string _originalDisplayName = string.Empty;
    private string _originalPronouns = string.Empty;
    private string _description = string.Empty;
    private string _originalDescription = string.Empty;
    private string? _error;
    private Guid? _loadedAccountId;
    private bool _saving;
    private bool _avatarEditorOpen;
    private bool _bannerEditorOpen;
    private Task OpenAvatarEditor() { _avatarEditorOpen = true; return Task.CompletedTask; }
    private Task OpenBannerEditor() { _bannerEditorOpen = true; return Task.CompletedTask; }

    protected override void OnParametersSet()
    {
        if (_loadedAccountId == Account.Id) return;
        _loadedAccountId = Account.Id;
        _displayName = _originalDisplayName = Account.DisplayName;
        _pronouns = _originalPronouns = Account.Pronouns ?? string.Empty;
        _description = _originalDescription = Account.Description ?? string.Empty;
        _error = null;
    }

    private async Task TryCloseAsync()
    {
        if (_saving) return;
        var displayName = _displayName.Trim();
        var pronouns = _pronouns.Trim();
        var description = _description.Trim();
        if (displayName.Length == 0) { _error = "Display Name is required."; return; }
        if (displayName == _originalDisplayName && pronouns == _originalPronouns && description == _originalDescription)
        {
            await OnClosed.InvokeAsync();
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            if (await Save(new ProfileSubmission(displayName, pronouns, description))) await OnClosed.InvokeAsync();
            else _error = "Your changes could not be saved. They are still available here to retry.";
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _saving = false; }
    }

}
