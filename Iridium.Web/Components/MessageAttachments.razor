@using Iridium.Protocol
@inject NodeSession NodeSession
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (Items.Count > 0)
{
    <div class="message-attachments">
        @foreach (var attachment in Items)
        {
            @if (IsInlineImage(attachment))
            {
                <PostedImage @key="attachment.Id" Attachment="attachment" DeliveryState="DeliveryState" />
            }
            else
            {
                <button type="button" class="message-file" @onclick="() => DownloadAsync(attachment)">
                    <span><Icon Name="file" /></span>
                    <span><strong>@attachment.OriginalFileName</strong><small>@AttachmentComposerService.FormatSize(attachment.SizeBytes)</small></span>
                    <span class="download-label">Download</span>
                </button>
            }
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<AttachmentDto>? Attachments { get; set; }
    [Parameter] public MessageDeliveryState DeliveryState { get; set; } = MessageDeliveryState.Confirmed;
    private IReadOnlyList<AttachmentDto> Items => Attachments ?? [];
    private IJSObjectReference? _module;

    private static bool IsInlineImage(AttachmentDto attachment) => attachment.ContentType.ToLowerInvariant() is
        "image/jpeg" or "image/png" or "image/gif" or "image/webp";

    private async Task DownloadAsync(AttachmentDto attachment)
    {
        var bytes = await NodeSession.DownloadAttachmentAsync(attachment.Id);
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/chat.js");
        await _module.InvokeVoidAsync("downloadBase64", attachment.OriginalFileName,
            attachment.ContentType, Convert.ToBase64String(bytes));
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
