@using System.Text.RegularExpressions
@using Iridium.Protocol
@using Iridium.Web.Models

<ModalShell Title="@(Channel is null ? "Create Channel" : "Channel Settings")" Size="compact" OnClose="OnCancel">
    <section class="settings-dialog create-channel-dialog">
        <header class="dialog-heading"><h2 id="channel-dialog-title">@(Channel is null ? "Create Channel" : "Channel Settings")</h2><p>@(Channel is null ? $"in {DestinationName}" : $"Configure this {_kind.ToString().ToLowerInvariant()} Channel.")</p></header>
        <div class="dialog-field"><span class="field-label">Channel Type</span><div class="channel-types" aria-label="Channel type">
            <button type="button" class="channel-type @(_kind == CommunityChannelKind.Text ? "selected" : null)" disabled="@(Channel is not null)" @onclick="() => _kind = CommunityChannelKind.Text"><Icon Name="channel" /><span><strong>Text</strong><small>Send messages, images, and files</small></span></button>
            <button type="button" class="channel-type @(_kind == CommunityChannelKind.Forum ? "selected" : null)" disabled="@(Channel is not null)" @onclick="() => _kind = CommunityChannelKind.Forum"><Icon Name="message" /><span><strong>Forum</strong><small>Organized, titled discussions</small></span></button>
            <button type="button" class="channel-type @(_kind == CommunityChannelKind.Voice ? "selected" : null)" disabled="@(Channel is not null)" @onclick="() => _kind = CommunityChannelKind.Voice"><Icon Name="speaker" /><span><strong>Voice</strong><small>Persistent joinable voice room</small></span></button>
        </div></div>
        <label class="dialog-field"><span class="field-label">Channel Name</span>
            <span class="channel-name-input"><Icon Name="@(_kind == CommunityChannelKind.Voice ? "speaker" : _kind == CommunityChannelKind.Forum ? "message" : "channel")" /><input value="@_name" @oninput="NameChanged" maxlength="100" autofocus placeholder="new-channel" /></span>
        </label>
        @if (Channel is not null)
        {
            <label class="dialog-field"><span class="field-label">Category</span>
                <select @bind="_categoryValue">
                    <option value="">Server root</option>
                    @foreach (var category in Categories.OrderBy(Breadcrumb))
                    {
                        <option value="@category.Id">@Breadcrumb(category)</option>
                    }
                </select>
            </label>
        }
        @if (Channel is not null && _kind == CommunityChannelKind.Forum)
        {
            <ForumTagSettings Channel="Channel" Community="Community"
                              AllowExternalEmoji="@Has(Channel.EffectivePermissions, CommunityPermission.UseExternalEmoji)"
                              RequireTag="_requireTag" RequireTagChanged="SetRequireTag" />
        }
        @if (!string.IsNullOrWhiteSpace(_validationError)) { <p class="field-hint error">@_validationError</p> }
        @if (!string.IsNullOrWhiteSpace(Error)) { <p class="error">@Error</p> }
        @if (_confirmDelete)
        {
            <div class="confirmation"><strong>Delete #@Channel!.Name?</strong><span>Messages in this Channel will also be removed. This cannot be undone.</span></div>
        }
        <footer class="dialog-actions">
            @if (Channel is not null) { <button type="button" class="danger" disabled="Busy" @onclick="DeleteAsync">@(_confirmDelete ? "Confirm Delete" : "Delete Channel")</button> }
            <span class="action-spacer"></span><button type="button" class="secondary" @onclick="OnCancel">Cancel</button>
            <button type="button" class="primary" disabled="@(Busy || !IsValid)" @onclick="SaveAsync">@(Channel is null ? "Create Channel" : "Save Changes")</button>
        </footer>
    </section>
</ModalShell>

@code {
    [Parameter] public CommunityChannelDto? Channel { get; set; }
    [Parameter, EditorRequired] public required CommunityDto Community { get; set; }
    [Parameter] public Guid? InitialCategoryId { get; set; }
    [Parameter] public IReadOnlyList<CommunityCategoryDto> Categories { get; set; } = [];
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool ConfirmDeleteInitially { get; set; }
    [Parameter] public EventCallback<ChannelSettingsSubmission> OnSave { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private Guid? _initializedId; private bool _initializedCreate; private string _name = string.Empty;
    private string _categoryValue = string.Empty; private bool _confirmDelete; private string? _validationError;
    private CommunityChannelKind _kind = CommunityChannelKind.Text;
    private bool _requireTag;
    private Guid? DestinationId => Channel?.CategoryId ?? InitialCategoryId;
    private CommunityCategoryDto? Destination => Categories.FirstOrDefault(value => value.Id == DestinationId);
    private string DestinationName => Destination is null ? "Server root" : Breadcrumb(Destination);
    private bool IsValid => Normalize(_name) is not null;
    private static bool Has(CommunityPermission value, CommunityPermission permission) =>
        (value & (CommunityPermission.Administrator | permission)) != 0;

    protected override Task OnParametersSetAsync()
    {
        var createChanged = Channel is null && !_initializedCreate;
        if (!createChanged && Channel?.Id == _initializedId) return Task.CompletedTask;
        _initializedId = Channel?.Id; _initializedCreate = Channel is null; _name = Channel?.Name ?? string.Empty;
        _categoryValue = DestinationId?.ToString() ?? string.Empty; _confirmDelete = ConfirmDeleteInitially;
        _kind = Channel?.Kind ?? CommunityChannelKind.Text;
        _requireTag = Channel?.RequireTag == true;
        Validate();
        return Task.CompletedTask;
    }
    private void NameChanged(ChangeEventArgs args) { _name = args.Value?.ToString() ?? string.Empty; Validate(); }
    private void Validate() => _validationError = _name.Length == 0 ? null : Normalize(_name) is null
        ? "Use 1–100 letters, numbers, underscores, or hyphens." : null;
    private Task SaveAsync()
    {
        var categoryId = Channel is null ? InitialCategoryId : Guid.TryParse(_categoryValue, out var parsed) ? parsed : null;
        return OnSave.InvokeAsync(new(Channel?.Id, _name, categoryId, _kind, _requireTag));
    }
    private Task DeleteAsync() { if (!_confirmDelete) { _confirmDelete = true; return Task.CompletedTask; } return OnDelete.InvokeAsync(Channel!.Id); }
    private void SetRequireTag(bool value) => _requireTag = value;
    private string Breadcrumb(CommunityCategoryDto category)
    {
        var parts = new Stack<string>(); var current = category; var seen = new HashSet<Guid>();
        while (seen.Add(current.Id))
        {
            parts.Push(current.Name);
            if (current.ParentCategoryId is not { } parent || Categories.FirstOrDefault(value => value.Id == parent) is not { } next) break;
            current = next;
        }
        return string.Join(" / ", parts);
    }
    private static string? Normalize(string value)
    {
        var name = Regex.Replace(value.Trim().ToLowerInvariant().Replace(' ', '-'), "-+", "-");
        return name.Length is >= 1 and <= 100 && Regex.IsMatch(name, "^[a-z0-9_-]+$") ? name : null;
    }
}
