@using Iridium.Client.Core
@using Iridium.Protocol
@using Iridium.Web.Models

<article class="forum-post-card @(Compact ? "compact" : null) @(Selected ? "selected" : null) @(Post.UnreadCount > 0 ? "unread" : null)"
         role="button" tabindex="0" data-forum-post-context-id="@Post.Id"
         @onclick="OpenAsync" @onkeydown="CardKeyDownAsync"
         @oncontextmenu="OpenContextMenuAsync" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
    <span class="forum-post-copy">
        @if (Post.Tags is { Count: > 0 })
        {
            <span class="forum-post-tags">@foreach (var tag in Post.Tags.OrderBy(value => value.SortOrder)) { <ForumTagChip Tag="tag" /> }</span>
        }
        <span class="forum-post-title">
            @if (Post.IsPinned) { <span title="Pinned"><Icon Name="pin" /></span> }
            <strong>@Post.Title</strong>
            @if (Post.IsLocked) { <span title="Locked"><Icon Name="lock" /></span> }
        </span>
        @if (Post.EmbedProvider is { } provider)
        {
            <span class="forum-post-document"><Icon Name="file" Size="13" /> @(provider == CommunityChannelEmbedProvider.GoogleSheets ? "Google Sheets" : "Google Docs")</span>
        }
        <div class="forum-post-byline">
            <strong class="forum-post-author display-name" style="@AuthorStyle">@Post.Author.DisplayName:</strong>
            @if (!string.IsNullOrWhiteSpace(Post.RootPreview))
            {
                <span class="forum-post-preview">
                    <MentionedMessageContent Content="@Post.RootPreview" Mentions="Post.RootMentions"
                                             CommunityId="Post.CommunityId" Compact="true" />
                </span>
            }
            else
            {
                <span class="forum-post-preview attachment-preview">Attachment</span>
            }
        </div>
        <small>@RelativeTime(Post.LastActivityAt) · @Post.ReplyCount @(Post.ReplyCount == 1 ? "reply" : "replies")</small>
    </span>
    @if (Post.UnreadCount > 0) { <span class="unread-count">@Post.UnreadCount</span> }
</article>

@code {
    [Parameter, EditorRequired] public required CommunityForumPostDto Post { get; set; }
    [Parameter] public CommunityManagementDto? CommunityManagement { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public EventCallback<CommunityForumPostDto> OnOpen { get; set; }
    [Parameter] public EventCallback<ForumPostContextRequest> OnContextMenu { get; set; }

    private Task OpenAsync() => OnOpen.InvokeAsync(Post);
    private Task OpenContextMenuAsync(MouseEventArgs args) =>
        OnContextMenu.InvokeAsync(new(Post, args.ClientX, args.ClientY));
    private Task CardKeyDownAsync(KeyboardEventArgs args) => args.Key is "Enter" or " " ? OpenAsync() : Task.CompletedTask;
    private string? AuthorColor => CommunityManagement?.Members
        .FirstOrDefault(member => member.AccountId == Post.Author.AccountId) is { } member
        ? CommunityRolePresentation.MemberColor(member, CommunityManagement.Roles)
        : null;
    private string? AuthorStyle => AuthorColor is null ? null : $"color:{AuthorColor}";

    private static string RelativeTime(DateTimeOffset at)
    {
        var age = DateTimeOffset.UtcNow - at;
        if (age < TimeSpan.FromMinutes(1)) return "just now";
        if (age < TimeSpan.FromHours(1)) return $"{(int)age.TotalMinutes}m ago";
        if (age < TimeSpan.FromDays(1)) return $"{(int)age.TotalHours}h ago";
        return at.ToLocalTime().ToString("MMM d");
    }
}
