@using Iridium.Protocol
@using Iridium.Web.Models
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<MessageComposer> Logger
@inject IAttachmentComposerService Attachments
@inject CommunityEmojiService Emojis
@inject EmojiPickerPreferencesService EmojiPreferences
@inject IMessageDraftStore Drafts
@inject ComposerActionModePreferencesService ActionModePreferences
@inject ComposerAvatarUsageService AvatarUsage
@inject NodeSession Session
@inject ProfileMediaService ProfileMedia

<div class="composer-wrap @Class">
    <div class="composer-shell" @ref="_composerShell">
        @if (!string.IsNullOrWhiteSpace(ReplyToDisplayName))
        {
            <div class="replying"><span>Replying to <strong class="display-name">@ReplyToDisplayName</strong></span><button title="Cancel reply" @onclick="OnCancelReply"><Icon Name="close" /></button></div>
        }
        @if (PendingAttachments.Count > 0)
        {
            <div class="attachment-tray" aria-label="Pending attachments">
                @foreach (var attachment in PendingAttachments)
                {
                    <div class="attachment-card @(attachment.IsImage ? "image-card" : "file-card") @(attachment.IsSpoiler ? "spoiler" : null)">
                        @if (attachment.PreviewUrl is { } preview)
                        {
                            <img src="@preview" alt="Preview of @attachment.FileName" />
                        }
                        else
                        {
                            <span class="file-icon"><Icon Name="file" /></span>
                        }
                        <span class="attachment-info"><strong title="@attachment.FileName">@attachment.FileName</strong><small>@AttachmentComposerService.FormatSize(attachment.SizeBytes)@(attachment.State == PendingAttachmentState.Uploading ? " · Uploading" : null)</small></span>
                        @if (attachment.IsSpoiler && attachment.IsImage) { <span class="spoiler-badge">Spoiler</span> }
                        <div class="attachment-actions">
                            <button type="button" class="spoiler-action @(attachment.IsSpoiler ? "active" : null)" title="@(attachment.IsSpoiler ? "Remove spoiler" : "Mark as spoiler")" aria-pressed="@attachment.IsSpoiler" @onclick="() => ToggleSpoiler(attachment.LocalId)"><Icon Name="eye" /></button>
                            <button type="button" class="remove-attachment" title="Remove @attachment.FileName" @onclick="() => RemoveAttachment(attachment.LocalId)"><Icon Name="close" /></button>
                        </div>
                    </div>
                }
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(_attachmentError))
        {
            <div class="attachment-error" role="alert">@_attachmentError</div>
        }
        <div class="composer-input-row @(HasSendableText ? "has-mobile-send" : null)">
            @if (CanAttachFiles)
            {
                <InputFile @key="_inputRevision" id="@FileInputId" style="position:absolute;width:1px;height:1px;opacity:0;overflow:hidden;pointer-events:none" tabindex="-1" OnChange="FilesSelectedAsync" multiple />
                <button @ref="_actionButton" type="button" class="attachment-button @(EffectiveActionMode == ComposerActionMode.Avatar ? "avatar-mode" : null)"
                        title="@ActionButtonTitle" aria-label="@ActionButtonLabel" @onclick="PerformComposerActionAsync"
                        @oncontextmenu="OpenActionModeMenu" @oncontextmenu:preventDefault @oncontextmenu:stopPropagation>
                    @if (EffectiveActionMode == ComposerActionMode.Avatar)
                    {
                        <ProfileAvatar @key="AccountId"
                                       AccountId="AccountId" AvatarPresetId="EffectiveComposerAvatarPresetId"
                                       AvatarRevision="@EffectiveComposerAvatarRevision" DisplayName="@EffectiveComposerDisplayName"
                                       BadgeMode="AvatarBadgeMode.None" Size="fill" Surface="raised" />
                    }
                    else { <Icon Name="plus" /> }
                </button>
            }
            <MarkdownSourceEditor Value="@_content" References="_emojiReferences" StandardReferences="_standardEmojiReferences"
                                  Available="_availableEmojis" Placeholder="@ComposerPlaceholder" AriaLabel="@ComposerPlaceholder"
                                  Class="composer-editor" ManageInterop="false" OnReady="ComposerEditorReadyAsync"
                                  Style="grid-column:2;--markdown-source-padding:calc((var(--composer-min-height) - 1.35em)/2) var(--composer-text-end-padding) calc((var(--composer-min-height) - 1.35em)/2) 0;--markdown-source-min-height:var(--composer-editor-min-height,var(--composer-min-height));--markdown-source-max-height:50dvh;--markdown-source-font:var(--chat-text-font);--markdown-source-size:var(--chat-text-size);--markdown-source-weight:var(--chat-text-weight);--markdown-source-line-height:var(--chat-line-height)" />
            <button @ref="_emojiButton" type="button" class="emoji-button" title="Emoji" aria-label="Emoji" @onclick="ToggleEmojiPicker"><Icon Name="emoji" /></button>
            @if (HasSendableText)
            {
                <button type="button" class="mobile-send-button" title="Send message" aria-label="Send message"
                        disabled="@(Busy || _submitting || RemainingCharacters < 0)" @onclick="SubmitFromKeyboardAsync"><Icon Name="send" /></button>
            }
            <span class="character-counter @(RemainingCharacters < 0 ? "over-limit" : null)" aria-label="@($"{RemainingCharacters} characters remaining")">@RemainingCharacters</span>
        </div>
        @if (_actionModeMenuOpen || _avatarPickerOpen)
        {
            <div class="composer-action-dismiss" aria-hidden="true" @onpointerdown="CloseActionPopups"></div>
        }
        @if (_actionModeMenuOpen)
        {
            <div class="composer-action-popup mode-popup" role="menu" aria-label="Composer action"
                 tabindex="-1" @onpointerdown:stopPropagation @onkeydown="HandleActionPopupKeyAsync">
                <button type="button" role="menuitemradio" aria-checked="@(_actionMode == ComposerActionMode.Attachment)"
                        @onclick="() => SelectActionModeAsync(ComposerActionMode.Attachment)">
                    <span class="action-option-icon"><Icon Name="file" /></span><span>Attachments</span>
                    @if (_actionMode == ComposerActionMode.Attachment) { <Icon Name="check" /> }
                </button>
                <button type="button" role="menuitemradio" aria-checked="@(_actionMode == ComposerActionMode.Avatar)"
                        @onclick="() => SelectActionModeAsync(ComposerActionMode.Avatar)">
                    <span class="action-option-icon avatar-option-icon"><ProfileAvatar AccountId="AccountId"
                        AvatarPresetId="EffectiveComposerAvatarPresetId" AvatarRevision="@EffectiveComposerAvatarRevision"
                        DisplayName="@EffectiveComposerDisplayName"
                        BadgeMode="AvatarBadgeMode.None" Size="fill" Surface="deep" /></span><span>Avatar</span>
                    @if (_actionMode == ComposerActionMode.Avatar) { <Icon Name="check" /> }
                </button>
            </div>
        }
        @if (_avatarPickerOpen)
        {
            <div class="composer-action-popup avatar-picker" role="dialog" aria-label="Quick avatar swap"
                 tabindex="-1" @onpointerdown:stopPropagation @onkeydown="HandleActionPopupKeyAsync">
                <header><span class="avatar-picker-section-label">Attachments</span><button type="button" aria-label="Close avatar picker" @onclick="CloseActionPopups"><Icon Name="close" /></button></header>
                <button type="button" class="avatar-picker-add-file" aria-label="Add files" @onclick="AddFileFromAvatarPickerAsync">
                    <span><Icon Name="plus" /></span><strong>Add file</strong>
                </button>
                <div class="avatar-picker-section-divider" aria-hidden="true"></div>
                <div class="avatar-picker-section-label avatar-picker-avatar-label">Choose avatar</div>
                <div class="avatar-picker-strip">
                        <div class="default-avatar-entry">
                            <button type="button" class="avatar-preset default-avatar @(DefaultAvatarSelected ? "selected" : null)"
                                    aria-label="@(DefaultAvatarSelected ? "Default avatar, current avatar" : "Default avatar")"
                                    aria-pressed="@DefaultAvatarSelected" disabled="@_avatarSwapBusy"
                                    @onclick="ActivateDefaultAvatarAsync">
                                @if (!UsesCommunityAvatarSelection && BaseAvatarPreset is { } defaultAvatar)
                                {
                                    <ProfileAvatar AccountId="AccountId" AvatarPresetId="defaultAvatar.Id"
                                                   AvatarRevision="defaultAvatar.Revision" DisplayName="@ActiveDisplayName"
                                                   BadgeMode="AvatarBadgeMode.None" Size="fill" Surface="deep" />
                                }
                                else
                                {
                                    <ProfileAvatar AccountId="AccountId" AvatarRevision="@ActiveAvatarRevision"
                                                   DisplayName="@ActiveDisplayName" BadgeMode="AvatarBadgeMode.None"
                                                   Size="fill" Surface="deep" />
                                }
                            </button>
                            <small>Default</small>
                        </div>
                        <span class="avatar-strip-divider" aria-hidden="true"></span>
                        <div @ref="_avatarPresetScroll" class="avatar-preset-scroll" aria-label="Saved avatars">
                            @if (_avatarPickerLoading)
                            {
                                <span class="avatar-picker-empty">Loading avatars…</span>
                            }
                            else if (OrderedQuickAvatarEntries.Count == 0)
                            {
                                <span class="avatar-picker-empty">No saved avatars</span>
                            }
                            else
                            {
                                @foreach (var entry in OrderedQuickAvatarEntries)
                                {
                                    var selected = entry.SelectionId == ActiveQuickAvatarSelectionId;
                                    <button type="button" class="avatar-preset @(selected ? "selected" : null)"
                                            aria-label="@AvatarPresetLabel(entry, selected)" aria-pressed="@selected"
                                            disabled="@_avatarSwapBusy" @onclick="() => SelectQuickAvatarAsync(entry.SelectionId)">
                                        <ProfileAvatar AccountId="AccountId" AvatarPresetId="entry.MediaPresetId"
                                                       AvatarRevision="entry.MediaRevision" DisplayName="entry.DisplayName"
                                                       BadgeMode="AvatarBadgeMode.None" Size="fill" Surface="deep" />
                                    </button>
                                }
                            }
                        </div>
                </div>
            </div>
        }
        @if (_emojiPickerOpen)
        {
            <EmojiPicker Community="Community" AccountId="AccountId" AllowExternalEmoji="CanUseExternalEmoji"
                         Anchor="_emojiButton" OnSelected="InsertEmojiAsync"
                         OnClose="CloseEmojiPicker" />
        }
        @if (Suggestions.Count > 0)
        {
            <div class="mention-suggestions" role="listbox" aria-label="Mention suggestions">
                @for (var index = 0; index < Suggestions.Count; index++)
                {
                    var suggestion = Suggestions[index];
                    <button type="button" class="mention-option @(index == _suggestionIndex ? "active" : null)"
                            role="option" aria-selected="@(index == _suggestionIndex)"
                            @onpointerdown:preventDefault="true" @onclick="() => AcceptSuggestionAsync(suggestion)">
                        @if (suggestion.Member is { } member)
                        {
                            <ProfileAvatar AccountId="member.AccountId" DisplayName="@member.DisplayName" Presence="@member.Presence" Size="small" Surface="panel" />
                            <span><span class="display-name" style="@(suggestion.Color is { } color ? $"color:{color}" : null)">@member.DisplayName</span><small>@member.Username</small></span>
                        }
                        else
                        {
                            <span class="mention-symbol">@@</span><span class="role-label" style="@(suggestion.Color is { } color ? $"color:{color}" : null)">@suggestion.Label</span>
                        }
                    </button>
                }
            </div>
        }
        else if (EmojiSuggestions.Count > 0)
        {
            <div class="mention-suggestions emoji-suggestions" role="listbox" aria-label="Emoji suggestions">
                @for (var index = 0; index < EmojiSuggestions.Count; index++)
                {
                    var suggestion = EmojiSuggestions[index];
                    <button type="button" class="mention-option emoji-option @(index == _suggestionIndex ? "active" : null)"
                            @onpointerdown:preventDefault="true" @onclick="() => AcceptEmojiSuggestionAsync(suggestion)">
                        @if (suggestion.Source is { } source) { <CommunityEmojiImage Emoji="source.Emoji" /> }
                        else if (suggestion.Standard is { } standard) { <StandardEmojiArtwork Glyph="@standard.Glyph" ArtworkKey="@standard.ArtworkKey" /> }
                        <span><strong>:@suggestion.Name:</strong>@if (suggestion.Source is { } communitySource) { <small>@communitySource.Community.Name</small> }</span>
                    </button>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required string ChannelName { get; set; }
    [Parameter] public string? ReplyToDisplayName { get; set; }
    [Parameter] public string? PlaceholderText { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public Func<string, Task<bool>>? Send { get; set; }
    [Parameter] public Func<MessageSubmission, Task<bool>>? SendRich { get; set; }
    [Parameter] public EventCallback OnSubmitted { get; set; }
    [Parameter] public EventCallback<bool> SendableContentChanged { get; set; }
    [Parameter] public EventCallback<bool> TypingActivityChanged { get; set; }
    [Parameter] public CommunityManagementDto? CommunityManagement { get; set; }
    [Parameter] public CommunityDto? Community { get; set; }
    [Parameter] public EventCallback OnCommunityProfileChanged { get; set; }
    [Parameter] public EventCallback OnAvatarSelectionSucceeded { get; set; }
    [Parameter] public EventCallback OnCancelReply { get; set; }
    [Parameter] public EventCallback OnEditLastMessage { get; set; }
    [Parameter] public bool CanAttachFiles { get; set; } = true;
    [Parameter] public bool CanUseExternalEmoji { get; set; }
    [Parameter] public bool CanMentionEveryone { get; set; }
    [Parameter, EditorRequired] public required string NodeAuthority { get; set; }
    [Parameter, EditorRequired] public required Guid AccountId { get; set; }
    [Parameter, EditorRequired] public required Guid ConversationId { get; set; }
    [Parameter, EditorRequired] public required string ConversationKind { get; set; }
    private string _content = string.Empty;
    private ElementReference _textarea;
    private ElementReference _composerShell;
    private ElementReference _actionButton;
    private ElementReference _avatarPresetScroll;
    private ElementReference _emojiButton;
    private IJSObjectReference? _module;
    private DotNetObjectReference<MessageComposer>? _selfReference;
    private bool _submitting;
    private bool _resizeAfterRender;
    private int? _focusCaretAfterRender;
    private int? _pickerCaret;
    private string? _renderedChannelName;
    private ComposerAttachmentKey? _attachmentKey;
    private ComposerAttachmentKey? _loadedLimitsKey;
    private string? _attachmentError;
    private int _inputRevision;
    private int _maxMessageCharacters = 10_000;
    private readonly List<CommunityMentionInput> _mentions = [];
    private int _mentionStart = -1;
    private int _mentionEnd = -1;
    private string _mentionQuery = string.Empty;
    private int _suggestionIndex;
    private int _emojiStart = -1, _emojiEnd = -1;
    private string _emojiQuery = string.Empty;
    private IReadOnlyList<EmojiSuggestion> _emojiSuggestions = [];
    private readonly EmojiAutocompleteIndex _emojiIndex = new();
    private CancellationTokenSource? _emojiSearchDebounce;
    private long _emojiSearchGeneration;
    private bool _emojiPickerOpen;
    private IReadOnlyList<AvailableCommunityEmoji> _availableEmojis = [];
    private readonly List<CommunityEmojiDraftReference> _emojiReferences = [];
    private readonly List<StandardEmojiDraftReference> _standardEmojiReferences = [];
    private readonly SemaphoreSlim _draftPersistenceGate = new(1, 1);
    private CancellationTokenSource? _draftDebounce;
    private Task? _draftLoadTask;
    private long _draftVersion;
    private bool _disposed;
    private ComposerActionMode _actionMode = ComposerActionMode.Attachment;
    private ComposerActionModeScope? _actionModeScope;
    private bool _actionModeMenuOpen;
    private bool _avatarPickerOpen;
    private bool _avatarPickerLoading;
    private bool _avatarSwapBusy;
    private bool _focusActionPopupAfterRender;
    private long _actionModeLoadVersion;
    private IReadOnlyList<AccountAvatarPresetDto> _avatarPresets = [];
    private IReadOnlyList<UserProfilePresetDto> _communityAvatarPresets = [];
    private ComposerAvatarUsageData _avatarUsage = new();
    private Guid? _activeAvatarPresetId;
    private Guid? _baseAvatarPresetId;
    private Guid? _loadedAvatarCommunityId;
    private CommunityProfileAssignmentDto? _localCommunityAssignment;
    private long _activeAvatarRevision;
    private string ComposerPlaceholder => PlaceholderText ?? $"Message #{ChannelName}";
    private string FileInputId => $"attachment-{ConversationKind}-{ConversationId:N}-{_inputRevision}";
    private IReadOnlyList<PendingAttachment> PendingAttachments => _attachmentKey is { } key ? Attachments.Get(key) : [];
    private int RemainingCharacters => _maxMessageCharacters - CommunityEmojiDraftCodec.CountCharacters(_content, _emojiReferences);
    private bool HasSendableText => !string.IsNullOrWhiteSpace(_content);
    private MessageDraftScope DraftScope => new(NodeAuthority, AccountId, ConversationKind, ConversationId);
    private string ActiveDisplayName => Session.Account?.Id == AccountId ? Session.Account.DisplayName : string.Empty;
    private long ActiveAvatarRevision => Math.Max(_activeAvatarRevision,
        Session.Account?.Id == AccountId ? Session.Account.AvatarRevision : 0);
    private bool IsDirectMessage => string.Equals(ConversationKind, "direct", StringComparison.OrdinalIgnoreCase);
    private ComposerActionMode EffectiveActionMode =>
        ComposerActionModePreferencesService.EffectiveMode(_actionMode, IsDirectMessage);
    private string ActionButtonTitle => EffectiveActionMode == ComposerActionMode.Attachment ? "Add files" : "Change avatar";
    private string ActionButtonLabel => IsDirectMessage
        ? "Add files"
        : $"{ActionButtonTitle}. Hold or right-click to change action.";
    private bool UsesCommunityAvatarSelection => Community is not null;
    private CommunityMemberDto? CurrentCommunityMember => CommunityManagement?.Members
        .FirstOrDefault(value => value.AccountId == AccountId);
    private Guid? ActiveCommunityProfilePresetId =>
        _localCommunityAssignment?.ProfilePresetId ?? CurrentCommunityMember?.ProfilePresetId;
    private Guid? EffectiveComposerAvatarPresetId => UsesCommunityAvatarSelection
        ? _localCommunityAssignment?.AvatarPresetId ?? CurrentCommunityMember?.ActiveChatAvatarPresetId
        : null;
    private long EffectiveComposerAvatarRevision => UsesCommunityAvatarSelection
        ? _localCommunityAssignment?.AvatarRevision ?? CurrentCommunityMember?.ActiveChatAvatarRevision ?? ActiveAvatarRevision
        : ActiveAvatarRevision;
    private string EffectiveComposerDisplayName => UsesCommunityAvatarSelection
        ? _localCommunityAssignment?.DisplayName ?? CurrentCommunityMember?.ActiveChatDisplayName ?? ActiveDisplayName
        : ActiveDisplayName;
    private Guid? ActiveQuickAvatarSelectionId => UsesCommunityAvatarSelection
        ? ActiveCommunityProfilePresetId
        : _activeAvatarPresetId;
    private IReadOnlyList<QuickAvatarEntry> OrderedQuickAvatarEntries =>
        ComposerAvatarUsageService.MostRecentlyUsedFirst(
            QuickAvatarEntries, _avatarUsage, value => value.SelectionId, value => value.UpdatedAt);
    private IEnumerable<QuickAvatarEntry> QuickAvatarEntries => UsesCommunityAvatarSelection
        ? _communityAvatarPresets.Select(value => new QuickAvatarEntry(value.Id, value.Avatar?.Id,
            value.Avatar?.Revision ?? ActiveAvatarRevision, value.DisplayName, value.UpdatedAt))
        : _avatarPresets.Where(value => value.Id != _baseAvatarPresetId).Select(value =>
            new QuickAvatarEntry(value.Id, value.Id, value.Revision,
                value.DisplayName ?? ActiveDisplayName, value.UpdatedAt));
    private AccountAvatarPresetDto? BaseAvatarPreset => _baseAvatarPresetId is { } id
        ? _avatarPresets.FirstOrDefault(value => value.Id == id)
        : null;
    private bool DefaultAvatarSelected => ActiveQuickAvatarSelectionId is null;

    protected override void OnInitialized()
    {
        Emojis.Changed += OnEmojiCollectionChanged;
        ProfileMedia.Changed += OnProfileMediaChanged;
    }

    protected override void OnParametersSet()
    {
        _attachmentKey = new(NodeAuthority, AccountId, ConversationKind, ConversationId);
        var actionScope = new ComposerActionModeScope(NodeAuthority, AccountId);
        if (_actionModeScope != actionScope)
        {
            _actionModeScope = actionScope;
            _actionMode = ComposerActionMode.Attachment;
            _activeAvatarPresetId = null;
            _baseAvatarPresetId = null;
            _activeAvatarRevision = 0;
            _avatarPresets = [];
            _communityAvatarPresets = [];
            _avatarUsage = new();
            CloseActionPopups();
            _actionModeLoadVersion++;
        }
        var communityId = Community?.Id;
        if (_loadedAvatarCommunityId != communityId)
        {
            _loadedAvatarCommunityId = communityId;
            _communityAvatarPresets = [];
            _localCommunityAssignment = null;
            if (_avatarPickerOpen) CloseActionPopups();
        }
        if (_localCommunityAssignment is { } local &&
            (local.CommunityId != communityId || CurrentCommunityMember?.ProfilePresetId == local.ProfilePresetId))
            _localCommunityAssignment = null;
        if (string.Equals(_renderedChannelName, ChannelName, StringComparison.Ordinal)) return;
        _renderedChannelName = ChannelName;
        _resizeAfterRender = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        _availableEmojis = await Emojis.GetAvailableAsync(Community);
        RebuildEmojiIndex();
        if (_actionModeScope is { } actionScope)
        {
            var version = _actionModeLoadVersion;
            try
            {
                var mode = await ActionModePreferences.GetAsync(actionScope);
                if (!_disposed && version == _actionModeLoadVersion && _actionModeScope == actionScope)
                    _actionMode = mode;
            }
            catch (Exception exception)
            {
                Logger.LogWarning(exception, "Could not restore the composer action for Account {AccountId}.", AccountId);
            }
        }
        if (_attachmentKey is not { } key || _loadedLimitsKey == key) return;
        try
        {
            var limits = await Attachments.GetLimitsAsync(key);
            if (_attachmentKey == key)
            {
                _maxMessageCharacters = limits.MaxMessageCharacters;
                _loadedLimitsKey = key;
            }
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Could not load message limits for Node {NodeAuthority}.", NodeAuthority);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_module is null) return;
        if (_resizeAfterRender)
        {
            _resizeAfterRender = false;
            await _module.InvokeVoidAsync("resizeComposer", _textarea);
        }
        if (_focusCaretAfterRender is { } caret)
        {
            _focusCaretAfterRender = null;
            await _module.InvokeVoidAsync("focusComposerAt", _textarea, caret);
        }
        if (_focusActionPopupAfterRender)
        {
            _focusActionPopupAfterRender = false;
            await _module.InvokeVoidAsync("focusComposerActionPopup", _composerShell,
                _actionModeMenuOpen ? ".mode-popup button[aria-checked='true']" : ".avatar-picker .avatar-preset.selected, .avatar-picker button");
        }
        if (_avatarPickerOpen) await _module.InvokeVoidAsync("wireHorizontalWheel", _avatarPresetScroll);
    }

    private async Task ComposerEditorReadyAsync(ElementReference editor)
    {
        _textarea = editor;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/chat.js");
        _selfReference ??= DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("wireComposer", _textarea, _selfReference, _composerShell);
        await _module.InvokeVoidAsync("wireComposerActionButton", _actionButton, _selfReference, !IsDirectMessage);
        await EnsureDraftLoadedAsync();
        await SendableContentChanged.InvokeAsync(HasSendableContent);
        _resizeAfterRender = false;
    }

    [JSInvokable]
    public async Task SubmitFromKeyboardAsync()
    {
        if (Busy || _submitting)
        {
            Logger.LogDebug("Ignored a keyboard submission while the composer for channel {ChannelName} was busy.", ChannelName);
            return;
        }
        if (RemainingCharacters < 0)
        {
            _attachmentError = $"Shorten the message by {-RemainingCharacters:N0} characters before sending.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_content) && PendingAttachments.Count == 0) return;

        _submitting = true;
        try
        {
            var content = CommunityEmojiDraftCodec.SerializeDocument(_content, _emojiReferences,
                _standardEmojiReferences);
            var mentions = _mentions.Select(value => value with
            {
                Start = CommunityEmojiDraftCodec.MapDocumentPositionToSerialized(value.Start, _emojiReferences,
                    _standardEmojiReferences)
            }).ToArray();
            var localAttachments = _attachmentKey is { } key ? Attachments.LocalDtos(key) : [];
            var uploadOperation = _attachmentKey is { } uploadKey && localAttachments.Count > 0
                ? Attachments.CreateUploadOperation(uploadKey)
                : null;
            var succeeded = SendRich is not null
                ? await SendRich(new(content, mentions, localAttachments, uploadOperation))
                : Send is not null && await Send(content);
            if (succeeded)
            {
                CancelDraftDebounce();
                _draftVersion++;
                _content = string.Empty;
                _mentions.Clear();
                _emojiReferences.Clear();
                _standardEmojiReferences.Clear();
                await TypingActivityChanged.InvokeAsync(false);
                if (_module is not null) await _module.InvokeVoidAsync("clearComposer", _textarea);
                await RemoveStoredDraftAsync();
                CloseSuggestions();
                _resizeAfterRender = true;
                if (_attachmentKey is { } sentKey) Attachments.Clear(sentKey);
                _attachmentError = null;
                await SendableContentChanged.InvokeAsync(false);
                await OnSubmitted.InvokeAsync();
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unexpected composer submission failure in channel {ChannelName}.", ChannelName);
            _attachmentError = exception.GetBaseException().Message;
        }
        finally
        {
            _submitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task EditLastMessageFromKeyboardAsync()
    {
        if (!string.IsNullOrEmpty(_content) || Suggestions.Count > 0 || EmojiSuggestions.Count > 0) return;
        await OnEditLastMessage.InvokeAsync();
    }

    private async Task FilesSelectedAsync(InputFileChangeEventArgs args)
    {
        if (_attachmentKey is not { } key) return;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/chat.js");
            var metadata = await _module.InvokeAsync<BrowserImageMetadata[]>("analyzeComposerFiles", _composerShell);
            var result = await Attachments.AddAsync(key, args.GetMultipleFiles(100), metadata);
            _attachmentError = result.Error;
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Could not add selected attachments.");
            _attachmentError = exception.GetBaseException().Message;
        }
        _inputRevision++;
        _focusCaretAfterRender = _pickerCaret ?? _content.Length;
        _pickerCaret = null;
        await SendableContentChanged.InvokeAsync(HasSendableContent);
