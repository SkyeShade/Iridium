            .Select(value => new CommunityEmojiDraftReference(value.Start, 1, value.EmojiId!.Value, value.Name,
                value.CommunityId!.Value)));
        _standardEmojiReferences.Clear();
        _standardEmojiReferences.AddRange(snapshot.Tokens.Where(value => value.StandardArtworkKey is not null && value.Glyph is not null)
            .Select(value => new StandardEmojiDraftReference(value.Start, 1, value.StandardArtworkKey!, value.Glyph!,
                value.Name)));
        if (scheduleDraft) ScheduleDraftPersistence();
    }

