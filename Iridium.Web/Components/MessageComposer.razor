        try
        {
            if (_draftLoadTask is not null)
            {
                await _draftLoadTask;
                await PersistDraftAsync();
            }
        }
        catch (Exception exception) when (exception is not JSDisconnectedException)
        {
            Logger.LogWarning(exception, "Could not flush the local draft for {ConversationKind} {ConversationId}.",
                ConversationKind, ConversationId);
        }
        _disposed = true;
        Emojis.Changed -= OnEmojiCollectionChanged;
        ProfileMedia.Changed -= OnProfileMediaChanged;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unwireComposerActionButton", _actionButton);
                await _module.InvokeVoidAsync("unwireComposer", _textarea);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _selfReference?.Dispose();
    }

    private Task EnsureDraftLoadedAsync() => _draftLoadTask ??= RestoreDraftAsync();

    private async Task RestoreDraftAsync()
    {
        try
        {
            var scope = DraftScope;
            var content = await Drafts.LoadAsync(scope);
            if (_disposed || scope != DraftScope || string.IsNullOrEmpty(content) || !string.IsNullOrEmpty(_content) ||
                _module is null) return;
            var snapshot = await _module.InvokeAsync<ComposerDocumentSnapshot>("setComposerText", _textarea, content);
            ApplySnapshot(snapshot, scheduleDraft: false);
            await ResolveCompletedEmojisAsync();
            await ResolveStandardEmojisAsync(restoreFocus: false);
            _resizeAfterRender = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception) when (exception is not JSDisconnectedException)
        {
            Logger.LogWarning(exception, "Could not restore the local draft for {ConversationKind} {ConversationId}.",
                ConversationKind, ConversationId);
        }
    }

    private void ScheduleDraftPersistence()
    {
        if (_disposed) return;
        CancelDraftDebounce();
        var version = ++_draftVersion;
        _draftDebounce = new();
        _ = PersistDraftAfterDelayAsync(version, _draftDebounce.Token);
    }

    private async Task PersistDraftAfterDelayAsync(long version, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(300), cancellationToken);
            if (version == _draftVersion) await PersistDraftAsync(version, cancellationToken);
        }
        catch (OperationCanceledException) { }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Could not persist the local draft for {ConversationKind} {ConversationId}.",
                ConversationKind, ConversationId);
        }
    }

    private async Task PersistDraftAsync(long? expectedVersion = null, CancellationToken cancellationToken = default)
    {
        var scope = DraftScope;
        var source = CommunityEmojiDraftCodec.SerializeDraftSource(_content, _emojiReferences, _standardEmojiReferences);
        await _draftPersistenceGate.WaitAsync(cancellationToken);
        try
        {
            if (expectedVersion is not null && expectedVersion != _draftVersion) return;
            if (string.IsNullOrWhiteSpace(source)) await Drafts.RemoveAsync(scope, cancellationToken);
            else await Drafts.SaveAsync(scope, source, cancellationToken);
        }
        finally { _draftPersistenceGate.Release(); }
    }

    private async Task RemoveStoredDraftAsync()
    {
        await _draftPersistenceGate.WaitAsync();
        try { await Drafts.RemoveAsync(DraftScope); }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Could not clear the sent local draft for {ConversationKind} {ConversationId}.",
                ConversationKind, ConversationId);
        }
        finally { _draftPersistenceGate.Release(); }
    }

    private void CancelDraftDebounce()
    {
        _draftDebounce?.Cancel();
        _draftDebounce?.Dispose();
        _draftDebounce = null;
    }

    private void OnEmojiCollectionChanged(Guid unusedCommunityId) => _ = InvokeAsync(async () =>
    {
        _availableEmojis = await Emojis.GetAvailableAsync(Community);
        RebuildEmojiIndex();
        StateHasChanged();
    });

    private void OnProfileMediaChanged(Guid accountId)
    {
        if (accountId != AccountId) return;
        _ = InvokeAsync(async () =>
        {
            if (_avatarPickerOpen) await LoadAvatarPresetsAsync();
            StateHasChanged();
        });
    }
}
