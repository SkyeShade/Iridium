    private async Task AcceptEmojiSuggestionAsync(EmojiSuggestion suggestion)
    {
        if (_emojiStart < 0) return;
        if (_module is null) return;
        ComposerDocumentSnapshot snapshot;
        if (suggestion.Source is { } source)
        {
            var mediaUrl = await Emojis.GetMediaDataUrlAsync(source.Emoji);
            if (mediaUrl is null) return;
            snapshot = await _module.InvokeAsync<ComposerDocumentSnapshot>("insertComposerEmoji", _textarea,
                new ComposerEmojiToken(0, source.Emoji.Id, source.Emoji.Name, source.Community.Id, mediaUrl,
                    Math.Max(1, source.Emoji.Width), Math.Max(1, source.Emoji.Height)),
                _emojiStart, _emojiEnd, false);
        }
        else
            snapshot = await _module.InvokeAsync<ComposerDocumentSnapshot>("insertComposerEmoji", _textarea,
                StandardToken(suggestion.Standard!.Glyph, suggestion.Standard.Name, suggestion.Standard.ArtworkKey),
                _emojiStart, _emojiEnd, false);
        ApplySnapshot(snapshot);
        await TypingActivityChanged.InvokeAsync(_content.Length > 0);
        await RecordEmojiUsageAsync(suggestion.Source is { } customSource
            ? new($":{customSource.Emoji.Name}:", customSource.Emoji.Name, customSource.Emoji.Id,
                customSource.Community.Id)
            : new(suggestion.Standard!.Glyph, suggestion.Standard.Name,
                StandardArtworkKey: suggestion.Standard.ArtworkKey));
        ClearEmojiSuggestions(); _resizeAfterRender = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ResolveStandardEmojisAsync(bool restoreFocus = true)
    {
        if (_module is null) return;
        var desiredCaret = await _module.InvokeAsync<int>("composerCaret", _textarea);
        var replaced = false;
        while (true)
        {
            StandardEmoji? match = null;
            var start = -1;
            for (var position = 0; position < _content.Length;)
            {
                if (_content[position] == CommunityEmojiDraftCodec.ObjectReplacementCharacter)
                {
                    position++;
                    continue;
                }
                match = StandardEmojiCatalog.MatchAt(_content, position);
                if (match is not null) { start = position; break; }
                position += System.Text.Rune.GetRuneAt(_content, position).Utf16SequenceLength;
            }
            if (match is null) break;
            var snapshot = await _module.InvokeAsync<ComposerDocumentSnapshot>("insertComposerEmoji", _textarea,
                StandardToken(match.Glyph, match.Name, match.ArtworkKey), start, start + match.Glyph.Length, false);
            if (start < desiredCaret) desiredCaret += 1 - match.Glyph.Length;
            ApplySnapshot(snapshot);
            replaced = true;
            await RecordEmojiUsageAsync(new(match.Glyph, match.Name, StandardArtworkKey: match.ArtworkKey));
        }
        if (replaced && restoreFocus)
        {
            await _module.InvokeVoidAsync(
                "focusComposerAt",
                _textarea,
                Math.Clamp(desiredCaret, 0, _content.Length));
        }
    }

