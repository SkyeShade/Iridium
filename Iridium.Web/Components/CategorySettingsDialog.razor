@using Iridium.Protocol
@using Iridium.Web.Models

<div class="modal-backdrop" @onclick="OnCancel">
    <section class="settings-dialog" @onclick:stopPropagation="true">
        <header><div><h2>@(Category is null ? (InitialParentCategoryId is null ? "Create Category" : "Create Subcategory") : "Category Settings")</h2><p>@(InitialParentCategoryId is null ? "Categories organize this Server's channels." : $"in {ParentName}")</p></div><button class="icon-button" title="Close" @onclick="OnCancel"><Icon Name="close" /></button></header>
        <label>Category name<input @bind="_name" maxlength="100" autofocus /></label>
        @if (!string.IsNullOrWhiteSpace(Error)) { <p class="error">@Error</p> }
        @if (_confirmDelete)
        {
            <div class="confirmation"><strong>Delete @Category!.Name?</strong><span>The Category must be empty before it can be deleted.</span></div>
        }
        <footer>
            @if (Category is not null)
            {
                <button class="danger" disabled="Busy" @onclick="DeleteAsync">@(_confirmDelete ? "Confirm Delete" : "Delete Category")</button>
            }
            <span></span><button class="secondary" @onclick="OnCancel">Cancel</button>
            <button class="primary" disabled="@(Busy || string.IsNullOrWhiteSpace(_name))" @onclick="SaveAsync">@(Category is null ? "Create" : "Save Changes")</button>
        </footer>
    </section>
</div>

@code {
    [Parameter] public CommunityCategoryDto? Category { get; set; }
    [Parameter] public Guid? InitialParentCategoryId { get; set; }
    [Parameter] public string? ParentName { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool ConfirmDeleteInitially { get; set; }
    [Parameter] public EventCallback<CategorySettingsSubmission> OnSave { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private Guid? _initializedId;
    private bool _initializedCreate;
    private string _name = string.Empty;
    private bool _confirmDelete;

    protected override void OnParametersSet()
    {
        var createChanged = Category is null && !_initializedCreate;
        if (!createChanged && Category?.Id == _initializedId) return;
        _initializedId = Category?.Id; _initializedCreate = Category is null;
        _name = Category?.Name ?? string.Empty; _confirmDelete = ConfirmDeleteInitially;
    }

    private Task SaveAsync() => OnSave.InvokeAsync(new CategorySettingsSubmission(Category?.Id, _name, InitialParentCategoryId));
    private Task DeleteAsync()
    {
        if (!_confirmDelete) { _confirmDelete = true; return Task.CompletedTask; }
        return OnDelete.InvokeAsync(Category!.Id);
    }
}
