@implements IAsyncDisposable
@using Iridium.Protocol
@inject EmojiDetailPopupCoordinator Coordinator
@inject IJSRuntime JS

@if (Coordinator.Current is { } state)
{
    <div class="emoji-detail-layer">
        <section @ref="_popup" class="emoji-detail-popup" role="dialog" aria-label="Emoji details">
            @if (state.Emoji.CustomEmoji is { } custom)
            {
                <CommunityEmojiImage Emoji="custom" Class="detail-emoji" />
            }
            else if (state.Emoji.ArtworkKey is { } artworkKey)
            {
                <StandardEmojiArtwork ArtworkKey="@artworkKey" Glyph="@state.Emoji.Glyph" Class="detail-emoji" />
            }
            <strong>:@state.Emoji.Alias:</strong>
            @if (state.Emoji.CustomEmoji is not null)
            {
                @if (state.Emoji.SourceCommunity is { } community)
                {
                    <div class="emoji-source">
                        @if (CommunityAvatarState(community) is { } avatar)
                        {
                            <span class="source-avatar"><AvatarCroppedPreview State="avatar" /></span>
                        }
                        <span>From @community.Name</span>
                    </div>
                }
                else
                {
                    <p class="emoji-unavailable">This emoji is from a server that is either invite-only or unavailable.</p>
                }
            }
        </section>
    </div>
}

@code {
    private ElementReference _popup;
    private IJSObjectReference? _module;
    private DotNetObjectReference<EmojiDetailPopup>? _self;
    private bool _positionPending;

    protected override void OnInitialized()
    {
        Coordinator.Changed += PopupChanged;
    }

    private void PopupChanged() => _ = InvokeAsync(async () =>
    {
        _positionPending = Coordinator.Current is not null;
        if (!_positionPending && _module is not null) await _module.InvokeVoidAsync("close");
        StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_positionPending || Coordinator.Current is not { } state) return;
        _positionPending = false;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/emojiDetailPopup.js");
        _self ??= DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("open", state.Anchor, state.ClientX, state.ClientY, _popup, _self);
    }

    [JSInvokable]
    public void CloseFromBrowser() => Coordinator.Close();

    private static ProfileMediaEditState? CommunityAvatarState(CommunityDto community) => community.AvatarUrl is null
        ? null : new AvatarEditState(community.AvatarUrl, Math.Max(1, community.AvatarWidth), Math.Max(1, community.AvatarHeight),
            760, 1000, 1000, Math.Max(1, community.AvatarZoom), community.AvatarCropX, community.AvatarCropY);

    public async ValueTask DisposeAsync()
    {
        Coordinator.Changed -= PopupChanged;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("close"); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
}
