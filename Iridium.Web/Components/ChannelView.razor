@using Iridium.Client.Core
@using Iridium.Protocol
@using Iridium.Web.Models
@implements IDisposable
@inject ChannelMessagingSession Messaging
@inject NodeSession Session
@inject ILogger<ChannelView> Logger
@inject IWebAssemblyHostEnvironment HostEnvironment

<section class="channel-view">
    @if (_loading && VisibleMessages.Count == 0)
    {
        <div class="channel-status">Loading message history...</div>
    }
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="channel-error">@_error</div>
    }
    <div class="message-region">
        <MessageList @key="Channel.Id" @ref="_messageList" Messages="VisibleMessages" CurrentAccountId="CurrentAccountId" CanManage="CanManageMessages"
                     NodeAuthority="@NodeAuthority" CommunityManagement="CommunityManagement"
                     OptimisticCommunityPresentations="_optimisticCommunityPresentations"
                     OnEditProfile="OnEditProfile" OnEditAvatars="OnEditAvatars"
                     OnCommunityProfileChanged="OnCommunityProfileChanged" OnMessage="OnMessage" OnMemberRolesChanged="OnMemberRolesChanged"
                     OnMention="MentionMemberAsync"
                     OnReply="BeginReply" Edit="EditMessageAsync" OnDelete="DeleteMessageAsync"
                     OnRetryLocal="RetryMessageAsync" OnRemoveLocal="RemoveLocalMessage"
                     OnEditCompleted="FocusComposerAfterEditAsync"
                     RootMessageId="RootMessageId"
                     WindowRevision="Messaging.WindowRevision" ReconciliationRevision="Messaging.RecentReconciliationRevision" FollowLatest="_isPinnedToLatest"
                     TargetMessageId="@(Messaging.WindowMode == MessageWindowMode.SearchTarget ? _loadedTargetMessageId : null)"
                     OnLoadOlder="LoadOlderAsync" OnViewportStateChanged="ViewportStateChanged" />
        @if (ShowJumpToLatest)
        {
            <button class="jump-latest" @onclick="JumpToLatestAsync">Jump to Latest</button>
        }
    </div>
    @if (CanSend)
    {
        <div class="composer-region">
            <MessageComposer @ref="_composer" ChannelName="@Channel.Name" ReplyToDisplayName="@(_replyTo?.Author.DisplayName)" Busy="@_sending"
                             Community="Community" CommunityManagement="CommunityManagement" SendRich="SendMessageAsync" OnCancelReply="CancelReplyAsync"
                             OnCommunityProfileChanged="OnCommunityProfileChanged"
                             CanAttachFiles="CanAttachFiles" CanMentionEveryone="CanMentionEveryone"
                             OnEditLastMessage="EditLastOwnMessageAsync"
                             NodeAuthority="@NodeAuthority" AccountId="@CurrentAccountId" ConversationKind="@DraftConversationKind" ConversationId="@(DraftConversationId ?? Channel.Id)" />
        </div>
    }
    else if (ShowReadOnlyNotice)
    {
        <div class="composer-region read-only">You do not have permission to send messages in this Server.</div>
    }
</section>

@code {
    [Parameter, EditorRequired] public required CommunityDto Community { get; set; }
    [Parameter, EditorRequired] public required CommunityChannelDto Channel { get; set; }
    [Parameter, EditorRequired] public required Guid CurrentAccountId { get; set; }
    [Parameter] public bool CanManageMessages { get; set; }
    [Parameter] public bool CanSend { get; set; } = true;
    [Parameter] public bool CanAttachFiles { get; set; } = true;
    [Parameter] public bool CanMentionEveryone { get; set; }
    [Parameter] public string DraftConversationKind { get; set; } = "channel";
    [Parameter] public Guid? DraftConversationId { get; set; }
    [Parameter] public Guid? RootMessageId { get; set; }
    [Parameter] public bool ShowReadOnlyNotice { get; set; } = true;
    [Parameter, EditorRequired] public required string NodeAuthority { get; set; }
    [Parameter] public CommunityManagementDto? CommunityManagement { get; set; }
    [Parameter] public EventCallback OnEditProfile { get; set; }
    [Parameter] public EventCallback OnEditAvatars { get; set; }
    [Parameter] public EventCallback OnCommunityProfileChanged { get; set; }
    [Parameter] public EventCallback<Guid> OnMessage { get; set; }
    [Parameter] public EventCallback<CommunityMemberRolesChange> OnMemberRolesChanged { get; set; }
    [Parameter] public Guid? TargetMessageId { get; set; }
    [Parameter] public long FocusRequest { get; set; }
    [Parameter] public EventCallback<long> OnFocusConsumed { get; set; }
    [Parameter] public bool IsMobileLayout { get; set; }
    private Guid? _loadedChannelId;
    private ChannelMessageDto? _replyTo;
    private readonly Dictionary<Guid, OptimisticCommunityAuthorPresentation> _optimisticCommunityPresentations = [];
    private readonly Queue<Guid> _optimisticPresentationOrder = [];
    private AccountAvatarPresetDto? _activeDefaultPfp;
    private Guid? _defaultPfpAccountId;
    private long _defaultPfpAccountRevision = -1;
    private Task? _defaultPfpLoad;
    private MessageComposer? _composer;
    private MessageList? _messageList;
    private Guid? _loadedTargetMessageId;
    private bool _isPinnedToLatest = true;
    private bool _shouldShowJumpToLatest;
    private bool _loading;
    private bool _sending;
    private bool _disposed;
    private bool _focusAfterRender;
    private long _consumedFocusRequest;
    private long _historyLoadGeneration;
    private string? _error;
    private IReadOnlyList<ChannelMessageDto> VisibleMessages => Messaging.MessagesFor(Community.Id, Channel.Id);

    protected override void OnInitialized() => Messaging.Changed += MessagesChanged;

    protected override void OnParametersSet()
    {
        if (IsMobileLayout)
        {
            _focusAfterRender = false;
            _consumedFocusRequest = Math.Max(_consumedFocusRequest, FocusRequest);
        }
        else if (FocusRequest > _consumedFocusRequest) _focusAfterRender = true;
        if (_loadedChannelId == Channel.Id && _loadedTargetMessageId == TargetMessageId) return;
        if (_loadedChannelId is not null && _loadedChannelId != Channel.Id)
        {
            _optimisticCommunityPresentations.Clear();
            _optimisticPresentationOrder.Clear();
        }
        _replyTo = null;
        _error = null;
        _loading = true;
        _loadedChannelId = Channel.Id;
        _loadedTargetMessageId = TargetMessageId;
        _isPinnedToLatest = TargetMessageId is null;
        _shouldShowJumpToLatest = TargetMessageId is not null;
        _ = EnsureDefaultPfpIdentityAsync();
        var generation = ++_historyLoadGeneration;
        _ = HydrateHistoryAsync(Community.Id, Channel.Id, TargetMessageId, generation);
    }

    private async Task HydrateHistoryAsync(Guid communityId, Guid channelId, Guid? targetMessageId, long generation)
    {
        try
        {
            await Messaging.OpenChannelAsync(communityId, channelId);
            if (targetMessageId is { } target) await Messaging.OpenChannelAroundAsync(communityId, channelId, target);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not open Community {CommunityId} channel {ChannelId}.", communityId, channelId);
            if (IsCurrentHistoryLoad(communityId, channelId, generation))
                _error = FailureMessage(exception, "Channel loading failed", "This channel could not be opened.");
        }
        finally
        {
            if (IsCurrentHistoryLoad(communityId, channelId, generation))
            {
                _loading = false;
                await RenderAsync();
            }
        }
    }

    private bool IsCurrentHistoryLoad(Guid communityId, Guid channelId, long generation) => !_disposed &&
        generation == _historyLoadGeneration && Community.Id == communityId && Channel.Id == channelId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusAfterRender || IsMobileLayout) return;
        _focusAfterRender = false;
        _consumedFocusRequest = FocusRequest;
        if (_composer is not null) await _composer.FocusAsync();
        await OnFocusConsumed.InvokeAsync(FocusRequest);
    }

    private async Task FocusComposerAfterEditAsync()
    {
        if (IsMobileLayout) return;
        _focusAfterRender = true;
        await InvokeAsync(StateHasChanged);
    }

    private void MessagesChanged() => _ = RenderFromRealtimeAsync();
    private async Task BeginReply(ChannelMessageDto message)
    {
        _replyTo = message;
        await RenderAsync();
        if (_composer is not null) await _composer.FocusAsync();
    }
    private async Task CancelReplyAsync()
    {
        _replyTo = null;
        await RenderAsync();
        if (_composer is not null) await _composer.FocusAsync();
    }
    private async Task MentionMemberAsync(CommunityMemberDto member)
    {
        if (_composer is not null) await _composer.InsertMentionAsync(member);
    }

    private async Task<bool> SendMessageAsync(MessageSubmission submission)
    {
        if (_sending)
        {
            Logger.LogDebug("Ignored a duplicate message submission while channel {ChannelId} was sending.", Channel.Id);
            return false;
        }

        if (Messaging.CommunityId != Community.Id || Messaging.ChannelId != Channel.Id)
        {
            Logger.LogWarning("Rejected a message submission because the active realtime channel did not match {CommunityId}/{ChannelId}.", Community.Id, Channel.Id);
            _error = "The channel is still connecting. Please try again.";
            return false;
        }

        _sending = true;
        _error = null;
        await RenderAsync();
        try
        {
            var smooth = ShowJumpToLatest;
            _messageList?.PrepareUserLatestTransition(smooth);
            var currentMember = CommunityManagement?.Members.FirstOrDefault(value => value.AccountId == CurrentAccountId);
            var presentation = currentMember is null ? null : await ResolveOptimisticPresentationAsync(currentMember);
            var clientMessageId = Messaging.QueueMessage(submission.Content, _replyTo?.Id, submission.Mentions, submission.Attachments,
                submission.UploadAttachments, currentMember is null ? null : new MessageAuthorDto(
                    currentMember.AccountId, currentMember.Username, currentMember.DisplayName,
                    currentMember.AvatarPresetId, currentMember.AvatarRevision));
            if (presentation is not null)
            {
                RememberOptimisticPresentation(clientMessageId, presentation);
                LogPresentation("pending-created", clientMessageId, clientMessageId, currentMember!, presentation,
                    hasHistoricalSnapshot: false, avatarSnapshotMessageId: null);
            }
            _replyTo = null;
            await RenderAsync();
            if (_composer is not null) await _composer.FocusAsync();
            return true;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Message send failed in Community {CommunityId} channel {ChannelId}.", Community.Id, Channel.Id);
            _error = FailureMessage(exception, "Message send failed", "Your message could not be sent. Please try again.");
            return false;
        }
        finally
        {
            _sending = false;
            await RenderAsync();
        }
    }

    private async Task<bool> EditMessageAsync(MessageEditSubmission submission)
    {
        _error = null;
        try { await Messaging.EditAsync(submission.MessageId, submission.Content); return true; }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Message {MessageId} edit failed in Community {CommunityId} channel {ChannelId}.", submission.MessageId, Community.Id, Channel.Id);
            _error = FailureMessage(exception, "Message edit failed", "The message could not be edited.");
            return false;
        }
    }

    private async Task DeleteMessageAsync(Guid messageId)
    {
        _error = null;
        try { await Messaging.DeleteAsync(messageId); }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Message {MessageId} deletion failed in Community {CommunityId} channel {ChannelId}.", messageId, Community.Id, Channel.Id);
            _error = FailureMessage(exception, "Message deletion failed", "The message could not be deleted.");
        }
    }
    private Task RetryMessageAsync(Guid clientMessageId) => Messaging.RetryAsync(clientMessageId);
    private void RemoveLocalMessage(Guid clientMessageId)
    {
        _optimisticCommunityPresentations.Remove(clientMessageId);
        Messaging.RemoveFailedMessage(clientMessageId);
    }
    private void RememberOptimisticPresentation(Guid clientMessageId,
        OptimisticCommunityAuthorPresentation presentation)
    {
        _optimisticCommunityPresentations[clientMessageId] = presentation;
        _optimisticPresentationOrder.Enqueue(clientMessageId);
        while (_optimisticPresentationOrder.Count > 128)
            _optimisticCommunityPresentations.Remove(_optimisticPresentationOrder.Dequeue());
    }

    private async Task<OptimisticCommunityAuthorPresentation> ResolveOptimisticPresentationAsync(
        CommunityMemberDto member)
    {
        if (member.AvatarPresetId is null) await EnsureDefaultPfpIdentityAsync();
        return OptimisticMessageGrouping.PresentationFor(member, _activeDefaultPfp);
    }

    private Task EnsureDefaultPfpIdentityAsync()
    {
        var account = Session.Account;
        if (account is null) return Task.CompletedTask;
        if (_defaultPfpAccountId == account.Id && _defaultPfpAccountRevision == account.AvatarRevision &&
            _defaultPfpLoad is not null) return _defaultPfpLoad;
        _defaultPfpAccountId = account.Id;
        _defaultPfpAccountRevision = account.AvatarRevision;
        return _defaultPfpLoad = LoadDefaultPfpIdentityAsync(account.Id, account.AvatarRevision);
    }

    private async Task LoadDefaultPfpIdentityAsync(Guid accountId, long accountRevision)
    {
        try
        {
            var presets = await Session.GetAvatarPresetsAsync();
            if (Session.Account?.Id != accountId || Session.Account.AvatarRevision != accountRevision) return;
            _activeDefaultPfp = (presets.ActiveAvatarPresetId ?? presets.BaseAvatarPresetId) is { } id
                ? presets.Presets.FirstOrDefault(value => value.Id == id)
                : null;
        }
        catch (Exception exception)
        {
            _activeDefaultPfp = null;
            Logger.LogDebug(exception, "Could not resolve the selected account PFP revision for optimistic Community presentation.");
        }
    }

    private void LogPresentation(string stage, Guid messageId, Guid clientMessageId, CommunityMemberDto member,
        OptimisticCommunityAuthorPresentation presentation, bool hasHistoricalSnapshot,
        Guid? avatarSnapshotMessageId)
    {
        if (!HostEnvironment.IsDevelopment()) return;
        Logger.LogDebug(
            "Community optimistic identity stage={Stage} message={MessageId} client={ClientMessageId} account={AccountId} " +
            "default={IsDefault} profilePreset={ProfilePresetId} displayName={DisplayName} pfpPreset={AvatarPresetId} " +
            "pfpRevision={AvatarRevision} dtoPfpPreset={DtoAvatarPresetId} dtoPfpRevision={DtoAvatarRevision} " +
            "historical={Historical} snapshotMessage={SnapshotMessageId}",
            stage, messageId, clientMessageId, member.AccountId, presentation.ProfilePresetId is null,
            presentation.ProfilePresetId, presentation.DisplayName, presentation.AvatarPresetId,
            presentation.AvatarRevision, member.AvatarPresetId, member.AvatarRevision,
            hasHistoricalSnapshot, avatarSnapshotMessageId);
    }

    private void LogMessagePresentation(string stage, ChannelMessageDto message,
        OptimisticCommunityAuthorPresentation presentation)
    {
        if (!HostEnvironment.IsDevelopment() || message.ClientMessageId is not { } clientMessageId) return;
        Logger.LogDebug(
            "Community optimistic identity stage={Stage} message={MessageId} client={ClientMessageId} account={AccountId} " +
            "delivery={Delivery} default={IsDefault} transientProfilePreset={ProfilePresetId} " +
            "transientDisplayName={TransientDisplayName} transientPfpPreset={TransientAvatarPresetId} " +
            "transientPfpRevision={TransientAvatarRevision} dtoDisplayName={DtoDisplayName} " +
            "dtoPfpPreset={DtoAvatarPresetId} dtoPfpRevision={DtoAvatarRevision} historical={Historical} " +
            "snapshotMessage={SnapshotMessageId}",
            stage, message.Id, clientMessageId, message.Author.AccountId, message.DeliveryState,
            presentation.ProfilePresetId is null, presentation.ProfilePresetId, presentation.DisplayName,
            presentation.AvatarPresetId, presentation.AvatarRevision, message.Author.DisplayName,
            message.Author.AvatarPresetId, message.Author.AvatarRevision, message.Author.HasHistoricalSnapshot,
            message.Author.AvatarSnapshotMessageId);
    }
    private Task EditLastOwnMessageAsync() => _messageList?.BeginEditLatestOwnAsync() ?? Task.CompletedTask;

    private bool ShowJumpToLatest => _shouldShowJumpToLatest || Messaging.WindowMode == MessageWindowMode.SearchTarget;
    private Task LoadOlderAsync() => Messaging.LoadOlderAsync();
    private void ViewportStateChanged(MessageViewportState state)
    {
        _isPinnedToLatest = state.IsPinnedToLatest;
        _shouldShowJumpToLatest = state.ShouldShowJumpToLatest;
        _ = RenderAsync();
    }
    private async Task JumpToLatestAsync()
    {
        _messageList?.PrepareUserLatestTransition(true);
        await Messaging.ResetToLatestAsync();
        _loadedTargetMessageId = TargetMessageId;
        await RenderAsync();
    }

    private async Task RenderFromRealtimeAsync()
    {
        try
        {
            ClearCompletedOptimisticPresentations();
            await RenderAsync();
        }
        catch (Exception exception) when (!_disposed)
        {
            Logger.LogError(exception, "Rendering a realtime update failed for channel {ChannelId}.", Channel.Id);
        }
    }

    private void ClearCompletedOptimisticPresentations()
    {
        if (_optimisticCommunityPresentations.Count == 0) return;
        var tracked = VisibleMessages.Where(message => message.ClientMessageId is { } clientMessageId &&
            _optimisticCommunityPresentations.ContainsKey(clientMessageId)).ToArray();
        foreach (var message in tracked)
            if (message.ClientMessageId is { } clientMessageId &&
                _optimisticCommunityPresentations.TryGetValue(clientMessageId, out var presentation))
                LogMessagePresentation("reconciliation-observed", message, presentation);
        if (tracked.Length == 0 || tracked.Any(message => message.DeliveryState != MessageDeliveryState.Confirmed ||
                !message.Author.HasHistoricalSnapshot)) return;
        foreach (var message in tracked)
            if (message.ClientMessageId is { } clientMessageId &&
                _optimisticCommunityPresentations.TryGetValue(clientMessageId, out var presentation))
                LogMessagePresentation("canonical-ready", message, presentation);
        _optimisticCommunityPresentations.Clear();
        _optimisticPresentationOrder.Clear();
    }

    private Task RenderAsync() => _disposed ? Task.CompletedTask : InvokeAsync(StateHasChanged);

    private string FailureMessage(Exception exception, string developmentPrefix, string productionMessage) =>
        HostEnvironment.IsDevelopment()
            ? $"{developmentPrefix}: {exception.GetBaseException().Message}"
            : productionMessage;

    public void Dispose()
    {
        _disposed = true;
        Messaging.Changed -= MessagesChanged;
    }
}
