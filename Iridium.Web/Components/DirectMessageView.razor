@using Iridium.Client.Core
@using Iridium.Protocol
@using Iridium.Web.Models
@implements IDisposable
@inject ChannelMessagingSession Messaging
@inject CallClientService Calls
@inject ActiveVoiceSessionCoordinator VoiceSessions
@inject ILogger<DirectMessageView> Logger

<section class="direct-message-view">
    <header class="dm-header">
        <ProfileAvatar AccountId="Conversation.OtherParticipant.AccountId" DisplayName="@Conversation.OtherParticipant.DisplayName" Presence="@Conversation.OtherParticipant.Presence" Size="small" Surface="base" />
        <div><strong class="display-name">@Conversation.OtherParticipant.DisplayName</strong><span>@IridiumIdentity.Format(Conversation.OtherParticipant.Username, NodeAuthority)</span></div>
        <button type="button" class="voice-call-button" title="Start Voice Call" aria-label="Start Voice Call"
                disabled="@(Calls.CurrentCall is not null || Calls.IncomingCall is not null)" @onclick="StartVoiceCallAsync"><Icon Name="phone" /></button>
    </header>
    @if (_loading && VisibleDirectMessages.Count == 0) { <div class="dm-status">Loading message history…</div> }
    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="dm-error">@_error</div> }
    <div class="dm-message-region">
        <DirectVoiceCallStage ConversationId="Conversation.Id" CurrentAccountId="CurrentAccountId" Participant="Conversation.OtherParticipant" />
        <div class="dm-message-history">
        <MessageList @key="Conversation.Id" @ref="_messageList" Messages="ProjectedMessages" CurrentAccountId="CurrentAccountId" CanManage="false"
                     DirectParticipant="Conversation.OtherParticipant"
                     NodeAuthority="@NodeAuthority" OnEditProfile="OnEditProfile" OnMessage="OnMessage"
                     EmptyIcon="message" EmptyTitle="No messages yet" EmptyDescription="Send the first Direct Message."
                     OnReply="BeginReply" Edit="EditMessageAsync" OnDelete="DeleteMessageAsync"
                     OnRetryLocal="RetryMessageAsync" OnRemoveLocal="RemoveLocalMessage"
                     OnEditCompleted="FocusComposerAfterEditAsync"
                     WindowRevision="Messaging.WindowRevision" TargetMessageId="@(Messaging.WindowMode == MessageWindowMode.SearchTarget ? _loadedTargetMessageId : null)"
                     OnLoadOlder="LoadOlderAsync" OnViewportStateChanged="ViewportStateChanged" />
        @if (ShowJumpToLatest) { <button class="jump-latest" @onclick="JumpToLatestAsync">Jump to Latest</button> }
        </div>
    </div>
    <div class="dm-composer-region">
        <MessageComposer @ref="_composer" ChannelName="@Conversation.OtherParticipant.DisplayName"
                         PlaceholderText="@($"Message {Conversation.OtherParticipant.DisplayName}")"
                         ReplyToDisplayName="@(_replyTo?.Author.DisplayName)" Busy="@_sending"
                         SendRich="SendMessageAsync" OnCancelReply="CancelReplyAsync"
                         OnEditLastMessage="EditLastOwnMessageAsync"
                         NodeAuthority="@NodeAuthority" AccountId="@CurrentAccountId" ConversationKind="direct" ConversationId="@Conversation.Id" />
    </div>
</section>

@code {
    [Parameter, EditorRequired] public required DirectConversationDto Conversation { get; set; }
    [Parameter, EditorRequired] public required Guid CurrentAccountId { get; set; }
    [Parameter, EditorRequired] public required string NodeAuthority { get; set; }
    [Parameter] public EventCallback OnEditProfile { get; set; }
    [Parameter] public EventCallback<Guid> OnMessage { get; set; }
    [Parameter] public EventCallback OnStartVoiceCall { get; set; }
    [Parameter] public bool IsMobileLayout { get; set; }
    [Parameter] public Guid? TargetMessageId { get; set; }
    [Parameter] public long FocusRequest { get; set; }
    [Parameter] public EventCallback<long> OnFocusConsumed { get; set; }
    private Guid? _loadedConversationId;
    private ChannelMessageDto? _replyTo;
    private MessageComposer? _composer;
    private MessageList? _messageList;
    private Guid? _loadedTargetMessageId;
    private bool _isPinnedToLatest = true;
    private bool _shouldShowJumpToLatest;
    private bool _loading;
    private bool _sending;
    private bool _focusAfterRender;
    private long _consumedFocusRequest;
    private long _historyLoadGeneration;
    private bool _disposed;
    private string? _error;

    private IReadOnlyList<DirectMessageDto> VisibleDirectMessages => Messaging.DirectMessagesFor(Conversation.Id);
    private IReadOnlyList<ChannelMessageDto> ProjectedMessages => VisibleDirectMessages.Select(message =>
        new ChannelMessageDto(message.Id, Guid.Empty, message.ConversationId, message.Author, message.Content,
            message.CreatedAt, message.EditedAt, message.IsDeleted, message.ReplyTo, null,
            message.ClientMessageId, message.DeliveryState, message.DeliveryError, message.CanRetry,
            message.Attachments, message.Kind)).ToArray();

    protected override void OnInitialized() { Messaging.Changed += MessagesChanged; Calls.Changed += CallsChanged; }
    protected override void OnParametersSet()
    {
        if (IsMobileLayout)
        {
            _focusAfterRender = false;
            _consumedFocusRequest = Math.Max(_consumedFocusRequest, FocusRequest);
        }
        else if (FocusRequest > _consumedFocusRequest) _focusAfterRender = true;
        if (_loadedConversationId == Conversation.Id && _loadedTargetMessageId == TargetMessageId) return;
        _replyTo = null;
        _error = null;
        _loading = true;
        _loadedConversationId = Conversation.Id;
        _loadedTargetMessageId = TargetMessageId;
        _isPinnedToLatest = TargetMessageId is null;
        _shouldShowJumpToLatest = TargetMessageId is not null;
        var generation = ++_historyLoadGeneration;
        _ = HydrateHistoryAsync(Conversation.Id, TargetMessageId, generation);
    }
    private async Task HydrateHistoryAsync(Guid conversationId, Guid? targetMessageId, long generation)
    {
        try
        {
            await Messaging.OpenDirectConversationAsync(conversationId);
            if (targetMessageId is { } target) await Messaging.OpenDirectAroundAsync(conversationId, target);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not open Direct Message {ConversationId}.", conversationId);
            if (IsCurrentHistoryLoad(conversationId, generation)) _error = exception.Message;
        }
        finally
        {
            if (IsCurrentHistoryLoad(conversationId, generation))
            {
                _loading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }
    private bool IsCurrentHistoryLoad(Guid conversationId, long generation) => !_disposed &&
        generation == _historyLoadGeneration && Conversation.Id == conversationId;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusAfterRender || IsMobileLayout) return;
        _focusAfterRender = false;
        _consumedFocusRequest = FocusRequest;
        if (_composer is not null) await _composer.FocusAsync();
        await OnFocusConsumed.InvokeAsync(FocusRequest);
    }

    private async Task FocusComposerAfterEditAsync()
    {
        if (IsMobileLayout) return;
        _focusAfterRender = true;
        await InvokeAsync(StateHasChanged);
    }

    private void MessagesChanged() => _ = InvokeAsync(StateHasChanged);
    private void CallsChanged() => _ = InvokeAsync(StateHasChanged);
    private async Task BeginReply(ChannelMessageDto message)
    {
        if (message.Kind != MessageKind.User) return;
        _replyTo = message;
        await InvokeAsync(StateHasChanged);
        if (_composer is not null) await _composer.FocusAsync();
    }
    private async Task CancelReplyAsync()
    {
        _replyTo = null;
        await InvokeAsync(StateHasChanged);
        if (_composer is not null) await _composer.FocusAsync();
    }
    private async Task<bool> SendMessageAsync(MessageSubmission submission)
    {
        if (_sending) return false;
        _sending = true;
        _error = null;
        try
        {
            var smooth = ShowJumpToLatest;
            _messageList?.PrepareUserLatestTransition(smooth);
            Messaging.QueueDirectMessage(submission.Content, _replyTo?.Id, submission.Attachments,
                submission.UploadAttachments);
            _replyTo = null;
            await InvokeAsync(StateHasChanged);
            if (_composer is not null) await _composer.FocusAsync();
            return true;
        }
        catch (Exception exception) { Logger.LogError(exception, "Direct Message send failed."); _error = exception.Message; return false; }
        finally { _sending = false; }
    }
    private async Task<bool> EditMessageAsync(MessageEditSubmission submission)
    {
        try { await Messaging.EditDirectAsync(submission.MessageId, submission.Content); return true; }
        catch (Exception exception) { _error = exception.Message; return false; }
    }
    private async Task DeleteMessageAsync(Guid messageId)
    {
        try { await Messaging.DeleteDirectAsync(messageId); }
        catch (Exception exception) { _error = exception.Message; }
    }
    private Task RetryMessageAsync(Guid clientMessageId) => Messaging.RetryDirectAsync(clientMessageId);
    private void RemoveLocalMessage(Guid clientMessageId) => Messaging.RemoveFailedMessage(clientMessageId);
    private Task EditLastOwnMessageAsync() => _messageList?.BeginEditLatestOwnAsync() ?? Task.CompletedTask;
    private bool ShowJumpToLatest => _shouldShowJumpToLatest || Messaging.WindowMode == MessageWindowMode.SearchTarget;
    private Task LoadOlderAsync() => Messaging.LoadOlderAsync();
    private void ViewportStateChanged(MessageViewportState state)
    {
        _isPinnedToLatest = state.IsPinnedToLatest;
        _shouldShowJumpToLatest = state.ShouldShowJumpToLatest;
        _ = InvokeAsync(StateHasChanged);
    }
    private async Task JumpToLatestAsync()
    {
        _messageList?.PrepareUserLatestTransition(true);
        await Messaging.ResetToLatestAsync();
        _loadedTargetMessageId = TargetMessageId;
        await InvokeAsync(StateHasChanged);
    }
    public async Task StartVoiceCallAsync()
    {
        _error = null;
        try
        {
            await VoiceSessions.StartDirectAsync(Conversation);
            if (OnStartVoiceCall.HasDelegate) await OnStartVoiceCall.InvokeAsync();
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Could not start voice call in Direct Message {ConversationId}.", Conversation.Id);
            _error = exception.Message;
        }
    }
    public async Task OpenSearchResultAsync(MessageSearchResultDto result)
    {
        _loadedTargetMessageId = result.MessageId;
        await Messaging.OpenDirectAroundAsync(Conversation.Id, result.MessageId);
        _isPinnedToLatest = false;
        _shouldShowJumpToLatest = true;
        await InvokeAsync(StateHasChanged);
    }
    public void Dispose() { _disposed = true; Messaging.Changed -= MessagesChanged; Calls.Changed -= CallsChanged; }
}
