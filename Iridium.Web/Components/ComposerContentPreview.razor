@using Iridium.Client.Core
@using Iridium.Protocol

@foreach (var node in Nodes)
{
    if (node.IsEmoji)
    {
        <span class="composer-emoji-token inline-emoji-token" aria-hidden="true"></span>
    }
    else if (!string.IsNullOrEmpty(node.Text))
    {
        <ComposerMarkdownPreview Content="@node.Text" />
    }
}

@code {
    [Parameter, EditorRequired] public required string Content { get; set; }
    [Parameter] public IReadOnlyList<CommunityEmojiDraftReference> References { get; set; } = [];
    [Parameter] public IReadOnlyList<StandardEmojiDraftReference> StandardReferences { get; set; } = [];
    [Parameter] public IReadOnlyList<AvailableCommunityEmoji> Available { get; set; } = [];

    private IReadOnlyList<PreviewNode> Nodes
    {
        get
        {
            var nodes = new List<PreviewNode>();
            var position = 0;
            var references = References.Select(value => new PreviewReference(value.Start, value.Length, value.EmojiId))
                .Concat(StandardReferences.Select(value => new PreviewReference(value.Start, value.Length, null)))
                .OrderBy(value => value.Start);
            foreach (var reference in references)
            {
                if (reference.Start < position || reference.Start + reference.Length > Content.Length) continue;
                if (reference.Start > position) nodes.Add(new(Content[position..reference.Start], false));
                var isAvailable = reference.EmojiId is null || Available.Any(value => value.Emoji.Id == reference.EmojiId);
                nodes.Add(isAvailable ? new(null, true) : new(Content.Substring(reference.Start, reference.Length), false));
                position = reference.Start + reference.Length;
            }
            if (position < Content.Length) nodes.Add(new(Content[position..], false));
            return nodes;
        }
    }

    private sealed record PreviewNode(string? Text, bool IsEmoji);
    private sealed record PreviewReference(int Start, int Length, Guid? EmojiId);
}
