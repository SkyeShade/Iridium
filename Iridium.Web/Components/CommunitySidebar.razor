@using Iridium.Client.Core
@using Iridium.Protocol
@using Iridium.Web.Models
@inject ICategoryCollapseStore CollapseStore
@inject IJSRuntime JS
@inject CommunityVoiceSession Voice
@inject ActiveVoiceSessionCoordinator VoiceSessions
@implements IAsyncDisposable

<div class="community-sidebar" @ref="_sidebar" @onclick="CloseSidebarContextMenu">
    @if (State.CanManage)
    {
        <div class="sidebar-tools">
            <button title="Create a root Channel" @onclick="OpenRootChannelDialog"><Icon Name="plus" /> Channel</button>
            <button title="Create a top-level Category" @onclick="OpenCategoryDialog"><Icon Name="plus" /> Category</button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="sidebar-error">@_error</div> }
    <div class="channel-scroll" @oncontextmenu="OpenSidebarContextMenu" @oncontextmenu:preventDefault="true">
        <div class="category-tree-root" data-category-tree-root>
            @foreach (var item in RootItems)
            {
                if (item.Channel is { } rootChannel)
                {
                    <ChannelRow @key="item.Id" Channel="rootChannel" CanManage="State.CanManage" CanManageForumTags="@CanManageForumTags(rootChannel)" CanManagePermissions="@CanManagePermissions(rootChannel.EffectivePermissions)" Depth="1"
                                Selected="@(SelectedChannel?.Id == rootChannel.Id)" OnSelect="SelectChannelAsync"
                                Room="@Voice.Room(rootChannel.Id)" Connected="@(Voice.CurrentRoom?.ChannelId == rootChannel.Id)"
                                CurrentAccountId="AccountId"
                                Members="@(State.Management?.Members ?? [])"
                                PublishedStreams="Voice.PublishedStreams" OnWatchStream="WatchStreamAsync"
                                StreamThumbnails="VoiceSessions.StreamThumbnails"
                                OnEdit="EditChannel" OnDelete="RequestDeleteChannel"
                                OnPermissions="OpenChannelPermissions" />
                }
                else if (item.Category is { } category)
                {
                    <CommunityCategoryTreeNode @key="item.Id" Category="category" Categories="State.Categories"
                                               Channels="State.Channels" Collapsed="_collapsed" CanManage="State.CanManage"
                                               CanManagePermissions="State.CanManagePermissions"
                                               VoiceRooms="Voice.Rooms" ConnectedVoiceChannelId="Voice.CurrentRoom?.ChannelId"
                                               CurrentAccountId="AccountId"
                                               Members="@(State.Management?.Members ?? [])"
                                               PublishedStreams="Voice.PublishedStreams" OnWatchStream="WatchStreamAsync"
                                               StreamThumbnails="VoiceSessions.StreamThumbnails"
                                               SelectedChannelId="SelectedChannel?.Id" OnToggle="ToggleCategoryAsync"
                                               OnEdit="EditCategory" OnCreateChannel="OpenChannelDialog"
                                               OnCreateSubcategory="OpenSubcategoryDialog" OnDelete="RequestDeleteCategory"
                                               OnSelectChannel="SelectChannelAsync" OnEditChannel="EditChannel"
                                               OnDeleteChannel="RequestDeleteChannel"
                                               OnChannelPermissions="OpenChannelPermissions"
                                               OnCategoryPermissions="OpenCategoryPermissions" />
                }
            }
        </div>
        @if (!RootItems.Any() && State.CanManage)
        {
            <button class="first-channel" @onclick="OpenRootChannelDialog"><Icon Name="plus" /> Create your first Channel</button>
        }
    </div>
    @if (_showSidebarContextMenu && State.CanManage)
    {
        <div class="sidebar-context-menu" @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true"
             @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
            <button @onclick="CreateCategoryFromSidebarMenu"><Icon Name="plus" /> Create Category</button>
            <button @onclick="CreateRootChannelFromSidebarMenu"><Icon Name="plus" /> Create Channel</button>
        </div>
    }
</div>

@if (_showChannelDialog)
{
    <ChannelSettingsDialog Channel="_editingChannel" Community="Community" InitialCategoryId="_newChannelCategoryId"
                           Categories="State.Categories" Busy="_busy" Error="@_dialogError"
                           ConfirmDeleteInitially="_confirmChannelDelete" OnSave="SaveChannelAsync"
                           OnDelete="DeleteChannelAsync" OnCancel="CloseChannelDialog" />
}
@if (_showCategoryDialog)
{
    <CategorySettingsDialog Category="_editingCategory" InitialParentCategoryId="_newCategoryParentId"
                            ParentName="@ParentCategoryName" Busy="_busy" Error="@_dialogError"
                            ConfirmDeleteInitially="_confirmCategoryDelete" OnSave="SaveCategoryAsync"
                            OnDelete="DeleteCategoryAsync" OnCancel="CloseCategoryDialog" />
}
@if (_permissionChannel is not null || _permissionCategory is not null)
{
    <CommunityPermissionEditor State="State" Community="Community" Channel="_permissionChannel" Category="_permissionCategory"
                               InitialSection="@_settingsInitialSection"
                               OnSaveChannel="SaveSettingsChannelAsync" OnSaveCategory="SaveSettingsCategoryAsync"
                               OnDeleteChannel="DeleteSettingsChannelAsync" OnDeleteCategory="DeleteSettingsCategoryAsync"
                               OnClose="ClosePermissionEditor" />
}

@code {
    [Parameter, EditorRequired] public required CommunitySession State { get; set; }
    [Parameter, EditorRequired] public required CommunityDto Community { get; set; }
    [Parameter, EditorRequired] public required Guid AccountId { get; set; }
    [Parameter, EditorRequired] public required Guid CommunityId { get; set; }
    [Parameter] public CommunityChannelDto? SelectedChannel { get; set; }
    [Parameter] public EventCallback<CommunityChannelDto?> OnChannelSelected { get; set; }

    private readonly HashSet<Guid> _collapsed = [];
    private Guid? _loadedCommunityId; private Guid? _revealedChannelId;
    private bool _showChannelDialog; private bool _showCategoryDialog; private bool _showSidebarContextMenu;
    private bool _confirmChannelDelete; private bool _confirmCategoryDelete; private bool _busy;
    private CommunityChannelDto? _editingChannel; private CommunityCategoryDto? _editingCategory;
    private CommunityChannelDto? _permissionChannel; private CommunityCategoryDto? _permissionCategory;
    private string _settingsInitialSection = "Overview";
    private Guid? _newChannelCategoryId; private Guid? _newCategoryParentId;
    private string? _error; private string? _dialogError;
    private ElementReference _sidebar; private IJSObjectReference? _dragModule;
    private DotNetObjectReference<CommunitySidebar>? _selfReference;
    private bool _voiceSubscribed;
    private IEnumerable<CommunitySidebarVisualItem> RootItems => State.Categories.Where(value => value.ParentCategoryId is null)
        .Select(CommunitySidebarVisualItem.From)
        .Concat(State.Channels.Where(value => value.CategoryId is null).Select(CommunitySidebarVisualItem.From))
        .OrderBy(value => value.Position).ThenBy(value => value.Type).ThenBy(value => value.Id);
    private string? ParentCategoryName => State.Categories.FirstOrDefault(value => value.Id == _newCategoryParentId)?.Name;
    private bool CanManagePermissions(CommunityPermission permissions) => State.IsOwner ||
        (permissions & CommunityPermission.Administrator) != 0 ||
        (permissions & CommunityPermission.ManagePermissions) != 0;
    private bool CanManageForumTags(CommunityChannelDto channel) => channel.Kind == CommunityChannelKind.Forum &&
        (State.IsOwner || (channel.EffectivePermissions & (CommunityPermission.Administrator |
            CommunityPermission.ManageMessages)) != 0);

    protected override async Task OnParametersSetAsync()
    {
        if (!_voiceSubscribed) { Voice.Changed += OnVoiceChanged; _voiceSubscribed = true; }
        if (_loadedCommunityId != CommunityId)
        {
            _loadedCommunityId = CommunityId; _collapsed.Clear();
            _collapsed.UnionWith(await CollapseStore.LoadAsync(AccountId, CommunityId));
            _revealedChannelId = null;
            try { await Voice.ObserveCommunityAsync(CommunityId); }
            catch (Exception exception) { _error = exception.Message; }
        }
        if (SelectedChannel is { } selected && _revealedChannelId != selected.Id)
        {
            _revealedChannelId = selected.Id;
            var categoryId = selected.CategoryId;
            var changed = false;
            while (categoryId is { } currentCategoryId)
            {
                changed |= _collapsed.Remove(currentCategoryId);
                var category = State.Categories.FirstOrDefault(value => value.Id == currentCategoryId);
                if (category?.ParentCategoryId is not { } parent) break;
                categoryId = parent;
            }
            if (changed) await CollapseStore.SaveAsync(AccountId, CommunityId, _collapsed);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var projection = BuildVisibleTreeProjection();
        if (firstRender)
        {
            _dragModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/chat.js");
            _selfReference = DotNetObjectReference.Create(this);
            await _dragModule.InvokeVoidAsync("wireChannelSorter", _sidebar, _selfReference, projection);
        }
        else if (_dragModule is not null)
            await _dragModule.InvokeVoidAsync("updateChannelSorterProjection", _sidebar, projection);
    }

    private async Task SelectChannelAsync(CommunityChannelDto channel)
    {
        if (channel.Kind == CommunityChannelKind.Voice)
        {
            try { await VoiceSessions.JoinCommunityAsync(channel.CommunityId, channel.Id); _error = null; }
            catch (Exception exception) { _error = exception.Message; }
            return;
        }
        await OnChannelSelected.InvokeAsync(channel);
    }
    private void OnVoiceChanged() => _ = InvokeAsync(StateHasChanged);
    private Task WatchStreamAsync(Guid streamId) => VoiceSessions.WatchStreamAsync(streamId);
    private void EditChannel(CommunityChannelDto channel) { _permissionChannel = channel; _permissionCategory = null; _settingsInitialSection = "Overview"; }
    private void RequestDeleteChannel(CommunityChannelDto channel) { _permissionChannel = channel; _permissionCategory = null; _settingsInitialSection = "Delete"; }
    private void OpenChannelPermissions(CommunityChannelDto channel) { _permissionChannel = channel; _permissionCategory = null; _settingsInitialSection = "Permissions"; }
    private void OpenChannelDialog(CommunityCategoryDto category) { _editingChannel = null; _newChannelCategoryId = category.Id; _confirmChannelDelete = false; _dialogError = null; _showChannelDialog = true; }
    private void OpenRootChannelDialog() { _editingChannel = null; _newChannelCategoryId = null; _confirmChannelDelete = false; _dialogError = null; _showChannelDialog = true; }
    public void BeginCreateChannel() { OpenRootChannelDialog(); StateHasChanged(); }
    private void CloseChannelDialog() { _showChannelDialog = false; _editingChannel = null; _dialogError = null; }
    private void EditCategory(CommunityCategoryDto category) { _permissionCategory = category; _permissionChannel = null; _settingsInitialSection = "Overview"; }
    private void RequestDeleteCategory(CommunityCategoryDto category) { _permissionCategory = category; _permissionChannel = null; _settingsInitialSection = "Delete"; }
    private void OpenCategoryPermissions(CommunityCategoryDto category) { _permissionCategory = category; _permissionChannel = null; _settingsInitialSection = "Permissions"; }
    private void ClosePermissionEditor() { _permissionChannel = null; _permissionCategory = null; }
    private void OpenSubcategoryDialog(CommunityCategoryDto parent) { _editingCategory = null; _newCategoryParentId = parent.Id; _confirmCategoryDelete = false; _dialogError = null; _showCategoryDialog = true; }
    private void OpenCategoryDialog() { _editingCategory = null; _newCategoryParentId = null; _confirmCategoryDelete = false; _dialogError = null; _showCategoryDialog = true; }
    public void BeginCreateCategory() { OpenCategoryDialog(); StateHasChanged(); }
    private void CloseCategoryDialog() { _showCategoryDialog = false; _editingCategory = null; _newCategoryParentId = null; _dialogError = null; }
    private void OpenSidebarContextMenu(MouseEventArgs _) { if (State.CanManage) _showSidebarContextMenu = true; }
    private void CloseSidebarContextMenu() => _showSidebarContextMenu = false;
    private void CreateCategoryFromSidebarMenu() { CloseSidebarContextMenu(); OpenCategoryDialog(); }
    private void CreateRootChannelFromSidebarMenu() { CloseSidebarContextMenu(); OpenRootChannelDialog(); }

    private async Task SaveChannelAsync(ChannelSettingsSubmission submission) => await RunDialogAsync(async () =>
    {
        CommunityChannelDto? created = null;
        if (submission.ChannelId is { } id) await State.UpdateChannelAsync(id, submission.Name,
            submission.CategoryId, submission.Kind, submission.RequireTag);
        else created = await State.CreateChannelAsync(submission.Name, submission.CategoryId, submission.Kind);
        CloseChannelDialog(); if (created is { Kind: CommunityChannelKind.Text or CommunityChannelKind.Forum }) await OnChannelSelected.InvokeAsync(created);
    });
    private async Task DeleteChannelAsync(Guid channelId) => await RunDialogAsync(async () =>
    {
        await State.DeleteChannelAsync(channelId); CloseChannelDialog();
        if (SelectedChannel?.Id == channelId) await OnChannelSelected.InvokeAsync(null);
    });
    private async Task SaveCategoryAsync(CategorySettingsSubmission submission) => await RunDialogAsync(async () =>
    {
        if (submission.CategoryId is { } id) await State.UpdateCategoryAsync(id, submission.Name);
        else await State.CreateCategoryAsync(submission.Name, submission.ParentCategoryId);
        CloseCategoryDialog();
    });
    private async Task DeleteCategoryAsync(Guid categoryId) => await RunDialogAsync(async () =>
    {
        await State.DeleteCategoryAsync(categoryId); _collapsed.Remove(categoryId); CloseCategoryDialog();
    });
    private async Task SaveSettingsChannelAsync(ChannelSettingsSubmission submission)
    {
        await State.UpdateChannelAsync(submission.ChannelId!.Value, submission.Name, submission.CategoryId,
            submission.Kind, submission.RequireTag);
        _permissionChannel = State.Channels.FirstOrDefault(value => value.Id == submission.ChannelId) ?? _permissionChannel;
    }
    private async Task SaveSettingsCategoryAsync(CategorySettingsSubmission submission)
    {
        await State.UpdateCategoryAsync(submission.CategoryId!.Value, submission.Name);
        _permissionCategory = State.Categories.FirstOrDefault(value => value.Id == submission.CategoryId) ?? _permissionCategory;
    }
    private async Task DeleteSettingsChannelAsync(Guid channelId)
    {
        await State.DeleteChannelAsync(channelId); ClosePermissionEditor();
        if (SelectedChannel?.Id == channelId)
            await OnChannelSelected.InvokeAsync(State.Channels
                .Where(value => value.Kind is CommunityChannelKind.Text or CommunityChannelKind.Forum)
                .OrderBy(value => value.Position)
                .FirstOrDefault());
    }
    private async Task DeleteSettingsCategoryAsync(Guid categoryId)
    {
        var selectedChannelId = SelectedChannel?.Id;
        await State.DeleteCategoryAsync(categoryId); _collapsed.Remove(categoryId); ClosePermissionEditor();
        if (selectedChannelId is not null && State.Channels.All(value => value.Id != selectedChannelId))
            await OnChannelSelected.InvokeAsync(State.Channels
                .Where(value => value.Kind is CommunityChannelKind.Text or CommunityChannelKind.Forum)
                .OrderBy(value => value.Position)
                .FirstOrDefault());
    }
    private async Task RunDialogAsync(Func<Task> action)
    {
        _busy = true; _dialogError = null;
        try { await action(); } catch (Exception exception) { _dialogError = exception.Message; }
        finally { _busy = false; }
    }
    private async Task ToggleCategoryAsync(CommunityCategoryDto category)
    {
        if (!_collapsed.Add(category.Id)) _collapsed.Remove(category.Id);
        await CollapseStore.SaveAsync(AccountId, CommunityId, _collapsed);
    }

    [JSInvokable]
    public async Task CommitChannelDropAsync(string channelId, string? parentCategoryId, string? targetItemId,
        string? targetItemType, string intent)
    {
        if (!State.CanManage || !Guid.TryParse(channelId, out var channel) ||
            !TryMoveRequest(parentCategoryId, targetItemId, targetItemType, intent, out var request)) return;
        try { await State.MoveChannelAsync(channel, request); _error = null; }
        catch (Exception exception) { _error = exception.Message; }
        await InvokeAsync(StateHasChanged);
    }
    [JSInvokable]
    public async Task CommitCategoryDropAsync(string categoryId, string? parentCategoryId, string? targetItemId,
        string? targetItemType, string intent)
    {
        if (!State.CanManage || !Guid.TryParse(categoryId, out var category)) return;
        if (!TryMoveRequest(parentCategoryId, targetItemId, targetItemType, intent, out var request)) return;
        try { await State.MoveCategoryAsync(category, request); _error = null; }
        catch (Exception exception) { _error = exception.Message; }
        await InvokeAsync(StateHasChanged);
    }
    private static bool TryMoveRequest(string? parentValue, string? itemValue, string? typeValue, string intentValue,
        out CommunitySidebarMoveRequest request)
    {
        request = default!;
        Guid? parent = null; Guid? item = null; CommunitySidebarItemType? type = null;
        if (!string.IsNullOrWhiteSpace(parentValue)) { if (!Guid.TryParse(parentValue, out var parsed)) return false; parent = parsed; }
        if (!string.IsNullOrWhiteSpace(itemValue)) { if (!Guid.TryParse(itemValue, out var parsed)) return false; item = parsed; }
        if (!string.IsNullOrWhiteSpace(typeValue))
        {
            if (!Enum.TryParse<CommunitySidebarItemType>(typeValue, true, out var parsed)) return false;
            type = parsed;
        }
        if (!Enum.TryParse<CommunitySidebarDropIntent>(intentValue, true, out var intent)) return false;
        request = new(parent, item, type, intent); return true;
    }

    private IReadOnlyList<CommunityVisibleTreeRow> BuildVisibleTreeProjection()
        => CommunityVisibleTreeProjection.Build(State.Categories, State.Channels, _collapsed);
    public async ValueTask DisposeAsync()
    {
        if (_voiceSubscribed) Voice.Changed -= OnVoiceChanged;
        if (_dragModule is not null)
        {
            try { await _dragModule.InvokeVoidAsync("unwireChannelSorter", _sidebar); await _dragModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _selfReference?.Dispose();
    }
}
