@page "/"
@page "/invite/{InviteToken}"
@page "/recover-password"
@implements IDisposable
@using Iridium.Client.Core
@using Iridium.Protocol
@using Iridium.UI
@using Iridium.Web.Models
@inject SavedNodeState SavedNodes
@inject NodeSession Session
@inject CommunitySession CommunityState
@inject ChannelMessagingSession Messaging
@inject IMessageHistoryCache MessageHistoryCache
@inject AccountSwitchService AccountSwitching
@inject IWebAssemblyHostEnvironment HostEnvironment
@inject AppearanceService Appearance
@inject IIdentityProfileResolver ProfileResolver
@inject ILastCommunityChannelStore LastChannelStore
@inject Iridium.Web.Services.MessageMenuCoordinator MessageMenus
@inject ActiveVoiceSessionCoordinator VoiceSessions
@inject UiSoundService UiSounds
@inject FaviconNotificationService FaviconNotifications
@inject ILogger<Home> Logger
@inject NavigationManager Navigation

<PageTitle>Iridium</PageTitle>

@if (!_initialized)
{
    <div class="boot-screen"><div class="boot-mark">I</div><span>Starting Iridium…</span></div>
}
else if (_authenticationVisible || !Session.IsAuthenticated)
{
    <AuthenticationScreen Nodes="_nodeAvailability"
                          SelectedNode="Session.AuthenticationNode"
                          SavedAccounts="Session.SavedAccounts"
                          InitialUsername="@Session.ReauthenticationAccount?.Username"
                          RecoveryToken="@_recoveryToken"
                          RecoveryState="@_recoveryState"
                          RecoveryMessage="@_recoveryMessage"
                          CanCancel="@(_addingAccount && Session.IsAuthenticated)"
                          Busy="_busy"
                          Error="@_error"
                          OnNodeSelected="SelectNodeAsync"
                          OnNodeAdded="AddNodeAsync"
                          OnNodeRemoved="RemoveNodeAsync"
                          OnSavedAccountSelected="SwitchAccountAsync"
                          OnSubmit="AuthenticateAsync"
                          OnRecoveryRequested="RequestPasswordRecoveryAsync"
                          OnRecoveryCompleted="CompletePasswordRecoveryAsync"
                          OnRecoveryCancelled="CancelPasswordRecovery"
                          OnCancel="CancelAddAccount" />
}
else
{
    <ApplicationShell Communities="Session.Communities"
                      DirectConversations="Session.DirectConversations"
                      RingingCallerAccountId="VoiceSessions.IncomingCall?.CallerAccountId"
                      IncomingFriendRequestCount="IncomingFriendRequestCount"
                      ShowHomeFriendRequestNotification="@(FriendRequestNotificationTarget == FriendRequestNotificationLocation.Home)"
                      NodeAuthority="@(Session.SelectedNode!.PublicAuthority)"
                      SelectedCommunity="_selectedCommunity"
                      AccountId="Session.Account!.Id"
                      AvatarRevision="Session.Account!.AvatarRevision"
                      DisplayName="@Session.Account!.DisplayName"
                      PublicIdentity="@PublicIdentity"
                      Presence="@CurrentPresence"
                      OnBackgroundInteraction="CloseMessageMenus"
                      OnCommunitySelected="SelectCommunityFromNavigationAsync"
                      OnDirectConversationSelected="SelectDirectConversationFromNavigationAsync"
                      OnAddCommunity="() => _showCommunityCreate = true"
                      OnProfile="OpenProfilePopup"
                      OnSettings="OpenSettings"
                      ShowRightSidebar="@HasContextSidebar"
                      ActiveMobilePanel="_mobilePanels.Current"
                      MobileConversationTitle="@MobileConversationTitle"
                      UseCompactMobileConversationHeader="@IsDirectConversationSelected"
                      OnMobileBack="ShowMobileNavigation"
                      OnMobileContext="ShowMobileContext"
                      OnMobileContextClose="CloseMobileContext">
        <SidebarHeader>
            <div class="sidebar-heading @(_selectedCommunity?.BannerUrl is not null ? "has-community-banner" : null)">
                @if (_selectedCommunity?.BannerIsProcessed == true && !string.IsNullOrWhiteSpace(_selectedCommunity.BannerUrl))
                { <img class="community-header-banner" src="@_selectedCommunity.BannerUrl" alt="" /> }
                else if (CommunityHeaderBannerState is not null) { <AvatarCroppedPreview Class="community-header-banner" State="CommunityHeaderBannerState" Shape="banner" /> }
                <span class="community-header-shade"></span>
                @if (_selectedCommunity is not null)
                {
                    <button class="community-menu-trigger" aria-haspopup="menu" aria-expanded="_showCommunityMenu"
                            @onclick="ToggleCommunityMenu"><strong>@_selectedCommunity.Name</strong><Icon Name="chevron" /></button>
                }
                else { <strong>Home</strong> }
            </div>
            @if (_showCommunityMenu && _selectedCommunity is not null)
            {
                <div class="community-menu-layer" @onclick="CloseCommunityMenu" @onkeydown="CommunityMenuKey" tabindex="0">
                    <div class="community-actions-menu" role="menu" @onclick:stopPropagation="true">
                        @if (CommunityState.HasPermission(CommunityPermission.CreateInvites))
                        { <button role="menuitem" @onclick="OpenInviteFromMenuAsync"><Icon Name="friends" />Invite People</button> }
                        @if (CanOpenCommunitySettings)
                        { <button role="menuitem" @onclick="OpenSettingsFromMenu"><Icon Name="settings" />Server Settings</button> }
                        @if (CommunityState.HasPermission(CommunityPermission.ManageChannels))
                        {
                            <button role="menuitem" @onclick="CreateChannelFromMenu"><Icon Name="channel" />Create Channel</button>
                            <button role="menuitem" @onclick="CreateCategoryFromMenu"><Icon Name="plus" />Create Category</button>
                        }
                        @if (!CommunityState.IsOwner)
                        { <div class="menu-separator"></div><button class="destructive" role="menuitem" @onclick="PromptLeaveCommunity"><Icon Name="logout" />Leave Server</button> }
                    </div>
                </div>
            }
        </SidebarHeader>
        <SidebarContent>
            @if (_selectedCommunity is null)
            {
                <HomeSidebar ActiveView="_homeView" Conversations="Session.DirectConversations"
                             SelectedConversationId="_selectedDirectConversation?.Id"
                             IncomingFriendRequestCount="IncomingFriendRequestCount"
                             ShowFriendsFriendRequestNotification="@(FriendRequestNotificationTarget == FriendRequestNotificationLocation.Friends)"
                             OnViewSelected="SelectHomeView" OnConversationSelected="SelectDirectConversationFromNavigationAsync"
                             OnConversationClosed="CloseDirectConversationAsync" />
            }
            else
            {
                <CommunitySidebar @ref="_communitySidebar" State="CommunityState" AccountId="Session.Account!.Id"
                                  CommunityId="_selectedCommunity.Id" SelectedChannel="_selectedChannel"
                                  OnChannelSelected="SelectChannelFromNavigationAsync" />
            }
        </SidebarContent>
        <VoiceConnection><VoiceConnectionPanel /></VoiceConnection>
        <MobileConversationIdentity>
            @if (IsDirectConversationSelected && _selectedDirectConversation is { } mobileDirect)
            {
                <ProfileAvatar AccountId="mobileDirect.OtherParticipant.AccountId"
                               DisplayName="@mobileDirect.OtherParticipant.DisplayName"
                               Presence="@mobileDirect.OtherParticipant.Presence" Size="small" Surface="base" />
                <span class="mobile-dm-copy">
                    <strong class="display-name">@mobileDirect.OtherParticipant.DisplayName</strong>
                    <small>@IridiumIdentity.Format(mobileDirect.OtherParticipant.Username, Session.SelectedNode!.PublicAuthority)</small>
                </span>
            }
        </MobileConversationIdentity>
        <MobileConversationAction>
            @if (IsDirectConversationSelected)
            {
                <button type="button" class="mobile-dm-call" title="@DirectCallButtonLabel" aria-label="@DirectCallButtonLabel"
                        disabled="@(VoiceSessions.DirectCalls.CurrentCall is not null || VoiceSessions.IncomingCall is not null)"
                        @onclick="StartMobileDirectVoiceCallAsync"><Icon Name="phone" /></button>
            }
        </MobileConversationAction>
        <ChildContent>
            @if (VoiceSessions.WatchedStream is not null && VoiceSessions.ViewerMode == StreamViewerMode.Full)
            {
                <VoiceStreamViewer @key="VoiceSessions.WatchedStream.StreamId" OnMinimize="MinimizeFullStreamAsync" />
            }
            else if (_selectedCommunity is null)
            {
                @if (_homeView == "dm" && _selectedDirectConversation is not null)
                {
                    <DirectMessageView @key="_selectedDirectConversation.Id" @ref="_directMessageView" Conversation="_selectedDirectConversation"
                                       FocusRequest="@(_composerFocusConversationId == _selectedDirectConversation.Id ? _composerFocusRequest : 0)"
                                       OnFocusConsumed="ComposerFocusConsumed"
                                       CurrentAccountId="Session.Account!.Id" NodeAuthority="@(Session.SelectedNode!.PublicAuthority)"
                                       OnEditProfile="OpenProfileEditor" OnMessage="OpenDirectMessageAsync" />
                }
                else if (_homeView == "requests")
                {
                    <MessageRequestsView />
                }
                else
                {
                    <FriendsView Friends="Session.Friends" NodeAuthority="@(Session.SelectedNode!.PublicAuthority)" CurrentAccountId="Session.Account!.Id" Error="@_error"
                                 IncomingPendingCount="IncomingFriendRequestCount"
                                 ShowPendingFriendRequestNotification="@(FriendRequestNotificationTarget == FriendRequestNotificationLocation.Pending)"
                                 OnEditProfile="OpenProfileEditor"
                                 OnAddFriend="ShowAddFriend" OnAccept="AcceptFriendRequestAsync"
                                 OnRemove="RemoveFriendshipAsync" OnMessage="OpenFriendDirectMessageAsync" />
                }
            }
            else
            {
                <div class="content-header"><strong>@(_selectedChannel is null ? _selectedCommunity.Name : $"# {_selectedChannel.Name}")</strong></div>
                @if (_selectedChannel is null)
                {
                    <div class="welcome-panel"><div class="welcome-icon">@CommunityInitials(_selectedCommunity.Name)</div><h1>@_selectedCommunity.Name</h1><p>@(_selectedCommunity.Description ?? "Choose a text channel or create one to get started.")</p></div>
                }
                else
                {
                    <ChannelView @key="(_selectedChannel.Id, _selectedChannel.EffectivePermissions)" Community="_selectedCommunity" Channel="_selectedChannel"
                                 FocusRequest="@(_composerFocusChannelId == _selectedChannel.Id ? _composerFocusRequest : 0)"
                                 OnFocusConsumed="ComposerFocusConsumed"
                                 CurrentAccountId="Session.Account!.Id"
                                 NodeAuthority="@(Session.SelectedNode!.PublicAuthority)" CommunityManagement="CommunityState.Management"
                                 OnEditProfile="OpenProfileEditor" OnMessage="OpenDirectMessageAsync"
                                 OnMemberRolesChanged="SetCommunityMemberRolesAsync"
                                 CanManageMessages="@HasSelectedChannelPermission(CommunityPermission.ManageMessages)"
                                 CanSend="@HasSelectedChannelPermission(CommunityPermission.SendMessages)"
                                 CanAttachFiles="@HasSelectedChannelPermission(CommunityPermission.AttachFiles)"
                                 CanMentionEveryone="@HasSelectedChannelPermission(CommunityPermission.MentionEveryone)"
                                 TargetMessageId="_searchTargetMessageId" />
                }
            }
        </ChildContent>
        <RightSidebar>
            @if (_selectedCommunity is not null && _selectedChannel is not null && CommunityState.Management is { } management)
            {
                <CommunityMemberSidebar Management="management" CurrentAccountId="Session.Account!.Id"
                    NodeAuthority="@(Session.SelectedNode!.PublicAuthority)" OnEditProfile="OpenProfileEditor"
                    Channels="CommunityState.Channels" OnSearchResultSelected="OpenCommunitySearchResultAsync"
                    OnMessage="OpenDirectMessageAsync" OnMemberRolesChanged="SetCommunityMemberRolesAsync" />
            }
            else if (_selectedCommunity is null && _homeView == "dm" && _selectedDirectConversation is { } direct)
            {
                <DirectParticipantSidebar Participant="direct.OtherParticipant" ConversationId="direct.Id"
                    CurrentAccountId="Session.Account!.Id" NodeAuthority="@(Session.SelectedNode!.PublicAuthority)" OnSearchResultSelected="OpenDirectSearchResultAsync"
                    Friend="@Session.Friends.FirstOrDefault(value => value.AccountId == direct.OtherParticipant.AccountId)"
                    OnAddFriend="SendFriendRequestAsync" OnRemoveFriend="RemoveFriendAsync" />
            }
        </RightSidebar>
    </ApplicationShell>

    @if (VoiceSessions.WatchedStream is not null && VoiceSessions.ViewerMode == StreamViewerMode.Floating)
    {
        <VoiceStreamViewer @key="@($"floating-{VoiceSessions.WatchedStream.StreamId}")" Floating="true"
                           OnExpand="ExpandFloatingStreamAsync" />
    }

    @if (_showProfile)
    {
        <ProfilePopup Account="Session.Account!" PublicIdentity="@PublicIdentity" Busy="_busy"
                      Presence="@CurrentPresence" OnPresenceChanged="SetPresenceAsync"
                      Accounts="Session.SavedAccounts" ActiveAccount="Session.ActiveSavedAccount"
                      OnEditProfile="OpenProfileEditor" OnSwitchAccount="SwitchAccountAsync"
                      OnAddAccount="AddAccount" OnLogout="LogoutAsync" OnRemoveAccount="RemoveAccountAsync"
                      OnCancel="CloseProfile" />
    }
    @if (_showCommunityCreate)
    {
        <CommunityCreateDialog Busy="_busy" Error="@_error" OnCreate="CreateCommunityAsync"
                               OnCancel="CloseCommunityCreate" />
    }
    @if (_showSettings)
    {
        <SettingsView Account="Session.Account!" CurrentNode="Session.SelectedNode!" Nodes="_nodeAvailability"
                      Busy="_busy" Error="@_error" OnEditProfile="OpenProfileEditor"
                      OnAddNode="AddNodeAsync" OnRemoveNode="RemoveNodeAsync"
                      OnLogout="LogoutAsync" OnClose="CloseSettings" />
    }
    @if (_showAddFriend)
    {
        <AddFriendView Resolve="ProfileResolver.ResolveAsync" Search="Session.SearchAccountsAsync"
                       NodeAuthority="@(Session.SelectedNode!.PublicAuthority)" Friends="Session.Friends"
                       OnRequest="SendFriendRequestAsync"
                       OnAccept="AcceptFriendRequestAsync" OnMessage="OpenDirectMessageAsync"
                       OnClose="CloseAddFriend" />
    }
    @if (_showEditProfile)
    {
        <EditProfileModal Account="Session.Account!" PublicIdentity="@PublicIdentity"
                          Save="SaveProfileAsync" OnClosed="CloseProfileEditor" />
    }
    @if (_showCommunitySettings && _selectedCommunity is not null)
    {
        <CommunitySettingsModal Community="_selectedCommunity" State="CommunityState"
                                NodeAuthority="@(Session.SelectedNode!.PublicAuthority)" CurrentAccountId="Session.Account!.Id"
                                OnCommunityUpdated="CommunityUpdatedAsync" OnClose="CloseCommunitySettings" />
    }
    @if (_showQuickInvite && _quickInviteUrl is not null)
    {
        <InvitePeopleModal Friends="Session.Friends" NodeAuthority="@(Session.SelectedNode!.PublicAuthority)" InviteUrl="@_quickInviteUrl"
                           Error="@_quickInviteError" Send="SendQuickInviteAsync" OnClose="CloseQuickInvite" />
    }
    @if (!string.IsNullOrWhiteSpace(InviteToken))
    {
        <div class="route-invite-backdrop">
            <div class="route-invite" role="dialog" aria-modal="true" aria-label="Community invite">
                <InviteEmbed Content="@Navigation.Uri" />
            </div>
        </div>
    }
    @if (_showLeaveConfirm && _selectedCommunity is not null)
    {
        <div class="compact-confirm-backdrop" @onclick="CancelLeaveCommunity" @onkeydown="LeaveConfirmKey" tabindex="-1" autofocus>
            <section class="compact-confirm" role="alertdialog" aria-modal="true" aria-label="Leave Server" @onclick:stopPropagation="true">
                <button class="compact-confirm-close" title="Cancel" aria-label="Cancel" @onclick="CancelLeaveCommunity"><Icon Name="close" /></button>
                <h2>Leave Server?</h2><p>Are you sure you want to leave @_selectedCommunity.Name?</p>
                @if (!string.IsNullOrWhiteSpace(_leaveError)) { <p class="confirm-error">@_leaveError</p> }
                <div><button class="secondary" @onclick="CancelLeaveCommunity">Cancel</button><button class="danger" disabled="@_busy" @onclick="LeaveCommunityAsync">Leave Server</button></div>
            </section>
        </div>
    }
    <VoiceCallOverlay ActiveConversationId="@(_selectedCommunity is null && _homeView == "dm" ? _selectedDirectConversation?.Id : null)" />
}

@code {
    [Parameter] public string? InviteToken { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "token")] public string? RecoveryTokenQuery { get; set; }
    private IReadOnlyList<NodeAvailability> _nodeAvailability = [];
    private bool _initialized;
    private bool _busy;
    private bool _showProfile;
    private bool _showSettings;
    private bool _showAddFriend;
    private bool _showEditProfile;
    private bool _showCommunityCreate;
    private bool _showCommunitySettings;
    private bool _showQuickInvite;
    private bool _showCommunityMenu;
    private bool _showLeaveConfirm;
    private string? _leaveError;
    private CommunitySidebar? _communitySidebar;
    private bool _authenticationVisible;
    private bool _addingAccount;
    private string? _error;
    private CommunityDto? _selectedCommunity;
    private CommunityChannelDto? _selectedChannel;
    private Guid? _searchTargetMessageId;
    private DirectConversationDto? _selectedDirectConversation;
    private DirectMessageView? _directMessageView;
    private string? _quickInviteUrl;
    private string? _quickInviteError;
    private static readonly TimeSpan QuickInviteLifetime = TimeSpan.FromHours(24);
    private string _homeView = "friends";
    private StreamViewerReturnLocation? _streamViewerReturnLocation;
    private StreamViewerMode _lastViewerMode;
    private bool _expandTransitionPending;
    private long _composerFocusRequest;
    private long _shellNavigationGeneration;
    private readonly MobilePanelNavigationState _mobilePanels = new();
    private bool _faviconReady;
    private Guid? _composerFocusChannelId;
    private Guid? _composerFocusConversationId;
    private string PublicIdentity => IridiumIdentity.Format(Session.Account!.Username, Session.SelectedNode!.PublicAuthority);
    private PublicPresence CurrentPresence => PresenceVisibility.ToPublic(Session.Account!.PreferredPresence, Messaging.IsConnected);
    private int IncomingFriendRequestCount => Session.IncomingFriendRequestCount;
    private int UnreadMentionCount => Session.IsAuthenticated ? Session.Communities.Sum(value => Math.Max(0, value.MentionCount)) : 0;
    private string MobileConversationTitle => _selectedCommunity is not null
        ? _selectedChannel is null ? _selectedCommunity.Name : $"# {_selectedChannel.Name}"
        : _homeView == "dm" && _selectedDirectConversation is not null
            ? _selectedDirectConversation.OtherParticipant.DisplayName
            : _homeView == "requests" ? "Message Requests" : "Friends";
    private FriendRequestNotificationLocation FriendRequestNotificationTarget => FriendRequestNotifications.Route(
        IncomingFriendRequestCount,
        outsideHome: _selectedCommunity is not null,
        friendsActive: _selectedCommunity is null && _homeView == "friends");
    private void CloseMessageMenus() => MessageMenus.Close();
    private bool CanOpenCommunitySettings => CommunityState.IsOwner ||
        CommunityState.HasPermission(CommunityPermission.ManageCommunity) ||
        CommunityState.HasPermission(CommunityPermission.ManageRoles) ||
        CommunityState.HasPermission(CommunityPermission.CreateInvites) ||
        CommunityState.HasPermission(CommunityPermission.KickMembers) ||
        CommunityState.HasPermission(CommunityPermission.BanMembers);
    private bool HasContextSidebar =>
        _selectedCommunity is not null && _selectedChannel is not null && CommunityState.Management is not null ||
        _selectedCommunity is null && _homeView == "dm" && _selectedDirectConversation is not null;
    private bool IsDirectConversationSelected =>
        _selectedCommunity is null && _homeView == "dm" && _selectedDirectConversation is not null;
    private string DirectCallButtonLabel => VoiceSessions.DirectCalls.CurrentCall is not null
        ? "Voice Call Active"
        : VoiceSessions.IncomingCall is not null ? "Incoming Voice Call" : "Start Voice Call";
    private Task StartMobileDirectVoiceCallAsync() =>
        _directMessageView?.StartVoiceCallAsync() ?? Task.CompletedTask;
    private bool HasSelectedChannelPermission(CommunityPermission permission) =>
        _selectedChannel is not null && (_selectedChannel.EffectivePermissions & permission) == permission ||
        CommunityState.IsOwner || CommunityState.HasPermission(CommunityPermission.Administrator);

    protected override async Task OnInitializedAsync()
    {
        await Appearance.InitializeAsync();
        await UiSounds.InitializeAsync();
        var defaultNode = CreateDefaultNode();
        await SavedNodes.InitializeAsync(defaultNode, persistDefaultNode: !HostEnvironment.IsDevelopment());
        _nodeAvailability = await SavedNodes.ProbeAllAsync();
        Session.Changed += OnSessionChanged;
        Session.CommunityAccessRevoked += OnCommunityAccessRevoked;
        Session.CommunityJoined += OnCommunityJoined;
        CommunityState.Changed += OnCommunityStateChanged;
        CommunityState.RealtimeRefreshFailed += OnCommunityRefreshFailed;
        Session.PresenceChanged += OnPresenceChanged;
        Session.CommunityChannelActivity += OnCommunityChannelActivity;
        Messaging.Changed += OnSessionChanged;
        VoiceSessions.Changed += OnSessionChanged;
        await AccountSwitching.InitializeAsync(SavedNodes.Nodes);
        if (IsRecoveryRoute())
        {
            AccountSwitching.BeginAuthentication(defaultNode);
            _authenticationVisible = true;
            await InitializePasswordRecoveryAsync();
        }
        if (!Session.IsAuthenticated)
        {
            if (Session.AuthenticationNode is null) AccountSwitching.BeginAuthentication(SavedNodes.Nodes[0]);
            _authenticationVisible = true;
        }
        _initialized = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _faviconReady = true;
        await UpdateFaviconAsync();
    }

    private string? _recoveryToken;
    private PasswordRecoveryUiState _recoveryState;
    private string? _recoveryMessage;

    private bool IsRecoveryRoute()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var separator = relative.IndexOfAny(['?', '#']);
        if (separator >= 0) relative = relative[..separator];
        return string.Equals(relative.Trim('/'), "recover-password", StringComparison.OrdinalIgnoreCase);
    }

    private async Task InitializePasswordRecoveryAsync()
    {
        _recoveryToken = null;
        _recoveryState = PasswordRecoveryUiState.Invalid;
        _recoveryMessage = "This recovery link is invalid or has expired.";
        var token = RecoveryTokenQuery?.Trim();
        if (string.IsNullOrWhiteSpace(token) || token.Length > AccountSecurityLimits.MaximumRecoveryTokenLength)
            return;
        try
        {
            var validation = await Session.ValidatePasswordRecoveryAsync(token);
            if (!validation.IsValid) { _recoveryMessage = validation.Message; return; }
            _recoveryToken = token;
            _recoveryState = PasswordRecoveryUiState.Valid;
            _recoveryMessage = null;
        }
        catch
        {
            _recoveryMessage = "This recovery link could not be validated. Return to Login and request a new link.";
        }
    }

    private async Task<string> RequestPasswordRecoveryAsync(string username)
    {
        try
        {
            var result = await Session.RequestPasswordRecoveryAsync(username);
            return result.Message;
        }
        catch
        {
            return "If the account exists and has a recovery email configured, recovery instructions have been sent.";
        }
    }

    private async Task<bool> CompletePasswordRecoveryAsync(PasswordRecoverySubmission submission)
    {
        _error = null;
        if (submission.NewPassword != submission.ConfirmPassword)
        {
            _error = "The new passwords do not match.";
            return false;
        }
        try
        {
            await Session.CompletePasswordRecoveryAsync(submission.Token,
                submission.NewPassword, submission.ConfirmPassword);
            ClearPasswordRecoveryState();
            Navigation.NavigateTo(Navigation.BaseUri, forceLoad: true, replace: true);
            return true;
        }
        catch (Exception exception)
        {
            _error = UserMessage(exception);
            return false;
        }
    }

    private void CancelPasswordRecovery()
    {
        ClearPasswordRecoveryState();
        Navigation.NavigateTo(Navigation.BaseUri, forceLoad: true, replace: true);
    }

    private void ClearPasswordRecoveryState()
    {
        _recoveryToken = null;
        _recoveryState = PasswordRecoveryUiState.None;
        _recoveryMessage = null;
    }

    private async Task SelectNodeAsync(SavedNode node)
    {
        if (_recoveryState != PasswordRecoveryUiState.None) { CancelPasswordRecovery(); return; }
        _error = null;
        AccountSwitching.BeginAuthentication(node);
        await Task.CompletedTask;
    }

    private async Task<bool> AddNodeAsync(string address)
    {
        _error = null;
        try
        {
            var node = await SavedNodes.AddAsync(address);
            _nodeAvailability = await SavedNodes.ProbeAllAsync();
            if (_authenticationVisible) AccountSwitching.BeginAuthentication(node);
            return true;
        }
        catch (Exception exception)
        {
            _error = UserMessage(exception);
            return false;
        }
    }

    private SavedNode CreateDefaultNode()
    {
        if (!Uri.TryCreate(HostEnvironment.BaseAddress, UriKind.Absolute, out var clientUri) ||
            (clientUri.Scheme != Uri.UriSchemeHttp && clientUri.Scheme != Uri.UriSchemeHttps))
            throw new InvalidOperationException("The web client must be loaded from an HTTP or HTTPS origin.");

        if (HostEnvironment.IsDevelopment())
        {
            var developmentAddress = clientUri.Scheme == Uri.UriSchemeHttps
                ? "https://localhost:7008"
                : "http://localhost:5159";
            return new SavedNode(developmentAddress, "Local Iridium Node", true);
        }

        var currentOrigin = clientUri.GetLeftPart(UriPartial.Authority);
        return new SavedNode(SavedNodeState.NormalizeAddress(currentOrigin), null);
    }

    private async Task RemoveNodeAsync(SavedNode node)
    {
        try
        {
            if (Uri.TryCreate(node.Address, UriKind.Absolute, out var nodeUri))
                await MessageHistoryCache.ClearNodeAsync(MessageHistoryCacheScope.NormalizeNode(nodeUri));
        }
        catch (Exception exception) { Logger.LogWarning(exception, "Could not clear local history for removed Node {NodeAddress}.", node.Address); }
        await SavedNodes.RemoveAsync(node);
        if (Session.AuthenticationNode == node) AccountSwitching.BeginAuthentication(SavedNodes.Nodes[0]);
        _nodeAvailability = await SavedNodes.ProbeAllAsync();
    }

    private async Task AuthenticateAsync(AuthenticationSubmission submission)
    {
        _error = null;
        if (submission.IsRegister && submission.Password != submission.ConfirmPassword)
        {
            _error = "Passwords do not match.";
            return;
        }

        _busy = true;
        try
        {
            if (submission.IsRegister)
                await AccountSwitching.RegisterAsync(submission.Username, submission.DisplayName, submission.Password);
            else
                await AccountSwitching.LoginAsync(submission.Username, submission.Password);
            ResetAccountUi();
            _authenticationVisible = false;
            _addingAccount = false;
        }
        catch (Exception exception)
        {
            _error = UserMessage(exception);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<bool> SaveProfileAsync(ProfileSubmission submission)
    {
        _busy = true;
        _error = null;
        try
        {
            await Session.UpdateProfileAsync(submission.DisplayName, submission.Pronouns, submission.Description);
            return true;
        }
        catch (Exception exception)
        {
            _error = UserMessage(exception);
            return false;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CreateCommunityAsync(CommunitySubmission submission)
    {
        _busy = true;
        _error = null;
        CommunityDto? community = null;
        try
        {
            if (HostEnvironment.IsDevelopment())
                Logger.LogInformation("CREATE COMMUNITY CLIENT request starting Method=POST Path=api/communities NameLength={NameLength} DescriptionLength={DescriptionLength}",
                    submission.Name.Length, submission.Description?.Length ?? 0);
            community = await Session.CreateCommunityAsync(submission.Name, submission.Description);
            _showCommunityCreate = false;
            if (HostEnvironment.IsDevelopment())
                Logger.LogInformation("CREATE COMMUNITY CLIENT request returned Status=201 Success=true Id={CommunityId}", community.Id);
        }
        catch (Exception exception)
        {
            _error = UserMessage(exception);
            if (HostEnvironment.IsDevelopment())
                Logger.LogError(exception, "CREATE COMMUNITY CLIENT request returned Status={Status} Success=false Message={Message}",
                    exception is NodeApiException api ? api.StatusCode : null, _error);
            _busy = false;
            return;
        }
        try
        {
            await SelectCommunity(community);
        }
        catch (Exception exception)
        {
            _error = $"Server created, but it could not be opened: {UserMessage(exception)}";
            if (HostEnvironment.IsDevelopment())
                Logger.LogError(exception, "COMMUNITY CREATE Client navigation failed Id={CommunityId}", community.Id);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LogoutAsync()
    {
        await AccountSwitching.LogoutAsync();
        ResetAccountUi();
        _authenticationVisible = true;
        _addingAccount = false;
        _error = null;
    }

    private async Task SwitchAccountAsync(SavedAccountKey key)
    {
        var wasAddingAccount = _addingAccount;
        var hadActiveAccount = Session.IsAuthenticated;
        _busy = true;
        _error = null;
        try
        {
            var authenticated = await AccountSwitching.SwitchAsync(key);
            if (authenticated) ResetAccountUi();
            _authenticationVisible = !authenticated;
            _addingAccount = !authenticated && (wasAddingAccount || hadActiveAccount) && Session.IsAuthenticated;
        }
        catch (Exception exception)
        {
            _error = UserMessage(exception);
            _authenticationVisible = !Session.IsAuthenticated;
        }
        finally { _busy = false; }
    }

    private void AddAccount()
    {
        _showProfile = false;
        _addingAccount = true;
        _authenticationVisible = true;
        _error = null;
        AccountSwitching.BeginAuthentication(Session.SelectedNode ?? SavedNodes.Nodes[0]);
    }

    private void CancelAddAccount()
    {
        if (!Session.IsAuthenticated) return;
        _authenticationVisible = false;
        _addingAccount = false;
        _error = null;
    }

    private async Task RemoveAccountAsync(SavedAccountKey key)
    {
        var removingActive = Session.ActiveSavedAccount?.Key == key;
        try
        {
            if (Uri.TryCreate(key.NodeAddress, UriKind.Absolute, out var nodeUri))
                await MessageHistoryCache.ClearAccountAsync(MessageHistoryCacheScope.NormalizeNode(nodeUri), key.AccountId);
        }
        catch (Exception exception) { Logger.LogWarning(exception, "Could not clear local history for removed account {AccountId}.", key.AccountId); }
        await AccountSwitching.RemoveFromDeviceAsync(key);
        _showProfile = false;
        if (!removingActive) return;
        ResetAccountUi();
        _authenticationVisible = true;
        _addingAccount = false;
        AccountSwitching.BeginAuthentication(SavedNodes.Nodes[0]);
    }

    private async Task SelectCommunity(CommunityDto? community, bool focusRestoredChannel = false)
    {
        var generation = ++_shellNavigationGeneration;
        _composerFocusChannelId = null;
        _composerFocusConversationId = null;
        VoiceSessions.MinimizeWatchedStream();
        CloseQuickInvite();
        _selectedCommunity = community;
        _selectedChannel = null;
        _searchTargetMessageId = null;
        _selectedDirectConversation = null;
        _error = null;
        CommunityState.Clear();
        TrackBackground(Messaging.ClearAsync(), "clear the previous conversation");
        await InvokeAsync(StateHasChanged);
        if (community is null) return;
        try
        {
            await CommunityState.LoadAsync(community.Id);
            if (!IsCurrentCommunityNavigation(community.Id, generation)) return;
            await CommunityState.LoadManagementAsync();
            if (!IsCurrentCommunityNavigation(community.Id, generation)) return;
            var remembered = await LastChannelStore.LoadAsync(Session.Account!.Id, community.Id);
            if (!IsCurrentCommunityNavigation(community.Id, generation)) return;
            var channel = remembered is { } id ? CommunityState.Channels.FirstOrDefault(value => value.Id == id) : null;
            await SelectChannelAsync(channel ?? CommunityState.FirstOrderedChannel(), focusRestoredChannel);
        }
        catch (Exception exception)
        {
            if (!IsCurrentCommunityNavigation(community.Id, generation)) return;
            _error = UserMessage(exception); _selectedCommunity = null; CommunityState.Clear();
        }
    }
    private async Task SelectCommunityFromNavigationAsync(CommunityDto? community)
    {
        await SelectCommunity(community, focusRestoredChannel: true);
    }
    private async Task SelectChannelAsync(CommunityChannelDto? channel, bool requestComposerFocus = false,
        Guid? searchTargetMessageId = null)
    {
        ++_shellNavigationGeneration;
        _composerFocusChannelId = null;
        _composerFocusConversationId = null;
        VoiceSessions.MinimizeWatchedStream();
        _searchTargetMessageId = searchTargetMessageId;
        _selectedChannel = channel;
        if (channel?.Kind == CommunityChannelKind.Text && requestComposerFocus)
            RequestChannelComposerFocus(channel.Id);
        if (channel is null)
        {
            TrackBackground(Messaging.ClearAsync(), "clear the previous channel");
            await InvokeAsync(StateHasChanged);
            return;
        }
        if (Session.Account is null) { await InvokeAsync(StateHasChanged); return; }
        CommunityState.MarkChannelRead(channel.Id);
        await InvokeAsync(StateHasChanged);
        TrackBackground(CompleteChannelSelectionAsync(Session.Account.Id, channel),
            $"persist channel navigation {channel.Id}");
    }
