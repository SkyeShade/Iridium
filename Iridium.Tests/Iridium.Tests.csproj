<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>Iridium.Tests</AssemblyName>
    <RootNamespace>Iridium.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Iridium.Client.Core\Iridium.Client.Core.csproj" />
    <ProjectReference Include="..\Iridium.UI\Iridium.UI.csproj" />
    <ProjectReference Include="..\Iridium.Server\Iridium.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Exercise the production JS interop adapters on the .NET test host without referencing
       the executable WASM project (which introduces browser runtime build assets). -->
  <ItemGroup>
    <Compile Include="..\Iridium.Web\Services\LiveKitCallMediaService.cs" Link="MediaAdapters\LiveKitCallMediaService.cs" />
    <Compile Include="..\Iridium.Web\Services\LiveKitCommunityVoiceMediaClient.cs" Link="MediaAdapters\LiveKitCommunityVoiceMediaClient.cs" />
    <Compile Include="..\Iridium.Web\Services\MediaBuildInfo.cs" Link="MediaAdapters\MediaBuildInfo.cs" />
  </ItemGroup>
</Project>
