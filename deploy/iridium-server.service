[Unit]
Description=Iridium Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iridium
Group=iridium
WorkingDirectory=/opt/iridium/app/server
ExecStart=/opt/iridium/app/server/Iridium.Server
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5080
Environment=ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
Environment=IRIDIUM_DATA_DIR=/opt/iridium/data
Environment=IRIDIUM_CONFIG_DIR=/opt/iridium/config
Environment=Deployment__UseHttpsRedirection=false
EnvironmentFile=-/opt/iridium/config/iridium.env
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/iridium/data

[Install]
WantedBy=multi-user.target
